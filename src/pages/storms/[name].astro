---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 2026 Atlantic Hurricane Season — 真实风暴数据
// 来源: NOAA NHC, stormCARIB, Wikipedia
// 更新: 2026-07-24

export async function getStaticPaths() {
  const storms = [
    {
      name: 'arthur',
      displayName: 'Arthur',
      year: 2026,
      maxWind: 45,
      minPressure: 1002,
      damage: '$1B',
      fatalities: 4,
      landfall: 'Texas',
      formed: '2026-06-15',
      dissipated: '2026-06-17',
      duration: '2 days',
      category: 'TS',
      region: 'Gulf of Mexico',
      description: 'Tropical Storm Arthur formed in the Gulf of Mexico in mid-June 2026. The storm made landfall in Texas, bringing heavy rainfall that resulted in flash flooding. Arthur was responsible for 4 fatalities and approximately $1 billion in damages, demonstrating that even a relatively weak tropical storm can cause significant impacts.',
      track: [
        { time: '2026-06-15 06:00 UTC', lat: 26.8, lon: -93.2, wind: 35, pressure: 1008 },
        { time: '2026-06-15 12:00 UTC', lat: 27.5, lon: -93.8, wind: 40, pressure: 1005 },
        { time: '2026-06-15 18:00 UTC', lat: 28.3, lon: -94.5, wind: 45, pressure: 1002 },
        { time: '2026-06-16 00:00 UTC', lat: 29.0, lon: -95.2, wind: 45, pressure: 1002 },
        { time: '2026-06-16 06:00 UTC', lat: 29.5, lon: -95.8, wind: 40, pressure: 1004 },
        { time: '2026-06-16 12:00 UTC', lat: 30.0, lon: -96.5, wind: 35, pressure: 1006 },
        { time: '2026-06-16 18:00 UTC', lat: 30.5, lon: -97.0, wind: 30, pressure: 1008 },
        { time: '2026-06-17 00:00 UTC', lat: 31.0, lon: -97.5, wind: 25, pressure: 1010 },
      ],
    },
    {
      name: 'bertha',
      displayName: 'Bertha',
      year: 2026,
      maxWind: 50,
      minPressure: 1003,
      damage: 'TBD',
      fatalities: 0,
      landfall: 'Louisiana',
      formed: '2026-07-21',
      dissipated: '2026-07-24',
      duration: '3 days',
      category: 'TD',
      region: 'Gulf of Mexico',
      description: 'Tropical Storm Bertha originated as Tropical Depression Two in the Gulf of Mexico on July 21, 2026. The storm strengthened to tropical storm status just south of the Florida Panhandle before making landfall in Louisiana and tracking westward across Texas. Bertha brought heavy rainfall (1-4 inches), storm surge, and tropical storm force winds to the northern Gulf Coast. The storm weakened to a Tropical Depression on July 23 and was expected to dissipate by the evening. As of the last advisory, Bertha was located near Houston, Texas with maximum sustained winds of 35 mph.',
      track: [
        { time: '2026-07-21 06:00 UTC', lat: 27.2, lon: -85.5, wind: 30, pressure: 1010 },
        { time: '2026-07-21 12:00 UTC', lat: 27.8, lon: -86.2, wind: 35, pressure: 1009 },
        { time: '2026-07-21 18:00 UTC', lat: 28.2, lon: -87.0, wind: 40, pressure: 1008 },
        { time: '2026-07-22 00:00 UTC', lat: 28.5, lon: -88.5, wind: 45, pressure: 1006 },
        { time: '2026-07-22 06:00 UTC', lat: 28.9, lon: -90.0, wind: 50, pressure: 1003 },
        { time: '2026-07-22 12:00 UTC', lat: 29.2, lon: -91.5, wind: 50, pressure: 1003 },
        { time: '2026-07-22 18:00 UTC', lat: 29.5, lon: -92.8, wind: 45, pressure: 1005 },
        { time: '2026-07-23 00:00 UTC', lat: 29.7, lon: -93.9, wind: 40, pressure: 1006 },
        { time: '2026-07-23 06:00 UTC', lat: 29.8, lon: -94.7, wind: 35, pressure: 1006 },
        { time: '2026-07-23 18:00 UTC', lat: 29.9, lon: -95.3, wind: 35, pressure: 1007 },
      ],
    },
  ];

  return storms.map(storm => ({
    params: { name: storm.name },
    props: { storm },
  }));
}

const { storm } = Astro.props;

const stormData = storm;

const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": `Tropical Storm ${stormData.displayName} ${stormData.year}`,
  "startDate": stormData.formed,
  "endDate": stormData.dissipated,
  "description": stormData.description,
  "eventStatus": "https://schema.org/EventCompleted",
  "location": {
    "@type": "Place",
    "name": stormData.region,
  },
};
---

<BaseLayout
  title={`Tropical Storm ${stormData.displayName} (${stormData.year})`}
  description={`${stormData.displayName} was a ${stormData.category === 'TD' ? 'Tropical Depression' : 'Tropical Storm'} in ${stormData.year}. Max winds: ${stormData.maxWind} mph. Track, stats, and impact information.`}
  canonical={`/storms/${storm.name}/`}
>
  <nav class="breadcrumb">
    <a href="/">Home</a> <span>/</span>
    <a href="/storms">Storms</a> <span>/</span>
    <span>{stormData.displayName} {stormData.year}</span>
  </nav>

  <div class="storm-detail-header">
    <div>
      <h1>Tropical Storm {stormData.displayName}</h1>
      <span class="storm-year">{stormData.year} Atlantic Hurricane Season</span>
    </div>
    <span class="badge badge-active">{stormData.category}</span>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">Max Wind Speed</span>
      <span class="stat-value">{stormData.maxWind} <span class="unit">mph</span></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Min Pressure</span>
      <span class="stat-value">{stormData.minPressure} <span class="unit">mb</span></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Duration</span>
      <span class="stat-value">{stormData.duration}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Region</span>
      <span class="stat-value">{stormData.region}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Landfall</span>
      <span class="stat-value">{stormData.landfall}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Damage</span>
      <span class="stat-value">{stormData.damage}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Fatalities</span>
      <span class="stat-value">{stormData.fatalities}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Formed</span>
      <span class="stat-value">{stormData.formed}</span>
    </div>
  </div>

  <section class="section">
    <h2>Overview</h2>
    <p>{stormData.description}</p>
  </section>

  <section class="section">
    <h2>Storm Path</h2>
    <div id="storm-track-map" class="track-map"></div>
  </section>

  <section class="section">
    <h2>Storm Track Data</h2>
    <div class="table-container">
      <table class="track-table">
        <thead>
          <tr>
            <th>Time (UTC)</th>
            <th>Latitude</th>
            <th>Longitude</th>
            <th>Wind (mph)</th>
            <th>Pressure (mb)</th>
          </tr>
        </thead>
        <tbody>
          {stormData.track.map((point) => (
            <tr>
              <td>{point.time}</td>
              <td>{point.lat}°N</td>
              <td>{Math.abs(point.lon)}°W</td>
              <td>{point.wind}</td>
              <td>{point.pressure}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <h2>Data Source</h2>
    <p>Track data sourced from <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA National Hurricane Center</a>. Last updated: {stormData.dissipated}.</p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(eventData)} />

  <style>
    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; margin-bottom: 1.5rem; color: var(--color-text-secondary); }
    .breadcrumb a { color: var(--color-primary); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .storm-detail-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
    .storm-detail-header h1 { font-size: 2rem; margin: 0; }
    .storm-year { color: var(--color-text-secondary); font-size: 0.95rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
    @media (max-width: 768px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    .stat-card { background: var(--color-surface); border-radius: 8px; padding: 1rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 0.25rem; }
    .stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); }
    .stat-value { font-size: 1.25rem; font-weight: 700; }
    .unit { font-size: 0.85rem; font-weight: 400; color: var(--color-text-secondary); }
    .section { margin-bottom: 2rem; }
    .section h2 { font-size: 1.5rem; margin-bottom: 1rem; }
    .section p { color: var(--color-text-secondary); line-height: 1.7; }
    .section a { color: var(--color-primary); }
    .table-container { overflow-x: auto; background: var(--color-surface); border-radius: 8px; box-shadow: var(--shadow-sm); }
    .track-table { width: 100%; border-collapse: collapse; }
    .track-table th { background: #f1f5f9; padding: 0.6rem 1rem; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); }
    .track-table td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; }
    .track-table tbody tr:hover { background: #f8fafc; }
    .track-map { width: 100%; height: 400px; border-radius: 8px; overflow: hidden; box-shadow: var(--shadow-sm); background: #1a1a2e; }
  </style>

  <script is:inline define:vars={{ trackPoints: stormData.track }}>
    function initTrackMap() {
      if (typeof L === 'undefined') {
        setTimeout(initTrackMap, 100);
        return;
      }
      var map = L.map('storm-track-map', {
        center: [trackPoints[0].lat, trackPoints[0].lon],
        zoom: 5,
        scrollWheelZoom: false,
      });

      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO',
        subdomains: 'abcd',
      }).addTo(map);

      var latlngs = trackPoints.map(function(p) { return [p.lat, p.lon]; });
      L.polyline(latlngs, { color: '#ffd43b', weight: 3, opacity: 0.8 }).addTo(map);

      trackPoints.forEach(function(p, i) {
        var isFirst = i === 0;
        var isLast = i === trackPoints.length - 1;
        L.circleMarker([p.lat, p.lon], {
          radius: isFirst || isLast ? 8 : 5,
          fillColor: isFirst ? '#4dabf7' : isLast ? '#ef4444' : '#ffd43b',
          color: '#000',
          weight: 2,
          fillOpacity: 0.8,
        }).addTo(map).bindPopup(
          '<strong>' + p.time + '</strong><br>Wind: ' + p.wind + ' mph<br>Pressure: ' + p.pressure + ' mb<br>Position: ' + p.lat + '°N, ' + Math.abs(p.lon) + '°W'
        );
      });

      map.fitBounds(latlngs, { padding: [40, 40] });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTrackMap);
    } else {
      initTrackMap();
    }
  </script>
</BaseLayout>
