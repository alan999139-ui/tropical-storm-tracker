---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dict';
import { historicalStorms, seasonStats, averages } from '../../data/historical';

const lang = 'zh';

// 风暴名称中文化映射
const stormNames: Record<string, string> = {
  'Arthur': '阿瑟', 'Bertha': '伯莎', 'Cristobal': '克里斯托瓦尔', 'Dolly': '多莉',
  'Edouard': '爱德华', 'Fay': '费伊', 'Gonzalo': '贡萨洛', 'Hanna': '汉娜',
  'Isaias': '伊萨亚斯', 'Laura': '劳拉', 'Marco': '马可', 'Nana': '娜娜',
  'Omar': '奥马尔', 'Paulette': '波莱特', 'Rene': '雷内', 'Sally': '萨莉',
  'Teddy': '泰迪', 'Vicky': '维基', 'Wilfred': '威尔弗雷德',
  'Dorian': '多里安', 'Michael': '迈克尔', 'Florence': '弗洛伦斯', 'Maria': '玛丽亚',
  'Irma': '艾尔玛', 'Harvey': '哈维', 'Ian': '伊恩', 'Idalia': '伊达利亚',
  'Hilary': '希拉里', 'Lee': '李', 'Franklin': '富兰克林', 'Nigel': '奈杰尔',
  'Tammy': '塔米', 'Fiona': '菲奥娜', 'Ida': '艾达', 'Elsa': '埃尔莎',
  'Eta': '伊塔', 'Iota': '约塔',
};

// 风暴等级中文化
const stormCategories: Record<string, string> = {
  'TD': '热带低压', 'TS': '热带风暴', 'Cat-1': '1级飓风', 'Cat-2': '2级飓风',
  'Cat-3': '3级飓风', 'Cat-4': '4级飓风', 'Cat-5': '5级飓风',
};

// 地区中文化
const regionNames: Record<string, string> = {
  'Atlantic': '大西洋', 'Gulf of Mexico': '墨西哥湾', 'Caribbean': '加勒比海',
  'East Pacific': '东太平洋', 'Central Pacific': '中太平洋',
  'Northwest Pacific': '西北太平洋', 'North Indian': '北印度洋',
  'South Indian': '南印度洋', 'South Pacific': '南太平洋',
};

const categoryColors: Record<string, string> = {
  TD: '#4dabf7', TS: '#ffd43b', 'Cat-1': '#ff8787', 'Cat-2': '#fa5252',
  'Cat-3': '#e64980', 'Cat-4': '#cc5de8', 'Cat-5': '#845ef7',
};

const years = [...new Set(historicalStorms.map(s => s.year))].sort((a, b) => b - a);

const maxNamed = Math.max(...seasonStats.map(s => s.namedStorms));
const avgNamed = averages.namedStorms;
const avgAce = averages.ace;
const totalDamage = seasonStats.reduce((sum, s) => {
  const val = parseFloat(s.damage.replace(/[$BMBK,]/g, '')) || 0;
  return sum + (s.damage.includes('B') ? val : 0);
}, 0);
const totalFatalities = seasonStats.reduce((sum, s) => sum + s.fatalities, 0);
---

<BaseLayout
  title="风暴数据库"
  description="浏览大西洋热带风暴和飓风综合数据库。按年份、名称、等级或地区搜索。包含2017-2026年历史数据。"
  lang={lang}
>
  <div class="page-header">
    <h1>🌪️ 风暴数据库</h1>
    <p>{historicalStorms.length} 个重大热带风暴和飓风记录（2017–2026）。数据来源：NOAA HURDAT2 和 NHC。</p>
  </div>

  <div class="stats-overview">
    <div class="stat-box">
      <span class="stat-num">{historicalStorms.length}</span>
      <span class="stat-label">追踪的重大风暴</span>
    </div>
    <div class="stat-box">
      <span class="stat-num">${totalDamage}B+</span>
      <span class="stat-label">总损失（2017-2026）</span>
    </div>
    <div class="stat-box">
      <span class="stat-num">{totalFatalities.toLocaleString()}</span>
      <span class="stat-label">总死亡人数</span>
    </div>
    <div class="stat-box">
      <span class="stat-num">{seasonStats.length}</span>
      <span class="stat-label">分析季节数</span>
    </div>
  </div>

  <div class="chart-section">
    <div class="chart-header">
      <h2>📊 年度风暴频率（2017–2026）</h2>
      <div class="chart-legend">
        <span class="chart-legend-item"><span class="legend-dot" style="background:#0ea5e9;"></span>命名风暴</span>
        <span class="chart-legend-item"><span class="legend-dot" style="background:#f59e0b;"></span>飓风</span>
        <span class="chart-legend-item"><span class="legend-dot" style="background:#ef4444;"></span>重大飓风</span>
        <span class="chart-legend-item"><span class="legend-line-dashed"></span>30年均值</span>
      </div>
    </div>
    <div class="bar-chart">
      {seasonStats.map((s) => (
        <div class="bar-group" data-year={s.year}>
          <div class="bars">
            <div class="bar bar-named" style={`height: ${(s.namedStorms / maxNamed) * 100}%;`} title={`命名: ${s.namedStorms}`}>
              <span class="bar-value">{s.namedStorms}</span>
            </div>
            <div class="bar bar-hurr" style={`height: ${(s.hurricanes / maxNamed) * 100}%;`} title={`飓风: ${s.hurricanes}`}>
              <span class="bar-value">{s.hurricanes}</span>
            </div>
            <div class="bar bar-major" style={`height: ${(s.majorHurricanes / maxNamed) * 100}%;`} title={`重大: ${s.majorHurricanes}`}>
              <span class="bar-value">{s.majorHurricanes}</span>
            </div>
          </div>
          <span class="bar-label">{s.year}</span>
        </div>
      ))}
    </div>
    <div class="avg-line-container">
      <div class="avg-line" style={`bottom: ${(avgNamed / maxNamed) * 100}%;`}></div>
      <span class="avg-label" style={`bottom: ${(avgNamed / maxNamed) * 100}%; transform: translateY(50%);`}>均值: {avgNamed}</span>
    </div>
  </div>

  <div class="chart-section">
    <div class="chart-header">
      <h2>🌀 ACE 指数趋势</h2>
      <span class="chart-note">累积气旋能量 — 衡量总能量</span>
    </div>
    <div class="ace-chart">
      {seasonStats.map((s) => (
        <div class="ace-bar-group">
          <div class="ace-bar" style={`height: ${(s.ace / 250) * 100}%; background: ${s.ace > avgAce ? 'linear-gradient(to top, #f59e0b, #ef4444)' : 'linear-gradient(to top, #0ea5e9, #38bdf8)'};`} title={`ACE: ${s.ace}`}>
            <span class="ace-value">{s.ace}</span>
          </div>
          <span class="ace-label">{s.year}</span>
        </div>
      ))}
    </div>
    <div class="ace-avg-line" style={`bottom: ${(avgAce / 250) * 100}%;`}></div>
  </div>

  <div class="filters">
    <div class="filter-group">
      <label>年份</label>
      <select id="filter-year">
        <option value="">全部年份</option>
        {years.map(year => <option value={year}>{year}</option>)}
      </select>
    </div>
    <div class="filter-group">
      <label>等级</label>
      <select id="filter-category">
        <option value="">全部等级</option>
        <option value="TD">热带低压</option>
        <option value="TS">热带风暴</option>
        <option value="Cat-1">1级飓风</option>
        <option value="Cat-2">2级飓风</option>
        <option value="Cat-3">3级飓风</option>
        <option value="Cat-4">4级飓风</option>
        <option value="Cat-5">5级飓风</option>
      </select>
    </div>
    <div class="filter-group">
      <label>地区</label>
      <select id="filter-region">
        <option value="">全部地区</option>
        <option value="Atlantic">大西洋</option>
        <option value="Gulf of Mexico">墨西哥湾</option>
        <option value="Caribbean">加勒比海</option>
        <option value="Pacific">太平洋</option>
      </select>
    </div>
    <div class="filter-group">
      <label>搜索</label>
      <input type="text" id="filter-search" placeholder="风暴名称..." />
    </div>
  </div>

  <div class="results-bar">
    <span id="results-count">{historicalStorms.length} 个风暴</span>
  </div>

  <div class="table-container">
    <table class="storm-table">
      <thead>
        <tr>
          <th>名称</th>
          <th>年份</th>
          <th>等级</th>
          <th>最大风速</th>
          <th>最低气压</th>
          <th>形成日期</th>
          <th>消散日期</th>
          <th>地区</th>
          <th>损失</th>
          <th>死亡</th>
        </tr>
      </thead>
      <tbody id="storm-table-body">
        {historicalStorms.map((storm) => (
          <tr data-year={storm.year} data-category={storm.category} data-region={storm.region} data-name={storm.name.toLowerCase()}>
            <td><a href={`/zh/storms/${storm.name.toLowerCase()}`} class="storm-link">{stormNames[storm.name] || storm.name}</a></td>
            <td>{storm.year}</td>
            <td><span class="badge" style={`background: ${categoryColors[storm.category] || '#e2e8f0'}33; color: ${categoryColors[storm.category] || '#64748b'};`}>{stormCategories[storm.category] || storm.category}</span></td>
            <td>{storm.maxWind} mph</td>
            <td>{storm.minPressure} mb</td>
            <td>{storm.formed}</td>
            <td>{storm.dissipated}</td>
            <td>{regionNames[storm.region] || storm.region}</td>
            <td>{storm.damage}</td>
            <td>{storm.fatalities}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div id="no-results" class="no-results" style="display: none;">
    <span class="no-results-icon">🔍</span>
    <p>没有符合筛选条件的风暴。</p>
  </div>

  <script is:inline>
    const yearFilter = document.getElementById('filter-year');
    const categoryFilter = document.getElementById('filter-category');
    const regionFilter = document.getElementById('filter-region');
    const searchInput = document.getElementById('filter-search');
    const tableBody = document.getElementById('storm-table-body');
    const resultsCount = document.getElementById('results-count');
    const noResults = document.getElementById('no-results');
    const tableContainer = document.querySelector('.table-container');

    function applyFilters() {
      const year = yearFilter.value;
      const category = categoryFilter.value;
      const region = regionFilter.value;
      const search = searchInput.value.toLowerCase();
      let visible = 0;
      const rows = tableBody.querySelectorAll('tr');
      rows.forEach(row => {
        const matchYear = !year || row.dataset.year === year;
        const matchCategory = !category || row.dataset.category === category;
        const matchRegion = !region || row.dataset.region === region;
        const matchSearch = !search || row.dataset.name.includes(search);
        if (matchYear && matchCategory && matchRegion && matchSearch) {
          row.style.display = ''; visible++;
        } else { row.style.display = 'none'; }
      });
      resultsCount.textContent = `${visible} 个风暴`;
      noResults.style.display = visible === 0 ? 'block' : 'none';
      tableContainer.style.display = visible === 0 ? 'none' : 'block';
    }
    [yearFilter, categoryFilter, regionFilter].forEach(el => el.addEventListener('change', applyFilters));
    searchInput.addEventListener('input', applyFilters);
  </script>

  <style>
    .page-header { margin-bottom: 2rem; }
    .page-header h1 { font-size: 2rem; margin-bottom: 0.5rem; }
    .page-header p { color: var(--color-text-secondary); }
    .stats-overview { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
    .stat-box { background: var(--color-surface); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow-md); text-align: center; display: flex; flex-direction: column; gap: 0.25rem; }
    .stat-num { font-size: 2rem; font-weight: 800; color: var(--color-primary); line-height: 1.2; }
    .stat-label { font-size: 0.8rem; color: var(--color-text-secondary); }
    .chart-section { background: var(--color-surface); border-radius: var(--radius); padding: 2rem; box-shadow: var(--shadow-md); margin-bottom: 2.5rem; position: relative; }
    .chart-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; margin-bottom: 2rem; }
    .chart-header h2 { font-size: 1.25rem; }
    .chart-legend { display: flex; gap: 1.25rem; flex-wrap: wrap; font-size: 0.8rem; }
    .chart-legend-item { display: flex; align-items: center; gap: 0.4rem; color: var(--color-text-secondary); }
    .legend-line-dashed { width: 20px; height: 2px; border-top: 2px dashed var(--color-text-secondary); }
    .bar-chart { display: flex; gap: 0.75rem; align-items: flex-end; height: 250px; padding-bottom: 2rem; border-bottom: 2px solid var(--color-border); position: relative; }
    .bar-group { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; position: relative; }
    .bars { display: flex; gap: 4px; align-items: flex-end; height: 100%; width: 100%; justify-content: center; }
    .bar { width: 20px; border-radius: 6px 6px 0 0; position: relative; transition: height 0.5s ease; min-height: 4px; cursor: pointer; }
    .bar-named { background: linear-gradient(to top, #0284c7, #0ea5e9); }
    .bar-hurr { background: linear-gradient(to top, #d97706, #f59e0b); }
    .bar-major { background: linear-gradient(to top, #dc2626, #ef4444); }
    .bar-value { position: absolute; top: -20px; left: 50%; transform: translateX(-50%); font-size: 0.7rem; font-weight: 700; }
    .bar-label { margin-top: 0.5rem; font-size: 0.75rem; color: var(--color-text-secondary); font-weight: 600; }
    .avg-line-container { position: absolute; bottom: 2rem; left: 0; right: 0; pointer-events: none; }
    .avg-line { position: absolute; left: 0; right: 0; height: 0; border-top: 2px dashed var(--color-text-secondary); opacity: 0.5; }
    .avg-label { position: absolute; right: 0; font-size: 0.7rem; color: var(--color-text-secondary); background: var(--color-surface); padding: 0 4px; }
    .ace-chart { display: flex; gap: 0.75rem; align-items: flex-end; height: 250px; padding-bottom: 2rem; border-bottom: 2px solid var(--color-border); position: relative; }
    .ace-bar-group { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; }
    .ace-bar { width: 36px; border-radius: 6px 6px 0 0; position: relative; transition: height 0.5s ease; min-height: 4px; cursor: pointer; }
    .ace-value { position: absolute; top: -20px; left: 50%; transform: translateX(-50%); font-size: 0.7rem; font-weight: 700; }
    .ace-label { margin-top: 0.5rem; font-size: 0.75rem; color: var(--color-text-secondary); font-weight: 600; }
    .ace-avg-line { position: absolute; left: 0; right: 0; bottom: 2rem; height: 0; border-top: 2px dashed var(--color-text-secondary); opacity: 0.5; }
    .ace-avg-line::after { content: '均值: 123'; position: absolute; right: 0; top: -18px; font-size: 0.7rem; color: var(--color-text-secondary); background: var(--color-surface); padding: 0 4px; }
    .chart-note { font-size: 0.8rem; color: var(--color-text-secondary); }
    .filters { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; background: var(--color-surface); padding: 1.5rem; border-radius: var(--radius); box-shadow: var(--shadow-sm); }
    .filter-group { display: flex; flex-direction: column; gap: 0.4rem; }
    .filter-group label { font-size: 0.8rem; color: var(--color-text-secondary); font-weight: 600; }
    .filter-group select, .filter-group input { padding: 0.6rem 0.75rem; border: 1px solid var(--color-border); border-radius: 8px; font-size: 0.9rem; font-family: inherit; background: white; }
    .filter-group select:focus, .filter-group input:focus { outline: 2px solid var(--color-primary); outline-offset: -1px; border-color: var(--color-primary); }
    .results-bar { margin-bottom: 1rem; color: var(--color-text-secondary); font-size: 0.9rem; }
    .table-container { overflow-x: auto; background: var(--color-surface); border-radius: var(--radius); box-shadow: var(--shadow-md); }
    .storm-table { width: 100%; border-collapse: collapse; }
    .storm-table th { background: #f1f5f9; padding: 0.75rem 1rem; text-align: left; font-size: 0.8rem; color: var(--color-text-secondary); font-weight: 600; border-bottom: 1px solid var(--color-border); white-space: nowrap; }
    .storm-table td { padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; }
    .storm-table tbody tr:hover { background: #f8fafc; }
    .storm-link { color: var(--color-primary); text-decoration: none; font-weight: 600; }
    .storm-link:hover { text-decoration: underline; }
    .no-results { text-align: center; padding: 3rem 2rem; }
    .no-results-icon { font-size: 3rem; display: block; margin-bottom: 1rem; }
    @media (max-width: 768px) { .filters { grid-template-columns: 1fr 1fr; } .stats-overview { grid-template-columns: repeat(2, 1fr); } .bar { width: 12px; } }
    @media (max-width: 480px) { .stats-overview { grid-template-columns: 1fr; } .bar { width: 8px; } }
  </style>
</BaseLayout>
