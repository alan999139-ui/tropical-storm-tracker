---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dict';

const lang = 'zh';

// 风暴名称中文化映射
const stormNames: Record<string, string> = {
  'Arthur': '阿瑟',
  'Bertha': '伯莎',
  'Cristobal': '克里斯托瓦尔',
  'Dolly': '多莉',
  'Edouard': '爱德华',
  'Fay': '费伊',
  'Gonzalo': '贡萨洛',
  'Hanna': '汉娜',
  'Isaias': '伊萨亚斯',
  'Laura': '劳拉',
  'Marco': '马可',
  'Nana': '娜娜',
  'Omar': '奥马尔',
  'Paulette': '波莱特',
  'Rene': '雷内',
  'Sally': '萨莉',
  'Teddy': '泰迪',
  'Vicky': '维基',
  'Wilfred': '威尔弗雷德',
  'Alpha': '阿尔法',
  'Beta': '贝塔',
  'Gamma': '伽马',
  'Delta': '德尔塔',
  'Epsilon': '艾普西龙',
  'Zeta': '泽塔',
  'Eta': '伊塔',
  'Theta': '西塔',
  'Iota': '约塔',
  'Dorian': '多里安',
  'Michael': '迈克尔',
  'Florence': '弗洛伦斯',
  'Maria': '玛丽亚',
  'Irma': '艾尔玛',
  'Harvey': '哈维',
  'Ian': '伊恩',
  'Idalia': '伊达利亚',
  'Hilary': '希拉里',
  'Lee': '李',
  'Franklin': '富兰克林',
  'Nigel': '奈杰尔',
  'Tammy': '塔米',
  'Dolphin': '海豚',
  'Fausto': '福斯托',
  'Genevieve': '吉纳维芙',
  'Noul': '诺尔',
};

// 风暴等级中文化
const stormCategories: Record<string, string> = {
  'TD': '热带低压',
  'TS': '热带风暴',
  'Cat-1': '1级飓风',
  'Cat-2': '2级飓风',
  'Cat-3': '3级飓风',
  'Cat-4': '4级飓风',
  'Cat-5': '5级飓风',
};

const recentStorms = [
  { name: 'Arthur', year: 2026, category: 'TS', maxWind: 45, formed: '2026-06-15', dissipated: '2026-06-17', damage: '$1B', fatalities: 4, landfall: '德克萨斯州' },
  { name: 'Bertha', year: 2026, category: 'TD', maxWind: 50, formed: '2026-07-21', dissipated: '2026-07-24', damage: '待定', fatalities: 0, landfall: '路易斯安那州' },
];

const seasonOutlook = {
  forecast: t('season.forecast', lang),
  namedStorms: '8-14',
  hurricanes: '3-6',
  majorHurricanes: '1-2',
  ace: '50 (平均: 123)',
  peakDate: '9月10日',
  season: '6月1日 - 11月30日',
  notes: t('season.notes', lang),
};

const preparednessTips = [
  { icon: '🎒', title: t('prep.kit', lang), desc: t('prep.kitDesc', lang) },
  { icon: '🏠', title: t('prep.home', lang), desc: t('prep.homeDesc', lang) },
  { icon: '📱', title: t('prep.connected', lang), desc: t('prep.connectedDesc', lang) },
  { icon: '🚗', title: t('prep.evacuation', lang), desc: t('prep.evacuationDesc', lang) },
];

const categoryColors: Record<string, string> = {
  TD: '#4dabf7', TS: '#ffd43b', 'Cat-1': '#ff8787', 'Cat-2': '#fa5252',
  'Cat-3': '#e64980', 'Cat-4': '#cc5de8', 'Cat-5': '#845ef7',
};
---

<BaseLayout title="Home" lang={lang}>
  <section class="hero">
    <div class="hero-content">
      <span class="badge badge-active" id="hero-storm-count">🌀 加载中...</span>
      <h1>{t('hero.title', lang)}</h1>
      <p>{t('hero.description', lang)}</p>
      <div class="hero-actions">
        <a href="/zh/alerts" class="btn btn-primary" onclick="trackEvent('hero_cta_click', {button: 'get_alerts', page_section: 'hero', language: 'zh'})">立即设置免费预警</a>
        <a href="/zh/map" class="btn btn-outline" onclick="trackEvent('hero_cta_click', {button: 'view_map', page_section: 'hero', language: 'zh'})"><span data-i18n="home.scenario.seafarerBtn">查看实时地图</span></a>
      </div>
    </div>
  </section>

  <!-- 活跃风暴 -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">{t('active.title', lang)}</h2>
      <span class="live-indicator"><span class="live-dot"></span>LIVE</span>
    </div>
    <div id="active-storms-container">
      <div class="card loading-card">
        <div class="loading-spinner-small"></div>
        <p>{t('active.loading', lang)}</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const API_URL = '/api/storms';
    const NOAA_RSS_URL = 'https://www.nhc.noaa.gov/index-at.xml';
    const HOME_REFRESH = 5 * 60 * 1000;
    const LANG = 'zh';

    // 响应 BaseLayout 语言切换（i18n:langchange 事件）
    function handleLangChange(e) {
      const newLang = e.detail?.lang || 'zh';
      window.__STORM_LANG__ = newLang;
      // 风暴名称映射（中文）
      if (newLang === 'zh') {
        if (window.__STORM_DATA__) {
          window.__STORM_DATA__ = window.__STORM_DATA__.map(function(s) {
            var localized = Object.assign({}, s);
            localized.localizedName = localizeName(s.name);
            localized.localizedType = s.windMph < 39 ? '热带低压' : '热带风暴';
            return localized;
          });
          renderActiveStorms(window.__STORM_DATA__);
        }
      } else {
        // 其他语言：使用原始名称，重新 fetch
        fetchStorms().then(function(storms) {
          if (storms) { window.__STORM_DATA__ = storms; renderActiveStorms(storms);
      window.__STORM_DATA__ = storms; }
        });
      }
    }
    document.addEventListener('i18n:langchange', handleLangChange);
    window.__STORM_LANG__ = 'zh';


    function getStormType(wind) {
      if (wind < 39) return '热带低压';
      if (wind < 74) return '热带风暴';
      return '飓风';
    }
    function getIntensityColor(wind) {
      if (wind < 39) return '#4dabf7';
      if (wind < 74) return '#ffd43b';
      if (wind < 111) return '#ff8787';
      if (wind < 157) return '#fa5252';
      return '#845ef7';
    }

    async function fetchStorms() {
      try {
        const resp = await fetch(API_URL, { cache: 'no-store' });
        if (resp.ok) { const data = await resp.json(); if (data.storms) return data.storms; }
      } catch(e) { console.warn('API failed'); }
      const proxies = [
        'https://corsproxy.io/?url=' + encodeURIComponent(NOAA_RSS_URL),
        'https://api.allorigins.win/raw?url=' + encodeURIComponent(NOAA_RSS_URL),
      ];
      for (const proxy of proxies) {
        try { const resp = await fetch(proxy, { cache: 'no-store' }); if (resp.ok) { const text = await resp.text(); if (text && text.includes('<rss')) return parseRSS(text); } } catch(e) {}
      }
      return null;
    }

    function parseRSS(xmlText) {
      const parser = new DOMParser(); const doc = parser.parseFromString(xmlText, 'text/xml');
      const items = doc.querySelectorAll('item'); const storms = []; const seen = new Set();
      items.forEach(function(item) {
        const c = item.querySelector('Cyclone');
        if (c) {
          const name = c.querySelector('name')?.textContent || '';
          if (name && !seen.has(name)) {
            seen.add(name);
            const center = c.querySelector('center')?.textContent || '';
            const coords = center.split(',').map(s => parseFloat(s.trim()));
            storms.push({ name, type: getStormType(parseInt(c.querySelector('wind')?.textContent||'0')), lat: coords[0]||0, lon: coords[1]||0, wind: parseInt(c.querySelector('wind')?.textContent||'0'), pressure: parseInt(c.querySelector('pressure')?.textContent||'0'), movement: c.querySelector('movement')?.textContent||'', datetime: c.querySelector('datetime')?.textContent||'', headline: c.querySelector('headline')?.textContent||'' });
          }
        }
      });
      return storms;
    }

    const stormNameMap = { 'Arthur':'阿瑟','Bertha':'伯莎','Cristobal':'克里斯托瓦尔','Dolly':'多莉','Edouard':'爱德华','Fay':'费伊','Gonzalo':'贡萨洛','Hanna':'汉娜','Isaias':'伊萨亚斯','Laura':'劳拉','Marco':'马可','Nana':'娜娜','Omar':'奥马尔','Paulette':'波莱特','Rene':'雷内','Sally':'萨莉','Teddy':'泰迪','Vicky':'维基','Wilfred':'威尔弗雷德','Dorian':'多里安','Michael':'迈克尔','Florence':'弗洛伦斯','Maria':'玛丽亚','Irma':'艾尔玛','Harvey':'哈维','Ian':'伊恩','Idalia':'伊达利亚','Hilary':'希拉里','Lee':'李','Franklin':'富兰克林','Nigel':'奈杰尔','Tammy':'塔米','Fiona':'菲奥娜','Ida':'艾达','Elsa':'埃尔莎','Eta':'伊塔','Iota':'约塔','Dolphin':'海豚','Fausto':'福斯托','Genevieve':'吉纳维芙','Noul':'诺尔' };
    function localizeName(n) { return stormNameMap[n] || n; }

    function renderActiveStorms(storms) {
      const container = document.getElementById('active-storms-container');
      const heroBadge = document.getElementById('hero-storm-count');
      if (heroBadge) {
        if (storms.length === 0) { heroBadge.textContent = '☀️ 暂无活跃风暴'; heroBadge.style.background = 'rgba(34,197,94,0.2)'; }
        else { heroBadge.textContent = '🌀 ' + storms.length + ' 个活跃风暴'; }
      }
      if (storms.length === 0) {
        container.innerHTML = '<div class="card empty-state"><span class="empty-icon">☀️</span><p>当前无活跃热带风暴。</p><a href="/zh/storms" class="btn btn-outline"><span data-i18n="home.scenario.propertyBtn">浏览历史数据</span></a></div>';
        return;
      }
      var activeLang = window.__STORM_LANG__ || 'zh';
      var I18N = window.__I18N__ || {};
      var labels = {
        wind: (I18N['home.storm.wind'] && I18N['home.storm.wind'][activeLang]) || '风速',
        pressure: (I18N['home.storm.pressure'] && I18N['home.storm.pressure'][activeLang]) || '气压',
        movement: (I18N['home.storm.movement'] && I18N['home.storm.movement'][activeLang]) || '移动方向',
        location: (I18N['home.storm.location'] && I18N['home.storm.location'][activeLang]) || '位置',
        updated: (I18N['storm.lastUpdated'] && I18N['storm.lastUpdated'][activeLang]) || '最后更新',
        details: (I18N['storm.details'] && I18N['storm.details'][activeLang]) || '查看详情 →'
      };
      container.innerHTML = '<div class="grid grid-2">' + storms.map(function(s) {
        var color = getIntensityColor(s.windMph);
        return '<div class="card storm-card"><div class="storm-header"><div><h3>' + localizeName(s.name) + '</h3><span class="storm-type">' + s.type + '</span></div><span class="badge" style="background:' + color + '33;color:' + color + ';">' + (s.windMph < 39 ? '减弱中' : '活跃') + '</span></div><div class="storm-stats"><div class="stat"><span class="stat-label">' + labels.wind + '</span><span class="stat-value">' + s.windMph + ' mph</span></div><div class="stat"><span class="stat-label">' + labels.pressure + '</span><span class="stat-value">' + (s.pressureMb > 0 ? s.pressureMb + ' mb' : '—') + '</span></div><div class="stat"><span class="stat-label">' + labels.movement + '</span><span class="stat-value">' + s.movement + '</span></div><div class="stat"><span class="stat-label">' + labels.location + '</span><span class="stat-value">' + Math.abs(s.lat).toFixed(1) + '°' + (s.lat>=0?'N':'S') + ', ' + Math.abs(s.lon).toFixed(1) + '°' + (s.lon>=0?'E':'W') + '</span></div></div>' + (s.headline ? '<div class="storm-alert">⚠️ ' + s.headline + '</div>' : '') + '<div class="storm-footer"><span class="update-time">' + (s.issuedAt ? labels.updated + ': ' + new Date(s.issuedAt).toLocaleString('zh-CN') : '') + '</span><a href="/zh/map" class="btn btn-outline btn-sm">' + labels.details + '</a></div></div>';
      }).join('') + '</div>';
    }

    async function loadHomeStorms() {
      const storms = await fetchStorms();
      if (!storms) { document.getElementById('active-storms-container').innerHTML = '<div class="card empty-state"><span class="empty-icon">📡</span><p>暂时无法连接 NOAA。<a href="/zh/storms">浏览风暴数据库 →</a></p></div>'; return; }
      renderActiveStorms(storms);
    }
    loadHomeStorms();
    setInterval(loadHomeStorms, HOME_REFRESH);
  </script>

  <!-- 季节展望 -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">{t('season.title', lang)}</h2>
      <span class="badge badge-info">{seasonOutlook.forecast}</span>
    </div>
    <div class="card season-card">
      <div class="season-stats">
        <div class="season-stat"><span class="season-label">{t('season.namedStorms', lang)}</span><span class="season-value">{seasonOutlook.namedStorms}</span><span class="season-normal">{t('season.avg', lang)}: 14.4</span></div>
        <div class="season-stat"><span class="season-label">{t('season.hurricanes', lang)}</span><span class="season-value">{seasonOutlook.hurricanes}</span><span class="season-normal">{t('season.avg', lang)}: 7.2</span></div>
        <div class="season-stat"><span class="season-label">{t('season.majorHurricanes', lang)}</span><span class="season-value">{seasonOutlook.majorHurricanes}</span><span class="season-normal">{t('season.avg', lang)}: 3.2</span></div>
        <div class="season-stat"><span class="season-label">{t('season.ace', lang)}</span><span class="season-value">{seasonOutlook.ace}</span><span class="season-normal">{t('season.avg', lang)}: 123</span></div>
      </div>
      <p class="season-notes">📝 {seasonOutlook.notes}</p>
      <p class="season-dates">📅 风暴季：{seasonOutlook.season} | 高峰：{seasonOutlook.peakDate}</p>
    </div>
  </section>

  <!-- 2026 风暴 -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">{t('seasonStorms.title', lang)}</h2>
      <a href="/zh/storms" class="see-all">{t('seasonStorms.viewAll', lang)}</a>
    </div>
    <div class="grid grid-2">
      {recentStorms.map((storm) => (
        <a href={`/zh/storms/${storm.name.toLowerCase()}`} class="card storm-list-card">
          <div class="storm-list-header">
            <h3>{stormNames[storm.name] || storm.name}</h3>
            <span class="badge" style={`background: ${categoryColors[storm.category] || '#e2e8f0'}33; color: ${categoryColors[storm.category] || '#64748b'};`}>{stormCategories[storm.category] || storm.category}</span>
          </div>
          <div class="storm-list-stats">
            <span>📅 {storm.formed} → {storm.dissipated}</span>
            <span>💨 {storm.maxWind} mph</span>
            <span>📍 {t('seasonStorms.landfall', lang)}: {storm.landfall}</span>
            <span>💰 {t('seasonStorms.damage', lang)}: {storm.damage}</span>
            <span>⚠️ {t('seasonStorms.fatalities', lang)}: {storm.fatalities}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 用户分类：你住在哪个地区？ -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">🌏 <span data-i18n="home.selectRegion">你住在哪个地区？</span></h2>
    </div>
    <p class="region-intro"><span data-i18n="home.selectRegionIntro">选择你的地区，查看该海域的风暴情况和预警服务</span>。全球覆盖 8 大海域，多语言支持。</p>
    
    <div class="region-grid">
      <!-- 亚洲 -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌏</span>
          <h3><span data-i18n="home.region.asia">亚洲</span></h3>
        </div>
        <div class="region-content">
          <p class="region-desc"><span data-i18n="home.region.asiaDesc">西北太平洋（台风）+ 北印度洋（气旋）</span></p>
          <div class="region-details">
            <p><strong><span data-i18n="home.region.coverage">覆盖地区：</span></strong>日本、菲律宾、中国沿海、越南、印度、孟加拉国</p>
            <p><strong><span data-i18n="home.region.stormSeason">风暴季：</span></strong><span data-i18n="home.season.yearround">全年活跃（高峰 7-10月）</span></p>
            <p><strong>数据源：</strong>JMA（日本气象厅）、JTWC、IMD（印度气象局）</p>
            <p><strong><span data-i18n="home.region.languages">支持语言：</span></strong><span data-i18n="home.langJP">日语 · 中文 · 英语</span></p>
          </div>
          <a href="/zh/map" class="btn btn-outline btn-sm"><span data-i18n="home.region.asiaBtn">查看亚洲风暴地图</span></a>
        </div>
      </div>
      
      <!-- 北美洲 -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌎</span>
          <h3><span data-i18n="home.region.na">北美洲</span></h3>
        </div>
        <div class="region-content">
          <p class="region-desc"><span data-i18n="home.region.naDesc">北大西洋 + 东太平洋 + 中太平洋（飓风）</span></p>
          <div class="region-details">
            <p><strong>覆盖地区：</strong>美国（佛罗里达、德州、夏威夷）、加拿大、墨西哥</p>
            <p><strong>风暴季：</strong><span data-i18n="home.season.jun1nov30">6月1日 - 11月30日（高峰 9月）</span></p>
            <p><strong>数据源：</strong>NOAA NHC（美国国家飓风中心）</p>
            <p><strong>支持语言：</strong><span data-i18n="home.langEN">英语 · 中文 · 法语 · 日语</span></p>
          </div>
          <a href="/zh/alerts" class="btn btn-primary btn-sm"><span data-i18n="home.region.naBtn"><span data-i18n="home.scenario.coastalBtn">设置免费预警</span></span></a>
        </div>
      </div>
      
      <!-- 大洋洲 -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌏</span>
          <h3><span data-i18n="home.region.oceania">大洋洲</span></h3>
        </div>
        <div class="region-content">
          <p class="region-desc"><span data-i18n="home.region.oceaniaDesc">澳大利亚海域 + 南太平洋（气旋）</span></p>
          <div class="region-details">
            <p><strong>覆盖地区：</strong><span data-i18n="home.region.oceaniaCoverage">澳大利亚（昆士兰、北领地）、斐济、新喀里多尼亚</span></p>
            <p><strong>风暴季：</strong><span data-i18n="home.season.novapr">11月 - 4月（南半球夏季）</span></p>
            <p><strong>数据源：</strong>BOM（澳大利亚气象局）、FMS（斐济气象局）</p>
          </div>
          <a href="/zh/map" class="btn btn-outline btn-sm"><span data-i18n="home.region.oceaniaBtn">查看大洋洲风暴地图</span></a>
        </div>
      </div>
      
      <!-- 拉丁美洲 -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌎</span>
          <h3><span data-i18n="home.region.latam">拉丁美洲</span></h3>
        </div>
        <div class="region-content">
          <p class="region-desc"><span data-i18n="home.region.latamDesc">加勒比海 + 中美洲 + 墨西哥（飓风）</span></p>
          <div class="region-details">
            <p><strong>覆盖地区：</strong>古巴、海地、多米尼加、波多黎各、墨西哥、中美洲</p>
            <p><strong>风暴季：</strong><span data-i18n="home.season.may15nov30">5月15日 - 11月30日</span></p>
            <p><strong>数据源：</strong>NOAA NHC</p>
            <p><strong>支持语言：</strong>英语 · 中文（西班牙语 Coming Soon）</p>
          </div>
          <a href="/zh/map" class="btn btn-outline btn-sm"><span data-i18n="home.region.latamBtn">查看加勒比海风暴地图</span></a>
        </div>
      </div>
      
      <!-- 非洲 -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌍</span>
          <h3><span data-i18n="home.region.africa">非洲</span></h3>
        </div>
        <div class="region-content">
          <p class="region-desc"><span data-i18n="home.region.africaDesc">南印度洋 + 西非沿海（气旋/热带风暴）</span></p>
          <div class="region-details">
            <p><strong>覆盖地区：</strong><span data-i18n="home.region.africaCoverage">马达加斯加、莫桑比克、坦桑尼亚、肯尼亚</span></p>
            <p><strong>风暴季：</strong>11月 - 4月（南印度洋）</p>
            <p><strong>数据源：</strong>Météo-France（法国气象局）、JTWC</p>
          </div>
          <a href="/zh/map" class="btn btn-outline btn-sm"><span data-i18n="home.region.africaBtn">查看非洲风暴地图</span></a>
        </div>
      </div>
      
      <!-- 欧洲 -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌍</span>
          <h3><span data-i18n="home.region.europe">欧洲</span></h3>
        </div>
        <div class="region-content">
          <p class="region-desc"><span data-i18n="home.region.europeDesc">法国海外省 + 全球度假游客</span></p>
          <div class="region-details">
            <p><strong>覆盖地区：</strong>法国留尼汪、马约特、度假游客</p>
            <p><strong>风暴季：</strong>11月 - 4月（南印度洋）</p>
            <p><strong>数据源：</strong>Météo-France、NOAA、JTWC</p>
            <p><strong>支持语言：</strong><span data-i18n="home.langFR">法语 · 英语</span></p>
          </div>
          <a href="/fr/" class="btn btn-outline btn-sm"><span data-i18n="home.region.europeBtn">查看法语版本</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- StormTracker 能为你做什么？ -->
  <section class="section scenario-section">
    <div class="section-header">
      <h2 class="section-title">💡 <span data-i18n="home.scenario.title">StormTracker 能为你做什么？</span></h2>
    </div>
    <p class="scenario-intro">StormTracker 为真实的人面对真实的风暴而建——不是给科学家或政府官员用的。</p>
    <div class="region-grid">
      <div class="region-card scenario-card">
        <div class="scenario-icon">🏠</div>
        <h3><span data-i18n="home.scenario.coastal">沿海居民</span></h3>
        <p>在风暴抵达你社区<strong>数小时前</strong>就收到通知——而不是只剩几分钟。设置免费的邮件预警，精准到你的邮政编码，安全撤离。</p>
        <a href="/zh/alerts" class="btn btn-primary btn-sm">设置免费预警</a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">🚢</div>
        <h3><span data-i18n="home.scenario.seafarer">海员与渔民</span></h3>
        <p>根据实时台风位置规划航线。全球实时地图显示每个风暴的确切位置和8大海域的预测路径。</p>
        <a href="/zh/map" class="btn btn-outline btn-sm">查看实时地图</a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">🏨</div>
        <h3><span data-i18n="home.scenario.property">房东与物业主</span></h3>
        <p>保护你的资产。历史风暴数据显示哪些地区风险最高——这在买房、投保或管理沿海房产时至关重要。</p>
        <a href="/zh/storms" class="btn btn-outline btn-sm">浏览历史数据</a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">🚑</div>
        <h3><span data-i18n="home.scenario.emergency">应急响应人员</span></h3>
        <p>获取实时更新，提前部署资源和协调撤离。多语言支持，服务多元社区的团队。</p>
        <a href="/zh/map" class="btn btn-outline btn-sm"><span data-i18n="home.scenario.emergencyBtn">用你的语言使用</span></a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">📊</div>
        <h3><span data-i18n="home.scenario.insurer">保险与金融分析师</span></h3>
        <p>基于17年+的ACE指数趋势、登陆历史和18场重大风暴的损失对比，做出数据驱动的风险评估。</p>
        <a href="/zh/storms" class="btn btn-outline btn-sm"><span data-i18n="home.scenario.insurerBtn">查看风暴数据库</span></a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">📺</div>
        <h3><span data-i18n="home.scenario.media">媒体工作者</span></h3>
        <p>嵌入实时风暴地图，下载历史轨迹数据，获取可分享的信息图——做准确风暴报道所需的一切。</p>
        <a href="/zh/about" class="btn btn-outline btn-sm"><span data-i18n="home.scenario.mediaBtn">了解更多</span></a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">✈️</div>
        <h3><span data-i18n="home.scenario.traveler">旅行者与邮轮乘客</span></h3>
        <p>订票或规划航线经过飓风易发区前，先查风暴风险。打包前就知道目的地是否安全。</p>
        <a href="/zh/map" class="btn btn-outline btn-sm"><span data-i18n="home.scenario.travelerBtn">查看当前状况</span></a>
      </div>
    </div>
  </section>

  <!-- 防灾 -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">{t('prep.title', lang)}</h2>
      <a href="/zh/preparedness" class="see-all">{t('prep.fullGuide', lang)}</a>
    </div>
    <div class="grid grid-4">
      {preparednessTips.map((tip) => (
        <div class="card prep-card">
          <span class="prep-icon">{tip.icon}</span>
          <h4>{tip.title}</h4>
          <p>{tip.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="cta-banner">
      <div class="cta-content">
        <h2>{t('cta.title', lang)}</h2>
        <p>{t('cta.desc', lang)}</p>
        <form class="subscribe-form">
          <input type="email" placeholder="your@email.com" required />
          <button type="submit" class="btn btn-primary">{t('cta.subscribe', lang)}</button>
        </form>
      </div>
    </div>
  </section>

  <style>
    .hero { background: linear-gradient(135deg, #0c4a6e 0%, #075985 50%, #0369a1 100%); border-radius: var(--radius); padding: 3rem 2rem; margin-bottom: 2.5rem; color: white; position: relative; overflow: hidden; }
    .hero::before { content: ''; position: absolute; top: -50%; right: -10%; width: 400px; height: 400px; background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%); border-radius: 50%; }
    .hero-content { position: relative; z-index: 1; max-width: 600px; }
    .hero h1 { font-size: 2.5rem; font-weight: 800; margin: 1rem 0; line-height: 1.2; }
    .hero p { font-size: 1.1rem; opacity: 0.9; margin-bottom: 1.5rem; }
    .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
    .hero-actions .btn-primary { background: var(--color-accent); }
    .hero-actions .btn-primary:hover { background: #d97706; }
    .hero-actions .btn-outline { color: white; border-color: rgba(255,255,255,0.4); }
    .hero-actions .btn-outline:hover { background: rgba(255,255,255,0.1); border-color: white; }
    .section { margin-bottom: 2.5rem; }
    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .section-title { margin-bottom: 0; }
    .see-all { color: var(--color-primary); text-decoration: none; font-weight: 500; }
    .storm-card { display: flex; flex-direction: column; gap: 1rem; }
    .storm-header { display: flex; justify-content: space-between; align-items: flex-start; }
    .storm-header h3 { font-size: 1.5rem; margin: 0; }
    .storm-type { color: var(--color-text-secondary); font-size: 0.9rem; }
    .storm-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .stat { display: flex; flex-direction: column; }
    .stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); }
    .stat-value { font-size: 1.1rem; font-weight: 600; }
    .storm-alert { background: #fef3c7; border: 1px solid #fcd34d; border-radius: 8px; padding: 0.75rem 1rem; font-size: 0.9rem; color: #92400e; }
    .storm-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 0.5rem; border-top: 1px solid var(--color-border); }
    .update-time { font-size: 0.8rem; color: var(--color-text-secondary); }
    .btn-sm { padding: 0.5rem 1rem; font-size: 0.85rem; }
    .storm-list-card { text-decoration: none; color: inherit; }
    .storm-list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
    .storm-list-header h3 { font-size: 1.2rem; margin: 0; }
    .storm-list-stats { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem; color: var(--color-text-secondary); }
    .empty-state { text-align: center; padding: 3rem 2rem; }
    .empty-icon { font-size: 3rem; display: block; margin-bottom: 1rem; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    @media (max-width: 1024px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px) { .grid-4 { grid-template-columns: 1fr; } }
    .prep-card { text-align: center; }
    .prep-icon { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
    .prep-card h4 { margin-bottom: 0.5rem; }
    .prep-card p { font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.5; }
    .badge-info { background: #dbeafe; color: #1e40af; }
    .season-card { padding: 2rem; }
    .season-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; margin-bottom: 1.5rem; }
    @media (max-width: 768px) { .season-stats { grid-template-columns: repeat(2, 1fr); } }
    .season-stat { text-align: center; }
    .season-label { display: block; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); margin-bottom: 0.25rem; }
    .season-value { display: block; font-size: 1.75rem; font-weight: 800; color: var(--color-primary); }
    .season-normal { display: block; font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 0.25rem; }
    .season-notes { color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; margin-bottom: 0.5rem; }
    .season-dates { color: var(--color-text-secondary); font-size: 0.85rem; }
    .cta-banner { background: linear-gradient(135deg, #1e3a5f 0%, #0c4a6e 100%); border-radius: var(--radius); padding: 2.5rem 2rem; text-align: center; color: white; }
    .cta-content { max-width: 500px; margin: 0 auto; }
    .cta-content h2 { font-size: 1.75rem; margin-bottom: 0.5rem; }
    .cta-content p { opacity: 0.9; margin-bottom: 1.5rem; }
    .subscribe-form { display: flex; gap: 0.5rem; }
    .subscribe-form input { flex: 1; padding: 0.75rem 1rem; border: none; border-radius: 8px; font-size: 0.95rem; }
    .subscribe-form .btn-primary { background: var(--color-accent); }
    .subscribe-form .btn-primary:hover { background: #d97706; }
    @media (max-width: 640px) { .subscribe-form { flex-direction: column; } }
    .live-indicator { display: flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 700; color: #22c55e; text-transform: uppercase; letter-spacing: 0.05em; }
    .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; animation: pulse 2s ease-in-out infinite; }
    .loading-card { text-align: center; padding: 2rem; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; color: var(--color-text-secondary); }
    .loading-spinner-small { width: 32px; height: 32px; border: 3px solid var(--color-border); border-top-color: var(--color-primary); border-radius: 50%; animation: spin 0.8s linear infinite; }
    
    /* 地区分类 */
    .region-intro { color: var(--color-text-secondary); margin-bottom: 1.5rem; font-size: 1rem; }
    .region-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
    .region-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1.5rem; transition: all 0.2s; }
    .region-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); border-color: var(--color-primary); }
    .region-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; }
    .region-icon { font-size: 2rem; }
    .region-header h3 { font-size: 1.25rem; margin: 0; }
    .region-desc { color: var(--color-primary); font-weight: 600; margin-bottom: 1rem; font-size: 0.95rem; }
    .region-details { margin-bottom: 1rem; }
    .region-details p { font-size: 0.85rem; margin: 0.4rem 0; color: var(--color-text-secondary); }
    .region-details strong { color: var(--color-text); }
    
    /* 场景化区块 */
    .scenario-section { background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface) 100%); }
    .scenario-intro { color: var(--color-text-secondary); font-size: 1rem; margin-bottom: 1.5rem; max-width: 600px; }
    .scenario-card { display: flex; flex-direction: column; }
    .scenario-icon { font-size: 2.25rem; margin-bottom: 0.75rem; }
    .scenario-card h3 { font-size: 1.1rem; margin: 0 0 0.5rem; }
    .scenario-card p { font-size: 0.88rem; line-height: 1.6; color: var(--color-text-secondary); flex: 1; margin-bottom: 1rem; }
    .scenario-card .btn { align-self: flex-start; }

    @keyframes spin { to { transform: rotate(360deg); } }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  </style>
</BaseLayout>
