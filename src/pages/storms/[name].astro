---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 动态风暴详情页 [name] — 实际使用 getStaticPaths 从数据源生成
export async function getStaticPaths() {
  const storms = [
    { name: 'arthur', displayName: 'Arthur', year: 2024 },
    { name: 'bertha', displayName: 'Bertha', year: 2024 },
    { name: 'cristobal', displayName: 'Cristobal', year: 2024 },
    { name: 'dolly', displayName: 'Dolly', year: 2024 },
    { name: 'edouard', displayName: 'Edouard', year: 2024 },
    { name: 'fay', displayName: 'Fay', year: 2024 },
    { name: 'gonzalo', displayName: 'Gonzalo', year: 2024 },
    { name: 'hanna', displayName: 'Hanna', year: 2024 },
    { name: 'isaias', displayName: 'Isaias', year: 2024 },
    { name: 'josephine', displayName: 'Josephine', year: 2024 },
  ];

  return storms.map(storm => ({
    params: { name: storm.name },
    props: { storm },
  }));
}

const { storm } = Astro.props;

// 模拟风暴详细数据 — 实际从 HURDAT2 数据库获取
const stormData = {
  name: storm.displayName,
  year: storm.year,
  category: 'TS',
  maxWind: 52,
  minPressure: 1003,
  formed: `${storm.year}-06-01`,
  dissipated: `${storm.year}-06-03`,
  duration: '3 days',
  landfall: 'None',
  region: 'Atlantic',
  damage: '$0M',
  fatalities: 0,
  description: `Tropical Storm ${storm.displayName} was a relatively weak tropical storm that formed in the Atlantic Ocean during the ${storm.year} hurricane season. The storm remained over open water for its entire duration and did not make landfall.`,
  track: [
    { time: '2024-06-01 06:00 UTC', lat: 28.5, lon: -75.2, wind: 35, pressure: 1010 },
    { time: '2024-06-01 12:00 UTC', lat: 29.0, lon: -74.8, wind: 40, pressure: 1008 },
    { time: '2024-06-01 18:00 UTC', lat: 29.8, lon: -74.2, wind: 45, pressure: 1006 },
    { time: '2024-06-02 00:00 UTC', lat: 30.5, lon: -73.5, wind: 50, pressure: 1004 },
    { time: '2024-06-02 06:00 UTC', lat: 31.2, lon: -72.8, wind: 52, pressure: 1003 },
    { time: '2024-06-02 12:00 UTC', lat: 32.0, lon: -71.5, wind: 48, pressure: 1005 },
    { time: '2024-06-02 18:00 UTC', lat: 33.0, lon: -70.0, wind: 40, pressure: 1008 },
    { time: '2024-06-03 00:00 UTC', lat: 34.0, lon: -68.0, wind: 35, pressure: 1010 },
  ],
};

// 结构化数据 — Event schema for SEO
const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": `Tropical Storm ${stormData.name} ${stormData.year}`,
  "startDate": stormData.formed,
  "endDate": stormData.dissipated,
  "description": stormData.description,
  "eventStatus": "https://schema.org/EventCompleted",
  "location": {
    "@type": "Place",
    "name": stormData.region,
  },
};
---

<BaseLayout
  title={`Tropical Storm ${stormData.name} (${stormData.year})`}
  description={`${stormData.name} was a tropical storm in ${stormData.year}. Max winds: ${stormData.maxWind} mph. Track, stats, and impact information.`}
  canonical={`/storms/${storm.name}/`}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/">Home</a> <span>/</span>
    <a href="/storms">Storms</a> <span>/</span>
    <span>{stormData.name} {stormData.year}</span>
  </nav>

  <!-- Storm Header -->
  <div class="storm-detail-header">
    <div>
      <h1>Tropical Storm {stormData.name}</h1>
      <span class="storm-year">{stormData.year} Atlantic Hurricane Season</span>
    </div>
    <span class="badge badge-active">{stormData.category}</span>
  </div>

  <!-- Quick Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">Max Wind Speed</span>
      <span class="stat-value">{stormData.maxWind} <span class="unit">mph</span></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Min Pressure</span>
      <span class="stat-value">{stormData.minPressure} <span class="unit">mb</span></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Duration</span>
      <span class="stat-value">{stormData.duration}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Region</span>
      <span class="stat-value">{stormData.region}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Landfall</span>
      <span class="stat-value">{stormData.landfall}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Damage</span>
      <span class="stat-value">{stormData.damage}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Fatalities</span>
      <span class="stat-value">{stormData.fatalities}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Formed</span>
      <span class="stat-value">{stormData.formed}</span>
    </div>
  </div>

  <!-- Description -->
  <section class="section">
    <h2>Overview</h2>
    <p>{stormData.description}</p>
  </section>

  <!-- Track Data Table -->
  <section class="section">
    <h2>Storm Track Data</h2>
    <div class="table-container">
      <table class="track-table">
        <thead>
          <tr>
            <th>Time (UTC)</th>
            <th>Latitude</th>
            <th>Longitude</th>
            <th>Wind (mph)</th>
            <th>Pressure (mb)</th>
          </tr>
        </thead>
        <tbody>
          {stormData.track.map((point) => (
            <tr>
              <td>{point.time}</td>
              <td>{point.lat}°N</td>
              <td>{Math.abs(point.lon)}°W</td>
              <td>{point.wind}</td>
              <td>{point.pressure}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Simple Map -->
  <section class="section">
    <h2>Storm Path</h2>
    <div id="storm-track-map" class="track-map"></div>
    <script is:inline define:vars={{ trackPoints: stormData.track }}>
      function initTrackMap() {
        if (typeof L === 'undefined') {
          setTimeout(initTrackMap, 100);
          return;
        }
        const map = L.map('storm-track-map', {
          center: [trackPoints[0].lat, trackPoints[0].lon],
          zoom: 4,
        });

        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
          attribution: '&copy; OpenStreetMap &copy; CARTO',
          subdomains: 'abcd',
        }).addTo(map);

        // Path line
        const latlngs = trackPoints.map(p => [p.lat, p.lon]);
        L.polyline(latlngs, {
          color: '#ffd43b',
          weight: 3,
          opacity: 0.8,
        }).addTo(map);

        // Markers for each point
        trackPoints.forEach((p, i) => {
          const isFirst = i === 0;
          const isLast = i === trackPoints.length - 1;
          L.circleMarker([p.lat, p.lon], {
            radius: isFirst || isLast ? 8 : 5,
            fillColor: isFirst ? '#4dabf7' : isLast ? '#ef4444' : '#ffd43b',
            color: '#000',
            weight: 2,
            fillOpacity: 0.8,
          }).addTo(map).bindPopup(
            `<strong>${p.time}</strong><br>Wind: ${p.wind} mph<br>Pressure: ${p.pressure} mb<br>Position: ${p.lat}°N, ${Math.abs(p.lon)}°W`
          );
        });

        // Fit bounds
        map.fitBounds(latlngs, { padding: [40, 40] });
      }
      initTrackMap();
    </script>
  </section>

  <!-- Schema.org Event -->
  <script type="application/ld+json" set:html={JSON.stringify(eventData)} />

  <style>
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
      color: var(--color-text-secondary);
    }

    .breadcrumb a {
      color: var(--color-primary);
      text-decoration: none;
    }

    .breadcrumb a:hover {
      text-decoration: underline;
    }

    .storm-detail-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.5rem;
    }

    .storm-detail-header h1 {
      font-size: 2rem;
      margin: 0;
    }

    .storm-year {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 2rem;
    }

    @media (max-width: 768px) {
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .stat-card {
      background: var(--color-surface);
      border-radius: 8px;
      padding: 1rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .stat-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
    }

    .stat-value {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .unit {
      font-size: 0.85rem;
      font-weight: 400;
      color: var(--color-text-secondary);
    }

    .section {
      margin-bottom: 2rem;
    }

    .section h2 {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }

    .section p {
      color: var(--color-text-secondary);
      line-height: 1.7;
    }

    .table-container {
      overflow-x: auto;
      background: var(--color-surface);
      border-radius: 8px;
      box-shadow: var(--shadow-sm);
    }

    .track-table {
      width: 100%;
      border-collapse: collapse;
    }

    .track-table th {
      background: #f1f5f9;
      padding: 0.6rem 1rem;
      text-align: left;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
    }

    .track-table td {
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--color-border);
      font-size: 0.9rem;
    }

    .track-table tbody tr:hover {
      background: #f8fafc;
    }

    .track-map {
      width: 100%;
      height: 400px;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      background: #1a1a2e;
    }
  </style>
</BaseLayout>
