---
import BaseLayout from '../layouts/BaseLayout.astro';
import activeData from '../data/active.json';
import { BASIN_LIST } from '../data/basins.mjs';

const lang = 'en';
const { _fallback, fetchedAt, source } = activeData;
const buildTime = new Date(fetchedAt).toLocaleString('en-US', {
  month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short',
});
// 流域筛选数据传给客户端
const basinsJson = JSON.stringify(BASIN_LIST.map(b => ({
  id: b.id, name: b.names.en, agency: b.agencyShort, flag: b.flag, center: b.center,
})));
---

<BaseLayout
  title="Live Global Storm Map"
  description="Real-time interactive map of active tropical cyclones worldwide. Live data from NOAA NHC & JTWC, attributed to each region's official agency."
  lang={lang}
>
  {(_fallback) && (
    <div class="warning-banner">
      <span aria-hidden="true">⚠️</span> Live data temporarily unavailable — showing cached data from {buildTime}. Updates will resume shortly.
    </div>
  )}

  <div class="page-header">
    <div>
      <h1><span aria-hidden="true">🗺️</span> Live Global Storm Map</h1>
      <p>Real-time tracking of active tropical cyclones across all ocean basins. Data from <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA NHC</a> &amp; <a href="https://www.metoc.navy.mil/jtwc/jtwc.html" target="_blank" rel="noopener">JTWC</a>, attributed to each region's official agency.</p>
    </div>
    <div class="map-status" id="map-status">
      <span class="status-indicator loading">Connecting to live feeds...</span>
    </div>
  </div>

  <!-- Basin filter -->
  <div class="basin-filter" id="basin-filter" role="group" aria-label="Filter by ocean basin">
    <button class="basin-btn active" data-basin="all">🌍 All Basins</button>
  </div>

  <div class="map-legend">
    <div class="legend-title"><span aria-hidden="true">🌪️</span> Legend</div>
    <div class="legend-items">
      <span class="legend-item"><span class="legend-dot" style="background:#4dabf7;"></span> Tropical Depression</span>
      <span class="legend-item"><span class="legend-dot" style="background:#ffd43b;"></span> Tropical Storm</span>
      <span class="legend-item"><span class="legend-dot" style="background:#ff8787;"></span> Cat-1</span>
      <span class="legend-item"><span class="legend-dot" style="background:#fa5252;"></span> Cat-2</span>
      <span class="legend-item"><span class="legend-dot" style="background:#e64980;"></span> Cat-3</span>
      <span class="legend-item"><span class="legend-dot" style="background:#cc5de8;"></span> Cat-4</span>
      <span class="legend-item"><span class="legend-dot" style="background:#845ef7;"></span> Cat-5</span>
    </div>
  </div>

  <div id="storm-map" class="storm-map"></div>

  <div class="map-footer">
    <p>
      <span aria-hidden="true">🟢</span> <strong id="fetch-status">Live</strong> · Updated: <span id="last-updated">{buildTime}</span>
      · Sources: <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA NHC</a> (Atlantic/EPac/CPac),
      <a href="https://www.jma.go.jp/bosai/map.html#contents=typhoon" target="_blank" rel="noopener">JMA</a>,
      <a href="https://mausam.imd.gov.in/" target="_blank" rel="noopener">IMD</a>,
      <a href="https://meteofrance.com/" target="_blank" rel="noopener">Météo-France</a>,
      <a href="http://www.bom.gov.au/" target="_blank" rel="noopener">BOM</a>,
      <a href="https://www.metoc.navy.mil/jtwc/jtwc.html" target="_blank" rel="noopener">FMS</a> (via JTWC)
    </p>
  </div>

  <script is:inline define:vars={{ fallback: _fallback, buildTime, basinsJson }}>
    // 地图数据由客户端 JS 从 /api/global-storms 实时获取
    document.getElementById('fetch-status').innerHTML = fallback ? '<span aria-hidden="true">⚠️</span> Cached' : '🟢 Live';

    var BASINS = JSON.parse(basinsJson);
    // 注入流域筛选按钮
    (function() {
      var filter = document.getElementById('basin-filter');
      if (filter && BASINS) {
        BASINS.forEach(function(b) {
          var btn = document.createElement('button');
          btn.className = 'basin-btn';
          btn.setAttribute('data-basin', b.id);
          btn.innerHTML = b.flag + ' ' + b.name;
          filter.appendChild(btn);
        });
      }
    })();
  </script>

  <script is:inline>
    var map;
    var markersLayer;
    var allStorms = [];
    var currentBasin = 'all';

    function getIntensityColor(wind) {
      if (wind < 39) return '#4dabf7';
      if (wind < 74) return '#ffd43b';
      if (wind < 96) return '#ff8787';
      if (wind < 111) return '#fa5252';
      if (wind < 130) return '#e64980';
      if (wind < 157) return '#cc5de8';
      return '#845ef7';
    }

    function getBasinCenter(basinId) {
      var b = BASINS.find(function(x){ return x.id === basinId; });
      return b ? b.center : [15, 140];
    }

    function initMap() {
      map = L.map('storm-map', {
        center: [15, 140],
        zoom: 3,
        scrollWheelZoom: true,
        zoomControl: true,
      });

      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 18,
      }).addTo(map);

      markersLayer = L.layerGroup().addTo(map);
      fetchAndDisplayStorms();

      // 流域筛选事件
      document.getElementById('basin-filter').addEventListener('click', function(e) {
        var btn = e.target.closest('.basin-btn');
        if (!btn) return;
        document.querySelectorAll('.basin-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        currentBasin = btn.getAttribute('data-basin');
        
        // GA4 事件：流域筛选
        if (typeof trackEvent !== 'undefined') {
          trackEvent('map_filter_basin', {
            basin_id: currentBasin,
            basin_name: BASINS.find(function(b){ return b.id === currentBasin; })?.name || 'All Basins',
            page_language: 'en'
          });
        }
        
        renderMarkers();
      });
      
      // GA4 事件：地图缩放
      map.on('zoomend', function() {
        if (typeof trackEvent !== 'undefined') {
          trackEvent('map_zoom', {
            zoom_level: map.getZoom(),
            view_type: currentBasin === 'all' ? 'global' : 'basin',
            page_language: 'en'
          });
        }
      });
      
      // GA4 事件：地图平移（防抖）
      var panTimeout;
      map.on('moveend', function() {
        clearTimeout(panTimeout);
        panTimeout = setTimeout(function() {
          if (typeof trackEvent !== 'undefined') {
            var center = map.getCenter();
            trackEvent('map_pan', {
              center_lat: center.lat.toFixed(2),
              center_lon: center.lng.toFixed(2),
              zoom_level: map.getZoom(),
              page_language: 'en'
            });
          }
        }, 2000);  // 2秒防抖
      });
      
      // GA4 事件：地图加载完成
      if (typeof trackEvent !== 'undefined') {
        trackEvent('map_loaded', {
          initial_zoom: 3,
          initial_center: '15N,140E',
          page_language: 'en'
        });
      }
    }

    function renderMarkers() {
      markersLayer.clearLayers();
      var shown = allStorms.filter(function(s){ return currentBasin === 'all' || s.basin === currentBasin; });
      if (shown.length === 0) {
        var statusEl = document.querySelector('#map-status .status-indicator');
        if (statusEl) {
          statusEl.className = 'status-indicator no-active';
          statusEl.innerHTML = currentBasin === 'all' ? '<span aria-hidden="true">☀️</span> No active storms' : 'No active storms in this basin';
        }
        return;
      }
      var bounds = [];
      shown.forEach(function(storm) {
        var color = getIntensityColor(storm.windMph);
        var marker = L.circleMarker([storm.lat, storm.lon], {
          radius: 12,
          fillColor: color,
          color: '#ffffff',
          weight: 2.5,
          fillOpacity: 0.85,
        });
        bounds.push([storm.lat, storm.lon]);

        var popup = '<div style="min-width:220px;">' +
          '<h3 style="margin:0 0 4px;font-size:1.1em;">' + storm.name + (storm.designation ? ' (' + storm.designation + ')' : '') + '</h3>' +
          '<p style="margin:0 0 6px;font-size:0.82em;color:#64748b;">' + (storm.type || 'Tropical Cyclone') + ' · ' + (storm.basinName || '') + '</p>' +
          '<table style="width:100%;font-size:0.82em;border-collapse:collapse;">' +
          '<tr><td style="padding:2px 4px;font-weight:600;">Wind</td><td style="padding:2px 4px;">' + storm.windMph + ' mph</td></tr>' +
          '<tr><td style="padding:2px 4px;font-weight:600;">Pressure</td><td style="padding:2px 4px;">' + (storm.pressureMb > 0 ? storm.pressureMb + ' mb' : '—') + '</td></tr>' +
          '<tr><td style="padding:2px 4px;font-weight:600;">Movement</td><td style="padding:2px 4px;">' + storm.movement + '</td></tr>' +
          '<tr><td style="padding:2px 4px;font-weight:600;">Location</td><td style="padding:2px 4px;">' + Math.abs(storm.lat).toFixed(1) + '°' + (storm.lat>=0?'N':'S') + ', ' + Math.abs(storm.lon).toFixed(1) + '°' + (storm.lon>=0?'E':'W') + '</td></tr>' +
          '<tr><td style="padding:2px 4px;font-weight:600;">Source</td><td style="padding:2px 4px;">' + (storm.agency || storm.source) + '</td></tr>' +
          '</table>' +
          (storm.warningUrl ? '<p style="margin:8px 0 0;font-size:0.8em;"><a href="' + storm.warningUrl + '" target="_blank" rel="noopener">View official advisory →</a></p>' : '') +
          '</div>';
        marker.bindPopup(popup);
        markersLayer.addLayer(marker);
        
        // GA4 事件：标记点击
        marker.on('click', function() {
          if (typeof trackEvent !== 'undefined') {
            trackEvent('map_marker_click', {
              storm_name: storm.name,
              storm_designation: storm.designation || '',
              storm_category: getIntensityColor(storm.windMph),
              wind_mph: storm.windMph,
              basin_id: storm.basin,
              basin_name: storm.basinName,
              agency: storm.agency || storm.source,
              page_language: 'en'
            });
          }
        });
      });
      if (currentBasin === 'all') {
        map.fitBounds(bounds, { padding: [50, 50], maxZoom: 5 });
      } else {
        var c = getBasinCenter(currentBasin);
        map.setView(c, 4);
      }
    }

    async function fetchAndDisplayStorms() {
      var statusEl = document.getElementById('map-status');
      var statusTextEl = statusEl ? statusEl.querySelector('.status-indicator') : null;
      var fetchStatusEl = document.getElementById('fetch-status');
      var lastUpdatedEl = document.getElementById('last-updated');

      function setStatus(type, text) {
        if (statusTextEl) {
          statusTextEl.className = 'status-indicator ' + type;
          statusTextEl.innerHTML = text;
        }
        if (fetchStatusEl) {
          fetchStatusEl.innerHTML = type === 'error' ? '<span aria-hidden="true">⚠️</span> Unavailable' : type === 'loading' ? 'Loading...' : '🟢 Live';
        }
      }

      setStatus('loading', 'Fetching live data...');

      try {
        var resp = await fetch('/api/global-storms');
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        var data = await resp.json();
        allStorms = data.storms || [];

        if (allStorms.length > 0) {
          setStatus('live', allStorms.length + ' Active Storm' + (allStorms.length > 1 ? 's' : ''));
        } else {
          setStatus('no-active', '<span aria-hidden="true">☀️</span> No active storms');
        }
        renderMarkers();

        if (data.fetchedAt && lastUpdatedEl) {
          var d = new Date(data.fetchedAt);
          lastUpdatedEl.textContent = d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });
        }
      } catch (err) {
        setStatus('error', '⚠️ Unable to reach live feeds');
        console.error('Failed to fetch storms:', err);
      }
    }

    // 地图懒加载：只在用户滚动到视口时初始化
    var mapObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          initMap();
          mapObserver.disconnect();
        }
      });
    }, { rootMargin: '200px' });

    var mapEl = document.getElementById('storm-map');
    if (mapEl) mapObserver.observe(mapEl);

    // 每 5 分钟自动刷新
    setInterval(fetchAndDisplayStorms, 5 * 60 * 1000);

    // 修复地图容器尺寸问题：窗口resize时刷新地图
    window.addEventListener('resize', function() {
      if (map) {
        setTimeout(function() { map.invalidateSize(); }, 100);
      }
    });
  </script>

  <style>
    .warning-banner {
      background: #fef9c3;
      border: 1px solid #fcd34d;
      color: #92400e;
      padding: 0.75rem 1.5rem;
      border-radius: var(--radius);
      font-size: 0.9rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
    .page-header h1 { font-size: 2rem; margin: 0 0 0.5rem; }
    .page-header p { color: var(--color-text-secondary); margin: 0; max-width: 640px; }
    .page-header a { color: var(--color-primary); }
    .map-status { text-align: right; }
    .status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .status-indicator.loading { background: #dbeafe; color: #1e40af; }
    .status-indicator.live { background: #d1fae5; color: #065f46; }
    .status-indicator.no-active { background: #f0fdf4; color: #166534; }
    .status-indicator.error { background: #fef3c7; color: #92400e; }
    .basin-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .basin-btn {
      border: 2px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text);
      padding: 0.45rem 0.85rem;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .basin-btn:hover { border-color: var(--color-primary); }
    .basin-btn.active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
    .map-legend {
      background: var(--color-surface);
      border-radius: 8px;
      padding: 0.75rem 1.25rem;
      margin-bottom: 1rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .legend-title { font-weight: 700; font-size: 0.85rem; }
    .legend-items { display: flex; gap: 1rem; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--color-text-secondary); }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .storm-map { width: 100%; height: 550px; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); background: #e8eef4; }
    .map-footer { margin-top: 0.75rem; font-size: 0.8rem; color: var(--color-text-secondary); }
    .map-footer a { color: var(--color-primary); }
    @media (max-width: 768px) {
      .storm-map { height: 400px; }
      .map-legend { flex-direction: column; align-items: flex-start; }
      .basin-filter { gap: 0.4rem; }
      .basin-btn { font-size: 0.75rem; padding: 0.4rem 0.7rem; }
    }
  </style>
</BaseLayout>
