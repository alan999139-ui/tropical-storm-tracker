---
import BaseLayout from '../layouts/BaseLayout.astro';

// 2026 Atlantic Hurricane Season — 真实数据 (来源: NOAA NHC)
// 更新: 2026-07-24
const storms = [
  { name: 'Arthur', year: 2026, category: 'TS', maxWind: 45, minPressure: 1002, formed: '2026-06-15', dissipated: '2026-06-17', fatalities: 4, damage: '$1B', region: 'Gulf of Mexico' },
  { name: 'Bertha', year: 2026, category: 'TD', maxWind: 50, minPressure: 1003, formed: '2026-07-21', dissipated: '2026-07-24', fatalities: 0, damage: 'TBD', region: 'Gulf of Mexico' },
];

const categoryColors: Record<string, string> = {
  TD: '#4dabf7',
  TS: '#ffd43b',
  'Cat-1': '#ff8787',
  'Cat-2': '#fa5252',
  'Cat-3': '#e64980',
  'Cat-4': '#cc5de8',
  'Cat-5': '#845ef7',
};

const years = [...new Set(storms.map(s => s.year))].sort((a, b) => b - a);
---

<BaseLayout
  title="Storms"
  description="Browse our comprehensive database of tropical storms and hurricanes. Search by year, name, category, or region."
>
  <div class="page-header">
    <h1>🌪️ Storm Database</h1>
    <p>Comprehensive records of tropical storms and hurricanes. Data sourced from NOAA HURDAT2.</p>
  </div>

  <!-- Filters -->
  <div class="filters">
    <div class="filter-group">
      <label>Year</label>
      <select id="filter-year">
        <option value="">All Years</option>
        {years.map(year => <option value={year}>{year}</option>)}
      </select>
    </div>
    <div class="filter-group">
      <label>Category</label>
      <select id="filter-category">
        <option value="">All Categories</option>
        <option value="TD">Tropical Depression</option>
        <option value="TS">Tropical Storm</option>
        <option value="Cat-1">Category 1</option>
        <option value="Cat-2">Category 2</option>
        <option value="Cat-3">Category 3</option>
        <option value="Cat-4">Category 4</option>
        <option value="Cat-5">Category 5</option>
      </select>
    </div>
    <div class="filter-group">
      <label>Region</label>
      <select id="filter-region">
        <option value="">All Regions</option>
        <option value="Atlantic">Atlantic</option>
        <option value="Gulf of Mexico">Gulf of Mexico</option>
        <option value="Caribbean">Caribbean</option>
        <option value="Pacific">Pacific</option>
      </select>
    </div>
    <div class="filter-group">
      <label>Search</label>
      <input type="text" id="filter-search" placeholder="Storm name..." />
    </div>
  </div>

  <!-- Results count -->
  <div class="results-bar">
    <span id="results-count">{storms.length} storms found</span>
  </div>

  <!-- Storm Table -->
  <div class="table-container">
    <table class="storm-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Year</th>
          <th>Category</th>
          <th>Max Wind</th>
          <th>Min Pressure</th>
          <th>Formed</th>
          <th>Dissipated</th>
          <th>Region</th>
          <th>Damage</th>
        </tr>
      </thead>
      <tbody id="storm-table-body">
        {storms.map((storm) => (
          <tr data-year={storm.year} data-category={storm.category} data-region={storm.region} data-name={storm.name.toLowerCase()}>
            <td>
              <a href={`/storms/${storm.name.toLowerCase()}`} class="storm-link">{storm.name}</a>
            </td>
            <td>{storm.year}</td>
            <td>
              <span class="badge" style={`background: ${categoryColors[storm.category] || '#e2e8f0'}33; color: ${categoryColors[storm.category] || '#64748b'};`}>{storm.category}</span>
            </td>
            <td>{storm.maxWind} mph</td>
            <td>{storm.minPressure} mb</td>
            <td>{storm.formed}</td>
            <td>{storm.dissipated}</td>
            <td>{storm.region}</td>
            <td>{storm.damage}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- No results -->
  <div id="no-results" class="no-results" style="display: none;">
    <span class="no-results-icon">🔍</span>
    <p>No storms match your filters.</p>
  </div>

  <script is:inline>
    // 简单的表格筛选
    const yearFilter = document.getElementById('filter-year');
    const categoryFilter = document.getElementById('filter-category');
    const regionFilter = document.getElementById('filter-region');
    const searchInput = document.getElementById('filter-search');
    const tableBody = document.getElementById('storm-table-body');
    const resultsCount = document.getElementById('results-count');
    const noResults = document.getElementById('no-results');
    const tableContainer = document.querySelector('.table-container');

    function applyFilters() {
      const year = yearFilter.value;
      const category = categoryFilter.value;
      const region = regionFilter.value;
      const search = searchInput.value.toLowerCase();

      let visible = 0;
      const rows = tableBody.querySelectorAll('tr');

      rows.forEach(row => {
        const matchYear = !year || row.dataset.year === year;
        const matchCategory = !category || row.dataset.category === category;
        const matchRegion = !region || row.dataset.region === region;
        const matchSearch = !search || row.dataset.name.includes(search);

        if (matchYear && matchCategory && matchRegion && matchSearch) {
          row.style.display = '';
          visible++;
        } else {
          row.style.display = 'none';
        }
      });

      resultsCount.textContent = `${visible} storm${visible !== 1 ? 's' : ''} found`;
      noResults.style.display = visible === 0 ? 'block' : 'none';
      tableContainer.style.display = visible === 0 ? 'none' : 'block';
    }

    [yearFilter, categoryFilter, regionFilter].forEach(el => el.addEventListener('change', applyFilters));
    searchInput.addEventListener('input', applyFilters);
  </script>

  <style>
    .page-header {
      margin-bottom: 2rem;
    }

    .page-header h1 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .page-header p {
      color: var(--color-text-secondary);
    }

    .filters {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
      background: var(--color-surface);
      padding: 1.5rem;
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
    }

    .filter-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .filter-group label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
      font-weight: 600;
    }

    .filter-group select,
    .filter-group input {
      padding: 0.6rem 0.75rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      font-size: 0.9rem;
      font-family: inherit;
      background: white;
    }

    .filter-group select:focus,
    .filter-group input:focus {
      outline: 2px solid var(--color-primary);
      outline-offset: -1px;
      border-color: var(--color-primary);
    }

    .results-bar {
      margin-bottom: 1rem;
      color: var(--color-text-secondary);
      font-size: 0.9rem;
    }

    .table-container {
      overflow-x: auto;
      background: var(--color-surface);
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
    }

    .storm-table {
      width: 100%;
      border-collapse: collapse;
    }

    .storm-table th {
      background: #f1f5f9;
      padding: 0.75rem 1rem;
      text-align: left;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
      font-weight: 600;
      border-bottom: 1px solid var(--color-border);
    }

    .storm-table td {
      padding: 0.75rem 1rem;
      border-bottom: 1px solid var(--color-border);
      font-size: 0.9rem;
    }

    .storm-table tbody tr:hover {
      background: #f8fafc;
    }

    .storm-link {
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 600;
    }

    .storm-link:hover {
      text-decoration: underline;
    }

    .no-results {
      text-align: center;
      padding: 3rem 2rem;
    }

    .no-results-icon {
      font-size: 3rem;
      display: block;
      margin-bottom: 1rem;
    }

    @media (max-width: 768px) {
      .filters {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>
</BaseLayout>
