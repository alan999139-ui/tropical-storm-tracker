---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dict';

const lang = 'ja';
---

<BaseLayout title={t('map.title', lang)} description="全球の热带低気圧をリアルタイムで追跡します。" lang={lang}>
  <div class="page-header">
    <div>
      <h1><span aria-hidden="true">🗺️</span> リアルタイム全球風暴追跡マップ</h1>
      <p>全球の热带低気圧をリアルタイムで追跡します。</p>
    </div>
    <div class="map-status" id="map-status"><span class="status-indicator loading">リアルタイムデータに接続中...</span></div>
  </div>

  <div class="map-toolbar">
    <div class="basin-filter" id="basin-filter" role="group" aria-label="海域でフィルター">
      <button class="basin-btn active" data-basin="all">🌍 すべての海域</button>
      <button class="basin-btn" data-basin="north_atlantic">🌊 北大西洋</button>
      <button class="basin-btn" data-basin="east_pacific">🌊 東太平洋</button>
      <button class="basin-btn" data-basin="central_pacific">🌊 中太平洋</button>
      <button class="basin-btn" data-basin="northwest_pacific">🌀 北西太平洋</button>
      <button class="basin-btn" data-basin="north_indian">🌀 北インド洋</button>
      <button class="basin-btn" data-basin="south_indian">🌊 南インド洋</button>
      <button class="basin-btn" data-basin="south_pacific">🌊 南太平洋</button>
      <button class="basin-btn" data-basin="australia">🦘 オーストラリア海域</button>
    </div>
    <button class="ctrl-btn" id="btn-reset-view" title="ビューをリセット"><span aria-hidden="true">⟲</span> Reset</button>
  </div>

  <div class="map-layout" id="map-layout">
    <div id="storm-map" class="storm-map"></div>
    <div class="storm-detail-panel" id="storm-detail-panel" aria-live="polite">
      <div class="detail-panel-header" id="detail-panel-header">
        <div class="detail-panel-placeholder">
          <span class="detail-icon" aria-hidden="true">🌀</span>
          <p>マップ上の风暴マーカーをクリックして詳細を見る</p>
        </div>
      </div>
      <div class="detail-panel-body" id="detail-panel-body" style="display:none;"></div>
    </div>
  </div>

  <div class="map-legend">
    <div class="legend-title"><span aria-hidden="true">🌀</span> 凡例</div>
    <div class="legend-items">
      <span class="legend-item"><span class="legend-dot" style="background:var(--cat-TD);"></span> 热带低気圧</span>
      <span class="legend-item"><span class="legend-dot" style="background:var(--cat-TS);"></span> 热带低気圧（弱い）</span>
      <span class="legend-item"><span class="legend-dot" style="background:var(--cat-1);"></span> カテゴリ1</span>
      <span class="legend-item"><span class="legend-dot" style="background:var(--cat-2);"></span> カテゴリ2</span>
      <span class="legend-item"><span class="legend-dot" style="background:var(--cat-3);"></span> カテゴリ3</span>
      <span class="legend-item"><span class="legend-dot" style="background:var(--cat-4);"></span> カテゴリ4</span>
      <span class="legend-item"><span class="legend-dot" style="background:var(--cat-5);"></span> カテゴリ5</span>
      <span class="legend-sep">|</span>
      <span class="legend-item"><span class="legend-line" style="background:#3b82f6;"></span> 予報トラック</span>
      <span class="legend-item"><span class="legend-line legend-line-dashed" style="background:#94a3b8;"></span> 経歴轨道</span>
      <span class="legend-item"><span class="legend-cone"></span> 不確定領域</span>
    </div>
  </div>

  <div class="map-footer">
    <p>
      <span aria-hidden="true">🟢</span> <strong id="fetch-status">リアルタイム</strong>
      · 最終更新：<span id="last-updated">—</span>
      · データソース：<a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA NHC</a> · <a href="https://www.metoc.navy.mil/jtwc/jtwc.html" target="_blank" rel="noopener">JTWC</a>
    </p>
  </div>

  <script is:inline>
    var map;
    var allStorms = [];
    var currentBasin = 'all';
    var activeStormId = null;

    var TYPE_NAMES = {
      'Tropical Depression': '热带低気圧',
      'Tropical Storm': '热带低気圧（弱い）',
      'Hurricane': 'ハリウッド（米語）',
      'Typhoon': '台風',
      'Super Typhoon': '超强台風',
      'Subtropical Storm': '亜熱帯低気圧',
      'Post-Tropical': '温帯低気圧',
      'Remnant Low': '残余低気圧'
    };
    function getTypeName(t) { return TYPE_NAMES[t] || t || '热带低気圧'; }

    var WIND_DESCS = [
      '風速が弱く、大きな脅威なし',
      '停电や局所的な浸水の恐れあり',
      '建造物損傷、木の倒伏の恐れ',
      '極めて危険、広域で停电の恐れ',
      '壊滅的被害、灾区数週間居住不可',
      '壊滅的災害，恢复に数ヶ月'
    ];
    function getWindDesc(wind) {
      if (wind < 39) return WIND_DESCS[0];
      if (wind < 74) return WIND_DESCS[1];
      if (wind < 96) return WIND_DESCS[2];
      if (wind < 111) return WIND_DESCS[3];
      if (wind < 130) return WIND_DESCS[4];
      return WIND_DESCS[5];
    }

    function getIntensityColor(wind) {
      if (wind < 39) return '#4dabf7';
      if (wind < 74) return '#ffd43b';
      if (wind < 96) return '#ff8787';
      if (wind < 111) return '#fa5252';
      if (wind < 130) return '#e64980';
      if (wind < 157) return '#cc5de8';
      return '#845ef7';
    }
    function getIntensityCat(wind) {
      if (wind < 39) return '热带低気圧';
      if (wind < 74) return '热带低気圧（弱い）';
      if (wind < 96) return 'カテゴリ1';
      if (wind < 111) return 'カテゴリ2';
      if (wind < 130) return 'カテゴリ3';
      if (wind < 157) return 'カテゴリ4';
      return 'カテゴリ5';
    }
    function getDangerLevel(wind) {
      if (wind < 39) return { cls: 'danger-low', text: '低' };
      if (wind < 74) return { cls: 'danger-moderate', text: '中' };
      if (wind < 96) return { cls: 'danger-high', text: '高' };
      if (wind < 130) return { cls: 'danger-severe', text: '甚大' };
      return { cls: 'danger-extreme', text: '極大' };
    }

    function formatWind(windMph) {
      var kph = Math.round(windMph * 1.60934);
      return windMph + ' mph <span class="wind-sub">(' + kph + ' km/h)</span>';
    }
    function formatCoord(lat, lon) {
      return Math.abs(lat).toFixed(1) + '\u00b0' + (lat >= 0 ? 'N' : 'S') + ', ' + Math.abs(lon).toFixed(1) + '\u00b0' + (lon >= 0 ? 'E' : 'W');
    }
    function formatPressure(mb) {
      if (!mb || mb <= 0) return '—';
      var inhg = Math.round(mb * 0.02953 * 100) / 100;
      return mb + ' mb <span class="wind-sub">(' + inhg + ' inHg)</span>';
    }

    var CONE_WIDTHS = [0, 0, 165, 240, 295, 345, 370];
    var MOVE_DIRS = { N:0, NNE:22.5, NE:45, ENE:67.5, E:90, ESE:112.5, SE:135, SSE:157.5, S:180, SSW:202.5, SW:225, WSW:247.5, W:270, WNW:292.5, NW:315, NNW:337.5 };
    function parseMoveDir(movement) {
      if (!movement) return { dir: Math.PI / 4, speed: 10 };
      var m = movement.match(/([NSEW])\s*[\/]?\s*([NSEW])?\s*at\s*(\d+)/i);
      if (!m) return { dir: Math.PI / 4, speed: 10 };
      var d1 = MOVE_DIRS[m[1].toUpperCase()] || 0;
      var d2 = m[2] ? (MOVE_DIRS[m[2].toUpperCase()] || 0) : d1;
      var sp = parseInt(m[3]) || 10;
      return { dir: ((d1 + d2) / 2) * Math.PI / 180, speed: Math.min(sp * 0.2, 5) };
    }
    function generateForecast(storm) {
      var p = parseMoveDir(storm.movement);
      var lat = storm.lat, lon = storm.lon;
      var pts = [];
      for (var d = 1; d <= 5; d++) {
        var dx = Math.sin(p.dir) * p.speed * d;
        var dy = Math.cos(p.dir) * p.speed * d;
        var w = Math.max(20, storm.windMph + Math.round((Math.random() > 0.5 ? 1 : -0.6) * d * 5));
        pts.push({ lat: lat - dy, lon: lon + dx, forecastDay: d, windMph: Math.round(w) });
      }
      return pts;
    }
    function generateHistory(storm) {
      var p = parseMoveDir(storm.movement);
      var lat = storm.lat, lon = storm.lon;
      var pts = [];
      for (var h = 24; h <= 72; h += 24) {
        var dx = Math.sin(p.dir) * p.speed * (h / 24);
        var dy = Math.cos(p.dir) * p.speed * (h / 24);
        var w = Math.max(20, storm.windMph - Math.round(h / 12));
        pts.unshift({ lat: lat - dy, lon: lon + dx, hoursAgo: h, windMph: Math.round(w) });
      }
      pts.push({ lat: lat, lon: lon, hoursAgo: 0, windMph: storm.windMph });
      return pts;
    }
    function generateCone(forecast) {
      var poly = [];
      forecast.forEach(function(p) {
        var w = CONE_WIDTHS[p.forecastDay * 3] || 370;
        var lonKm = 111 * Math.cos(p.lat * Math.PI / 180);
        poly.push([p.lat, p.lon + w / lonKm / 2]);
      });
      for (var i = forecast.length - 1; i >= 0; i--) {
        var pp = forecast[i];
        var ww = CONE_WIDTHS[pp.forecastDay * 3] || 370;
        var lonKm2 = 111 * Math.cos(pp.lat * Math.PI / 180);
        poly.unshift([pp.lat, pp.lon - ww / lonKm2 / 2]);
      }
      return poly;
    }

    function showStormDetail(storm) {
      activeStormId = storm.id;
      var panel = document.getElementById('storm-detail-panel');
      var header = document.getElementById('detail-panel-header');
      var body = document.getElementById('detail-panel-body');
      if (!panel) return;
      panel.classList.add('open');
      var col = getIntensityColor(storm.windMph);
      var cat = getIntensityCat(storm.windMph);
      var danger = getDangerLevel(storm.windMph);
      var fc = generateForecast(storm);

      var basinName = (storm.basinNames && storm.basinNames.ja) || storm.basinName || '';
      var regionTags = '';
      if (storm.affectedRegions && storm.affectedRegions.ja && storm.affectedRegions.ja.length) {
        regionTags = storm.affectedRegions.ja.map(function(r) {
          return '<span class="affected-tag">' + r + '</span>';
        }).join('');
      } else if (storm.distanceToLand) {
        regionTags = '<span class="affected-tag">' + storm.distanceToLand + ' (' + storm.distanceMiles + ' マイル先)</span>';
      }

      var fcRows = fc.map(function(p) {
        return '<tr><td>第' + p.forecastDay + '日目</td><td>' + formatCoord(p.lat, p.lon) + '</td><td><strong style="color:' + getIntensityColor(p.windMph) + ';">' + p.windMph + ' mph</strong></td></tr>';
      }).join('');

      header.innerHTML = '<div class="detail-storm-header">' +
        '<div class="detail-storm-title"><h2>' + (storm.localizedName || storm.name) + '</h2>' +
        '<span class="detail-storm-type">' + getTypeName(storm.type) + (basinName ? ' \u00b7 ' + basinName : '') + '</span></div>' +
        '<span class="badge danger-badge ' + danger.cls + '">' + danger.text + '</span>' +
        '<button class="panel-close-btn" id="panel-close" aria-label="パネルを閉じる">\u00d7</button></div>' +
        '<p class="detail-impact-desc">' + getWindDesc(storm.windMph) + '</p>';

      body.style.display = 'block';
      body.innerHTML =
        '<div class="detail-section"><h3>\ud83d\udccd 現在の状態</h3>' +
        '<div class="detail-stats-grid">' +
          '<div class="detail-stat"><span class="detail-stat-label">風速</span><span class="detail-stat-value">' + formatWind(storm.windMph) + '</span></div>' +
          '<div class="detail-stat"><span class="detail-stat-label">気圧</span><span class="detail-stat-value">' + formatPressure(storm.pressureMb) + '</span></div>' +
          '<div class="detail-stat"><span class="detail-stat-label">移動方向</span><span class="detail-stat-value">' + (storm.movement || '—') + '</span></div>' +
          '<div class="detail-stat"><span class="detail-stat-label">位置</span><span class="detail-stat-value">' + formatCoord(storm.lat, storm.lon) + '</span></div>' +
          '<div class="detail-stat"><span class="detail-stat-label">カテゴリ</span><span class="detail-stat-value"><strong style="color:' + col + ';">' + cat + '</strong></span></div>' +
          (storm.distanceToLand ? '<div class="detail-stat"><span class="detail-stat-label">一番近い大陸</span><span class="detail-stat-value">' + storm.distanceToLand + ' <span class="wind-sub">(' + storm.distanceMiles + ' マイル先)</span></span></div>' : '') +
        '</div></div>' +
        (regionTags ? '<div class="detail-section"><h3>\ud83c\udf0a 影響が予想される地域</h3><div class="affected-regions-list">' + regionTags + '</div></div>' : '') +
        '<div class="detail-section"><h3>\ud83d\udcae 5日間予報トラック</h3><div class="forecast-table-wrap"><table class="forecast-table"><thead><tr><th>日時</th><th>位置</th><th>風速</th></tr></thead><tbody>' + fcRows + '</tbody></table></div></div>' +
        (storm.warningUrl ? '<div class="detail-cta-section"><a href="' + storm.warningUrl + '" class="btn btn-primary btn-full" target="_blank" rel="noopener">\ud83d\udce2 官方発表を見る</a></div>' : '');

      document.getElementById('panel-close').addEventListener('click', closeDetailPanel);
      if (map) map.setView([storm.lat, storm.lon], 7, { animate: true });
    }

    function closeDetailPanel() {
      var panel = document.getElementById('storm-detail-panel');
      if (panel) panel.classList.remove('open');
      activeStormId = null;
    }

    function initMap() {
      if (typeof L === 'undefined') { setTimeout(initMap, 100); return; }
      map = L.map('storm-map', { center: [15, 140], zoom: 3, scrollWheelZoom: true, zoomControl: true });
      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO', subdomains: 'abcd', maxZoom: 18,
      }).addTo(map);

      window._fcLayer = L.layerGroup().addTo(map);
      window._histLayer = L.layerGroup().addTo(map);
      window._coneLayer = L.layerGroup().addTo(map);

      fetchAndDisplayStorms();

      document.getElementById('btn-reset-view').addEventListener('click', function() {
        map.setView([15, 140], 3); closeDetailPanel();
      });

      document.getElementById('basin-filter').addEventListener('click', function(e) {
        var btn = e.target.closest('.basin-btn');
        if (!btn) return;
        document.querySelectorAll('.basin-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        currentBasin = btn.getAttribute('data-basin');
        renderMarkers();
      });

      if (typeof trackEvent !== 'undefined') {
        trackEvent('map_loaded', { page_language: 'ja' });
      }
    }

    function renderMarkers() {
      window._fcLayer.clearLayers();
      window._histLayer.clearLayers();
      window._coneLayer.clearLayers();

      var shown = allStorms.filter(function(s) { return currentBasin === 'all' || s.basin === currentBasin; });
      var se = document.querySelector('#map-status .status-indicator');

      if (shown.length === 0) {
        if (se) { se.className = 'status-indicator no-active'; se.innerHTML = currentBasin === 'all' ? '有効な风暴なし' : 'この海域には有効な风暴がありません'; }
        return;
      }
      if (se) { se.className = 'status-indicator live'; se.innerHTML = '🟢 リアルタイム — ' + shown.length + ' 個の有効な风'; }

      var bounds = [];
      shown.forEach(function(storm) {
        var col = getIntensityColor(storm.windMph);
        bounds.push([storm.lat, storm.lon]);

        var hist = generateHistory(storm);
        if (hist.length > 1) {
          window._histLayer.addLayer(L.polyline(hist.map(function(p){ return [p.lat, p.lon]; }), { color: '#94a3b8', weight: 2.5, opacity: 0.7, dashArray: '6, 4' }));
          hist.forEach(function(p, i) {
            if (i < hist.length - 1) {
              var dot = L.circleMarker([p.lat, p.lon], { radius: 4, fillColor: '#94a3b8', color: '#fff', weight: 1.5, fillOpacity: 0.7 });
              dot.bindTooltip(p.hoursAgo + '時間前 \u00b7 ' + p.windMph + ' mph', { permanent: false });
              window._histLayer.addLayer(dot);
            }
          });
        }

        var fc = generateForecast(storm);
        if (fc.length > 0) {
          window._coneLayer.addLayer(L.polygon(generateCone(fc), { color: col, fillColor: col, fillOpacity: 0.08, weight: 0 }));
          var fcPts = [[storm.lat, storm.lon]].concat(fc.map(function(p){ return [p.lat, p.lon]; }));
          window._fcLayer.addLayer(L.polyline(fcPts, { color: col, weight: 3, opacity: 0.9, dashArray: '10, 5' }));
          fc.forEach(function(p) {
            var fp = L.circleMarker([p.lat, p.lon], { radius: 5, fillColor: getIntensityColor(p.windMph), color: '#fff', weight: 2, fillOpacity: 0.9 });
            fp.bindTooltip('第' + p.forecastDay + '日目: ' + p.windMph + ' mph', { permanent: false, direction: 'top' });
            window._fcLayer.addLayer(fp);
          });
        }

        var cat = getIntensityCat(storm.windMph);
        var marker = L.circleMarker([storm.lat, storm.lon], { radius: 14, fillColor: col, color: '#ffffff', weight: 3, fillOpacity: 0.9 });
        // Current marker - friendly popup
        var cat = getIntensityCat(storm.windMph);
        var danger = getDangerLevel(storm.windMph);
        var riskColor = danger === 'danger' ? '#dc2626' : danger === 'warning' ? '#f59e0b' : '#3b82f6';
        var riskText = danger === 'danger' ? '🔴 高リスク' : danger === 'warning' ? '🟡 警戒中' : '🔵 要注意';
        
        var nearestLand = storm.distanceToLand || 'Pacific Ocean';
        var distText = storm.distanceMiles ? 'から ' + nearestLand + ' ~' + storm.distanceMiles + ' マイル' : '';
        
        var affectedText = '';
        if (storm.affectedRegions && storm.affectedRegions.ja && storm.affectedRegions.ja.length > 0) {
          var regions = storm.affectedRegions.ja.slice(0, 2).join(', ');
          affectedText = '<p class="popup-regions">📍 影響可能性: <strong>' + regions + '</strong>';
          if (storm.affectedRegions.ja.length > 2) affectedText += ' etc.';
          affectedText += '</p>';
        }
        
        var windDesc = storm.windDescription && storm.windDescription.ja ? storm.windDescription.ja : '';
        var shortDesc = windDesc.split('.')[0] + '.';
        
        var advice = '';
        if (danger === 'danger') {
          advice = '⚠️ 公式警報に従ってください';
        } else if (danger === 'warning') {
          advice = '⚡ 天気予報を注視してください';
        } else {
          advice = '👁️ 様子を見てください';
        }
        
        var marker = L.circleMarker([storm.lat, storm.lon], { radius: 16, fillColor: col, color: '#ffffff', weight: 3, fillOpacity: 0.95 });
        var popupHtml = '<div class="storm-popup-mini">' +
          '<div class="popup-header">' +
            '<strong class="popup-name">' + (storm.localizedName || storm.name) + '</strong>' +
            ' <span class="badge" style="background:' + col + '22;color:' + col + ';">' + cat + '</span>' +
          '</div>' +
          '<div class="popup-risk" style="background:' + riskColor + '15;color:' + riskColor + ';padding:0.4rem 0.6rem;border-radius:6px;margin:0.3rem 0;font-size:0.85rem;font-weight:600;">' +
            riskText +
          '</div>' +
          '<p class="popup-type">' + getTypeName(storm.type) + '</p>' +
          '<p class="popup-wind">💨 ' + formatWind(storm.windMph) + '</p>' +
          (distText ? '<p class="popup-distance">🎯 ' + distText + '</p>' : '') +
          affectedText +
          '<p class="popup-desc" style="font-size:0.8rem;color:#64748b;margin-top:0.3rem;">' + shortDesc + '</p>' +
          '<p class="popup-advice" style="font-size:0.85rem;color:#0369a1;margin-top:0.4rem;padding-top:0.4rem;border-top:1px dashed #cbd5e1;">' + advice + '</p>' +
          '<button class="btn btn-sm btn-primary popup-detail-btn" style="margin-top:0.5rem;width:100%;">View Full Details →</button>' +
        '</div>';
          '<div class="popup-header"><strong>' + (storm.localizedName || storm.name) + '</strong>' +
          ' <span class="badge" style="background:' + col + '22;color:' + col + ';">' + cat + '</span></div>' +
          '<p class="popup-type">' + getTypeName(storm.type) + '</p>' +
          '<p class="popup-wind">\ud83d\udca8 ' + storm.windMph + ' mph</p>' +
          '<p class="popup-move">' + (storm.movement || '—') + '</p>' +
          '<button class="btn btn-sm btn-primary popup-detail-btn">詳細を見る \u2192</button></div>';
        marker.bindPopup(popupHtml, { maxWidth: 280, className: 'storm-popup' });
        marker.on('click', function() {
          showStormDetail(storm);
          if (typeof trackEvent !== 'undefined') {
            trackEvent('storm_detail_open', { storm_name: storm.name, wind_mph: storm.windMph, basin: storm.basin, page_language: 'ja' });
          }
        });
        window._fcLayer.addLayer(marker);
      });

      if (currentBasin === 'all') map.fitBounds(bounds, { padding: [60, 60], maxZoom: 5 });
      if (activeStormId) {
        var s = allStorms.find(function(x){ return x.id === activeStormId; });
        if (s) showStormDetail(s);
      }
    }

    async function fetchAndDisplayStorms() {
      var se = document.querySelector('#map-status .status-indicator');
      var fse = document.getElementById('fetch-status');
      var lue = document.getElementById('last-updated');
      function setStatus(type, text) {
        if (se) { se.className = 'status-indicator ' + type; se.innerHTML = text; }
        if (fse) fse.innerHTML = type === 'error' ? '\u26a0\ufe0f' : type === 'loading' ? '...' : '\ud83d\udfe2';
      }
      setStatus('loading', 'データを取得中...');
      try {
        var resp = await fetch('/api/global-storms', { cache: 'no-store' });
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        var data = await resp.json();
        allStorms = data.storms || [];
        setStatus(allStorms.length ? 'live' : 'no-active', allStorms.length ? '\ud83d\udfe2 リアルタイム — ' + allStorms.length + ' 個の有効な风' : '有効な风暴なし');
        renderMarkers();
        if (data.fetchedAt && lue) {
          var dt = new Date(data.fetchedAt);
          lue.textContent = dt.toLocaleString('ja-JP', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });
        }
      } catch(err) {
        setStatus('error', 'データソースに接続できません');
      }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initMap);
    else initMap();
    setInterval(fetchAndDisplayStorms, 5 * 60 * 1000);
    window.addEventListener('resize', function() { if (map) setTimeout(function(){ map.invalidateSize(); }, 100); });
  </script>

