---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/dict';
import { historicalStorms, seasonStats } from '../data/historical';
// 构建时全球数据（prebuild 钩子写入，Zod 校验）
// 若 fetchGlobal.mjs 失败且无缓存，_fallback=true 且风暴数组为空
import activeData from '../data/active.json';
import { getCategory } from '../data/noaa';

const lang = 'en';

// 从构建时 active.json 读取数据
const { source, fetchedAt, activeStorms, storms: liveStorms, _fallback } = activeData;
const buildTime = new Date(fetchedAt).toLocaleString('en-US', {
  month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short',
});

// 历史重大风暴（用于推荐展示，优先最大损失/最高等级）
const notableStorms = [...historicalStorms]
  .filter(s => s.year < 2026)
  .sort((a, b) => (parseInt(b.damage.replace(/[^\d]/g, '')) || 0) - (parseInt(a.damage.replace(/[^\d]/g, '')) || 0))
  .slice(0, 6);

const categoryColors: Record<string, string> = {
  TD: '#4dabf7', TS: '#ffd43b', 'Cat-1': '#ff8787', 'Cat-2': '#fa5252',
  'Cat-3': '#e64980', 'Cat-4': '#cc5de8', 'Cat-5': '#845ef7',
};

const year = new Date().getFullYear();
const activeCount = activeStorms ?? 0;
---

<BaseLayout
  title="Home"
  description="Track tropical storms, hurricanes, and cyclones worldwide in real-time. Official NOAA NHC & JTWC data, interactive maps, and historical storm database."
  lang={lang}
>
  <!-- 数据来源 & 更新状态横幅 -->
  {(_fallback) && (
    <div class="warning-banner">
      ⚠️ Data update delayed — showing cached data. Last successful fetch: {buildTime}. Please refresh shortly.
    </div>
  )}

  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <div class="active-badge" id="hero-badge">
        {activeCount > 0 ? (
          <span class="badge badge-active">🌪️ {activeCount} Active</span>
        ) : (
          <span class="badge badge-safe"><span aria-hidden="true">☀️</span> No Active Storms</span>
        )}
      </div>
      <h1 class="hero-title">{t('hero.title', lang)}</h1>
      <p class="hero-desc">
        {t('hero.description', lang)}
        <br />
        <span class="data-source">Data sources: <strong>NOAA NHC (North America) · JMA (Japan) · JTWC (Global)</strong></span>
      </p>
      <div class="hero-ctas">
        <a href="/alerts" class="btn btn-primary" onclick="trackEvent('hero_cta_click', {button: 'get_alerts', page_section: 'hero', language: 'en', ab_variant: 'control'})">{t('hero.getAlerts', lang)}</a>
        <a href="/map" class="btn btn-outline btn-light" onclick="trackEvent('hero_cta_click', {button: 'view_map', page_section: 'hero', language: 'en'})">{t('hero.viewMap', lang)}</a>
      </div>
      <p class="hero-source">
        <span class="source-dot"></span>
        Source: <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA NHC</a> &amp; <a href="https://www.metoc.navy.mil/jtwc/jtwc.html" target="_blank" rel="noopener">JTWC</a>
        · Updated {buildTime}
      </p>
    </div>
  </section>

  <!-- Active Storms -->
  {activeCount > 0 ? (
    <section class="section">
      <div class="section-header">
        <h2 class="section-title"><span aria-hidden="true">⚡</span> Active Storms</h2>
        <span class="live-dot">🟢 Live</span>
      </div>
      <div class="grid grid-2">
        {liveStorms.map((storm: any) => {
          const intensity = getCategory(storm.windMph);
          return (
            <a href="/map" class="card storm-card">
              <div class="storm-card-header">
                <div>
                  <h3>{storm.name}{storm.designation ? ` (${storm.designation})` : ''}</h3>
                  <span class="storm-type">{storm.type}</span>
                  <span class="storm-source">{storm.agency || storm.source} · {storm.basinName}</span>
                </div>
                <span class="badge" style={`background: ${categoryColors[intensity] || '#e2e8f0'}33; color: ${categoryColors[intensity] || '#64748b'};`}>{intensity}</span>
              </div>
              <div class="storm-card-stats">
                <div class="stat"><span class="stat-label">Wind</span><span class="stat-value">{storm.windMph} mph</span></div>
                <div class="stat"><span class="stat-label">Pressure</span><span class="stat-value">{storm.pressureMb > 0 ? `${storm.pressureMb} mb` : '—'}</span></div>
                <div class="stat"><span class="stat-label">Location</span><span class="stat-value">{Math.abs(storm.lat).toFixed(1)}°{storm.lat>=0?'N':'S'}, {Math.abs(storm.lon).toFixed(1)}°{storm.lon>=0?'E':'W'}</span></div>
                <div class="stat"><span class="stat-label">Movement</span><span class="stat-value">{storm.movement}</span></div>
              </div>
              <div class="storm-card-footer">
                <span class="view-details"><span aria-hidden="true">→</span> View on Map</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  ) : (
    <!-- Non-Storm Season / No Active -->
    <section class="section">
      <div class="section-header">
        <h2 class="section-title"><span aria-hidden="true">⚡</span> Active Storms</h2>
      </div>
      <div class="no-active-card">
        <div class="no-active-icon" aria-hidden="true">☀️</div>
        <h3>No Active Tropical Storms</h3>
        <p>
          Good news — all monitored ocean basins are currently quiet. Tropical cyclone seasons vary by region:
          the Atlantic &amp; East Pacific peak <strong>June 1 – November 30</strong>, while the Northwest Pacific
          stays active nearly year-round.
        </p>
        <div class="no-active-ctas">
          <a href="/storms" class="btn btn-outline">📊 Browse Historical Storms</a>
          <a href="/preparedness" class="btn btn-primary"><span aria-hidden="true">🛡️</span> Preparedness Guide</a>
        </div>
        <p class="hero-source">
          <span class="source-dot"></span>
          Last checked: {buildTime} · Source: <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA NHC</a> &amp; <a href="https://www.metoc.navy.mil/jtwc/jtwc.html" target="_blank" rel="noopener">JTWC</a>
        </p>
      </div>
    </section>
  )}

  <!-- Season Outlook -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title"><span aria-hidden="true">📊</span> {year} Season Outlook</h2>
      <a href="/storms" class="see-all">Full Database →</a>
    </div>
    <div class="season-card">
      <div class="season-header">
        <div class="season-badge">
          <span class="badge badge-safe">Below Normal</span>
          <span class="season-note">El Niño developing — increases wind shear at peak season</span>
        </div>
        <p class="season-dates">Season: June 1 – November 30 · Peak: September 10</p>
      </div>
      <div class="season-stats">
        {seasonStats.slice(-1)[0] && (() => {
          const latest = seasonStats[seasonStats.length - 1];
          return (
            <>
              <div class="season-stat">
                <span class="season-num">{latest.namedStorms || '8–14'}</span>
                <span class="season-label">Named Storms</span>
                <span class="season-avg">avg: 14.4</span>
              </div>
              <div class="season-stat">
                <span class="season-num">{latest.hurricanes || '3–6'}</span>
                <span class="season-label">Hurricanes</span>
                <span class="season-avg">avg: 7.2</span>
              </div>
              <div class="season-stat">
                <span class="season-num">{latest.majorHurricanes || '1–2'}</span>
                <span class="season-label">Major Hurricanes</span>
                <span class="season-avg">avg: 3.2</span>
              </div>
              <div class="season-stat">
                <span class="season-num">{latest.ace || '~50'}</span>
                <span class="season-label">ACE Index</span>
                <span class="season-avg">avg: 123</span>
              </div>
            </>
          );
        })()}
      </div>
    </div>
  </section>

  <!-- Region Selector -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">🌏 Which Region Are You In?</h2>
    </div>
    <p class="region-intro">Select your region to see storm activity and alert services for your area. Global coverage across 8 basins, multilingual support.</p>
    
    <div class="region-grid">
      <!-- Asia -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌏</span>
          <h3>Asia</h3>
        </div>
        <div class="region-content">
          <p class="region-desc">Northwest Pacific (Typhoons) + North Indian Ocean (Cyclones)</p>
          <div class="region-details">
            <p><strong>Coverage:</strong> Japan, Philippines, coastal China, Vietnam, India, Bangladesh</p>
            <p><strong>Storm Season:</strong> Year-round (peak Jul-Oct)</p>
            <p><strong>Data Sources:</strong> JMA, JTWC, IMD</p>
            <p><strong>Languages:</strong> Japanese · Chinese · English</p>
          </div>
          <a href="/map" class="btn btn-outline btn-sm">View Asia Storm Map</a>
        </div>
      </div>
      
      <!-- North America -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌎</span>
          <h3>North America</h3>
        </div>
        <div class="region-content">
          <p class="region-desc">North Atlantic + Eastern Pacific + Central Pacific (Hurricanes)</p>
          <div class="region-details">
            <p><strong>Coverage:</strong> US (Florida, Texas, Hawaii), Canada, Mexico</p>
            <p><strong>Storm Season:</strong> Jun 1 - Nov 30 (peak Sep)</p>
            <p><strong>Data Sources:</strong> NOAA NHC</p>
            <p><strong>Languages:</strong> English · Chinese · French · Japanese</p>
          </div>
          <a href="/alerts" class="btn btn-primary btn-sm">Set Up Free Alerts</a>
        </div>
      </div>
      
      <!-- Oceania -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌏</span>
          <h3>Oceania</h3>
        </div>
        <div class="region-content">
          <p class="region-desc">Australian Region + South Pacific (Cyclones)</p>
          <div class="region-details">
            <p><strong>Coverage:</strong> Australia (Queensland, Northern Territory), Fiji, New Caledonia</p>
            <p><strong>Storm Season:</strong> Nov - Apr (Southern Hemisphere summer)</p>
            <p><strong>Data Sources:</strong> BOM, FMS</p>
          </div>
          <a href="/map" class="btn btn-outline btn-sm">View Oceania Storm Map</a>
        </div>
      </div>
      
      <!-- Latin America -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌎</span>
          <h3>Latin America</h3>
        </div>
        <div class="region-content">
          <p class="region-desc">Caribbean + Central America + Mexico (Hurricanes)</p>
          <div class="region-details">
            <p><strong>Coverage:</strong> Cuba, Haiti, Dominican Republic, Puerto Rico, Mexico, Central America</p>
            <p><strong>Storm Season:</strong> May 15 - Nov 30</p>
            <p><strong>Data Sources:</strong> NOAA NHC</p>
            <p><strong>Languages:</strong> English · Chinese (Spanish Coming Soon)</p>
          </div>
          <a href="/map" class="btn btn-outline btn-sm">View Caribbean Storm Map</a>
        </div>
      </div>
      
      <!-- Africa -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌍</span>
          <h3>Africa</h3>
        </div>
        <div class="region-content">
          <p class="region-desc">South Indian Ocean + West African Coast (Cyclones/Tropical Storms)</p>
          <div class="region-details">
            <p><strong>Coverage:</strong> Madagascar, Mozambique, Tanzania, Kenya</p>
            <p><strong>Storm Season:</strong> Nov - Apr (South Indian Ocean)</p>
            <p><strong>Data Sources:</strong> Météo-France, JTWC</p>
          </div>
          <a href="/map" class="btn btn-outline btn-sm">View Africa Storm Map</a>
        </div>
      </div>
      
      <!-- Europe -->
      <div class="region-card">
        <div class="region-header">
          <span class="region-icon">🌍</span>
          <h3>Europe</h3>
        </div>
        <div class="region-content">
          <p class="region-desc">French Overseas Territories + Global Travelers</p>
          <div class="region-details">
            <p><strong>Coverage:</strong> Réunion, Mayotte, vacation travelers</p>
            <p><strong>Storm Season:</strong> Nov - Apr (South Indian Ocean)</p>
            <p><strong>Data Sources:</strong> Météo-France, NOAA, JTWC</p>
            <p><strong>Languages:</strong> French · English</p>
          </div>
          <a href="/fr/" class="btn btn-outline btn-sm">View French Version</a>
        </div>
      </div>
    </div>
  </section>

  <!-- What Can StormTracker Do For You? -->
  <section class="section scenario-section">
    <div class="section-header">
      <h2 class="section-title">💡 What Can StormTracker Do For You?</h2>
    </div>
    <p class="scenario-intro">StormTracker is built for real people facing real storms — not scientists or government agencies.</p>
    <div class="region-grid">
      <div class="region-card scenario-card">
        <div class="scenario-icon">🏠</div>
        <h3>Coastal Residents</h3>
        <p>Know <strong>hours before</strong> a storm hits your neighborhood — not minutes. Set free email alerts for your exact ZIP code and evacuate safely.</p>
        <a href="/alerts" class="btn btn-primary btn-sm">Set Free Alerts</a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">🚢</div>
        <h3>Seafarers & Fishermen</h3>
        <p>Plan routes around active typhoons. The live global map shows every storm's exact position and projected path across 8 ocean basins.</p>
        <a href="/map" class="btn btn-outline btn-sm">View Live Map</a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">🏨</div>
        <h3>Property Owners & Hosts</h3>
        <p>Protect your investment. Historical storm data shows which areas have the highest risk — critical for buying, insuring, or managing coastal property.</p>
        <a href="/storms" class="btn btn-outline btn-sm">Explore Historical Data</a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">🚑</div>
        <h3>Emergency Responders</h3>
        <p>Get real-time updates for pre-positioning resources and coordinating evacuations. Multiple language support for teams serving diverse communities.</p>
        <a href="/zh/map" class="btn btn-outline btn-sm">Use in Your Language</a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">📊</div>
        <h3>Insurers & Analysts</h3>
        <p>Make data-driven risk assessments with 17+ years of ACE index trends, landfall history, and damage cost comparisons across 18 major storms.</p>
        <a href="/storms" class="btn btn-outline btn-sm">View Storm Database</a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">📺</div>
        <h3>Media Professionals</h3>
        <p>Embed live storm maps, download historical track data, and access shareable infographics — everything you need for accurate storm coverage.</p>
        <a href="/about" class="btn btn-outline btn-sm">Learn More</a>
      </div>
      <div class="region-card scenario-card">
        <div class="scenario-icon">✈️</div>
        <h3>Travelers & Cruisers</h3>
        <p>Check storm risk before booking trips or routes through hurricane-prone regions. Know if your destination is safe before you pack your bags.</p>
        <a href="/map" class="btn btn-outline btn-sm">Check Current Conditions</a>
      </div>
    </div>
  </section>

  <!-- Notable Historical Storms -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">📈 Notable Historical Storms</h2>
      <a href="/storms" class="see-all">Full Database →</a>
    </div>
    <div class="grid grid-3">
      {notableStorms.map((storm) => (
        <a href={`/storms/${storm.name.toLowerCase()}`} class="card storm-list-card hist-card">
          <div class="storm-list-header">
            <h3>{storm.name}</h3>
            <span class="badge" style={`background: ${categoryColors[storm.category] || '#e2e8f0'}33; color: ${categoryColors[storm.category] || '#64748b'};`}>{storm.category}</span>
          </div>
          <div class="storm-list-stats">
            <span><span aria-hidden="true">📅</span> {storm.year} — {storm.formed}</span>
            <span>💨 {storm.maxWind} mph · 📊 {storm.minPressure} mb</span>
            <span>📍 {storm.landfall}</span>
            <span>💰 {storm.damage} · ⚠️ {storm.fatalities} deaths</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Preparedness CTA -->
  <section class="section cta-section">
    <div class="cta-card">
      <h2><span aria-hidden="true">🛡️</span> Storm Preparedness</h2>
      <p>Know what to do before, during, and after a tropical storm. Get checklists, evacuation plans, and emergency kit guides.</p>
      <a href="/preparedness" class="btn btn-primary">Read Preparedness Guide →</a>
    </div>
  </section>

  <!-- Pricing Teaser -->
  <section class="section">
    <div class="pricing-teaser">
      <div class="teaser-content">
        <h2><span aria-hidden="true">⭐</span> Go Pro for Ultimate Protection</h2>
        <p>SMS alerts, 5 custom regions, 7-day forecast tracks, storm surge maps, and ad-free experience.</p>
        <ul class="teaser-features">
          <li><span aria-hidden="true">📱</span> Instant SMS notifications</li>
          <li><span aria-hidden="true">🎯</span> Up to 5 alert regions</li>
          <li><span aria-hidden="true">🗺️</span> 7-day forecast tracks</li>
          <li><span aria-hidden="true">🌊</span> Storm surge maps</li>
        </ul>
        <div class="teaser-ctas">
          <a href="/pricing" class="btn btn-primary" onclick="trackEvent('pricing_cta_click', {button: 'view_plans', page_section: 'pricing_teaser', language: 'en'})">View Plans →</a>
          <a href="/signup?plan=pro" class="btn btn-outline" onclick="trackEvent('pricing_cta_click', {button: 'free_trial', page_section: 'pricing_teaser', language: 'en', plan: 'pro'})">Start 14-Day Free Trial</a>
        </div>
        <p class="teaser-price">From just <strong>$4.99/month</strong> · Cancel anytime</p>
      </div>
    </div>
  </section>

  <script>
    // 客户端增强：尝试从边缘 API 更新活跃风暴（备用数据）
    async function enhanceActiveStorms() {
      const badge = document.getElementById('hero-badge');
      if (!badge) return;
      try {
        const resp = await fetch('/api/storms');
        if (!resp.ok) return;
        const data = await resp.json();
        if (data.storms && data.storms.length > 0) {
          // 已在构建时处理，跳过客户端覆盖
        }
      } catch (e) {
        // 安静失败，使用构建时数据
      }
    }
    enhanceActiveStorms();
  </script>

  <style>
    /* Warning Banner */
    .warning-banner {
      background: #fef9c3;
      border: 1px solid #fcd34d;
      color: #92400e;
      padding: 0.75rem 1.5rem;
      border-radius: var(--radius);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    /* Hero */
    .hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #0ea5e9 100%);
      border-radius: var(--radius);
      padding: 3rem 2.5rem;
      margin-bottom: 2.5rem;
      color: white;
      position: relative;
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .hero-content { position: relative; z-index: 1; max-width: 720px; }
    .hero-title { font-size: 2.5rem; font-weight: 800; margin: 0.75rem 0 1rem; line-height: 1.2; }
    .hero-desc { font-size: 1.1rem; opacity: 0.85; margin-bottom: 1.5rem; line-height: 1.6; }
    .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .hero-source { font-size: 0.8rem; opacity: 0.7; display: flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem; }
    .hero-source a { color: #93c5fd; }
    .source-dot { width: 6px; height: 6px; background: #34d399; border-radius: 50%; display: inline-block; animation: pulse-dot 2s infinite; }
    @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    .active-badge { margin-bottom: 0.5rem; }
    /* Section */
    .section { margin-bottom: 2.5rem; }
    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .section-title { font-size: 1.75rem; font-weight: 700; margin: 0; }
    .see-all { color: var(--color-primary); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
    .see-all:hover { text-decoration: underline; }
    .live-dot { font-size: 0.8rem; color: var(--color-text-secondary); }
    /* Grid */
    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .hist-card { border-left: 4px solid var(--color-primary); }
    @media (max-width: 1024px) { .grid-3 { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 768px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } .hero { padding: 2rem 1.5rem; } .hero-title { font-size: 1.75rem; } }
    /* Storm Card */
    .storm-card { display: flex; flex-direction: column; gap: 1rem; text-decoration: none; color: inherit; border-top: 4px solid var(--color-primary); }
    .storm-card-header { display: flex; justify-content: space-between; align-items: flex-start; }
    .storm-card-header h3 { font-size: 1.25rem; font-weight: 700; margin: 0; }
    .storm-type { font-size: 0.85rem; color: var(--color-text-secondary); }
    .storm-source { display: block; font-size: 0.75rem; color: var(--color-text-secondary); margin-top: 2px; }
    .storm-card-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    .stat { display: flex; flex-direction: column; gap: 0.15rem; }
    .stat-label { font-size: 0.75rem; color: var(--color-text-secondary); font-weight: 600; }
    .stat-value { font-size: 0.95rem; font-weight: 600; }
    .storm-headline { font-size: 0.85rem; color: var(--color-text-secondary); line-height: 1.5; border-top: 1px solid var(--color-border); padding-top: 0.75rem; }
