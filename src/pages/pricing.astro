---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/dict';

const lang = 'en';
---

<BaseLayout
  title="Pricing"
  description="Free storm alerts and tracking. Upgrade to Pro for SMS alerts, custom regions, 7-day forecasts, and more. From $4.99/month."
  lang={lang}
>
  <section class="pricing-hero">
    <h1>Simple, Transparent Pricing</h1>
    <p>Free forever for basic alerts. Upgrade when you need more.</p>
  </section>

  <!-- Pricing Tiers -->
  <section class="section pricing-section">
    <div class="pricing-grid">
      <!-- Free -->
      <div class="pricing-card">
        <div class="plan-header">
          <h2>Free</h2>
          <p class="plan-tagline">For casual trackers</p>
        </div>
        <div class="plan-price">
          <span class="price-amount">$0</span>
          <span class="price-period">/mo</span>
        </div>
        <a href="/alerts" class="btn btn-outline btn-block">Start Free</a>
        <ul class="plan-features">
          <li><span aria-hidden="true">✅</span> Real-time storm map</li>
          <li><span aria-hidden="true">✅</span> Email alerts (1 region)</li>
          <li><span aria-hidden="true">✅</span> Historical data (5 years)</li>
          <li><span aria-hidden="true">✅</span> Preparedness guides</li>
          <li><span aria-hidden="true">✅</span> Storm detail pages</li>
          <li class="disabled"><span aria-hidden="true">❌</span> SMS / push alerts</li>
          <li class="disabled"><span aria-hidden="true">❌</span> Custom region alerts</li>
          <li class="disabled"><span aria-hidden="true">❌</span> 7-day forecast tracks</li>
          <li class="disabled"><span aria-hidden="true">❌</span> Ad-free experience</li>
        </ul>
      </div>

      <!-- Pro (Highlighted) -->
      <div class="pricing-card pricing-card-popular">
        <div class="popular-badge">⭐ Most Popular</div>
        <div class="plan-header">
          <h2>Pro</h2>
          <p class="plan-tagline">For enthusiasts & coastal residents</p>
        </div>
        <div class="plan-price">
          <span class="price-amount">$4.99</span>
          <span class="price-period">/mo</span>
        </div>
        <a href="/signup?plan=pro" class="btn btn-primary btn-block">Start 14-Day Free Trial</a>
        <ul class="plan-features">
          <li><span aria-hidden="true">✅</span> Everything in Free, plus:</li>
          <li><span aria-hidden="true">📱</span> SMS & push notifications</li>
          <li><span aria-hidden="true">🎯</span> Custom region alerts (up to 5)</li>
          <li><span aria-hidden="true">🗺️</span> 7-day forecast tracks</li>
          <li><span aria-hidden="true">🌊</span> Storm surge inundation maps</li>
          <li><span aria-hidden="true">📧</span> Weekly email digest</li>
          <li><span aria-hidden="true">🚫</span> Ad-free experience</li>
          <li><span aria-hidden="true">⚡</span> Priority data feeds</li>
        </ul>
      </div>

      <!-- Enterprise -->
      <div class="pricing-card">
        <div class="plan-header">
          <h2>Enterprise</h2>
          <p class="plan-tagline">For businesses & agencies</p>
        </div>
        <div class="plan-price">
          <span class="price-amount">Custom</span>
        </div>
        <a href="/contact" class="btn btn-outline btn-block">Contact Sales</a>
        <ul class="plan-features">
          <li><span aria-hidden="true">✅</span> Everything in Pro, plus:</li>
          <li><span aria-hidden="true">🔧</span> API access (1,000 calls/day)</li>
          <li><span aria-hidden="true">👥</span> Team bulk alerts (up to 50)</li>
          <li><span aria-hidden="true">🎨</span> Custom branding & white-label</li>
          <li><span aria-hidden="true">📤</span> Data export (CSV, JSON, GeoJSON)</li>
          <li><span aria-hidden="true">🛡️</span> SLA guarantee (99.9% uptime)</li>
          <li><span aria-hidden="true">💬</span> Dedicated support channel</li>
          <li><span aria-hidden="true">📊</span> Analytics dashboard</li>
        </ul>
      </div>
    </div>
    <p class="pricing-guarantee">
      <span aria-hidden="true">🔒</span> 14-day money-back guarantee. No credit card required to start. Cancel anytime.
    </p>
  </section>

  <!-- Comparison Table -->
  <section class="section">
    <h2 class="section-title"><span aria-hidden="true">📋</span> Full Feature Comparison</h2>
    <div class="comparison-table-wrap">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Feature</th>
            <th>Free</th>
            <th class="pro-col">Pro</th>
            <th>Enterprise</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>Real-time storm map</td><td>✅</td><td class="pro-col">✅</td><td>✅</td></tr>
          <tr><td>Historical storm database</td><td>5 years</td><td class="pro-col">Full archive</td><td>Full archive</td></tr>
          <tr><td>Email alerts</td><td>1 region</td><td class="pro-col">5 regions</td><td>Unlimited</td></tr>
          <tr><td>SMS alerts</td><td>—</td><td class="pro-col">✅</td><td>✅</td></tr>
          <tr><td>Push notifications</td><td>—</td><td class="pro-col">✅</td><td>✅</td></tr>
          <tr><td>7-day forecast tracks</td><td>—</td><td class="pro-col">✅</td><td>✅</td></tr>
          <tr><td>Storm surge maps</td><td>—</td><td class="pro-col">✅</td><td>✅</td></tr>
          <tr><td>Weekly digest email</td><td>—</td><td class="pro-col">✅</td><td>✅</td></tr>
          <tr><td>Ad-free experience</td><td>—</td><td class="pro-col">✅</td><td>✅</td></tr>
          <tr><td>API access</td><td>—</td><td class="pro-col">—</td><td>1,000/day</td></tr>
          <tr><td>Team management</td><td>—</td><td class="pro-col">—</td><td>50 users</td></tr>
          <tr><td>Custom branding</td><td>—</td><td class="pro-col">—</td><td>✅</td></tr>
          <tr><td>Data export</td><td>—</td><td class="pro-col">—</td><td>✅</td></tr>
          <tr><td>SLA guarantee</td><td>—</td><td class="pro-col">—</td><td>99.9%</td></tr>
          <tr><td>Support</td><td>Community</td><td class="pro-col">Priority email</td><td>Dedicated</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <h2 class="section-title"><span aria-hidden="true">❓</span> Frequently Asked Questions</h2>
    <div class="faq-list">
      <details class="faq-item">
        <summary>Is the free plan really free?</summary>
        <p>Yes! The free plan includes real-time storm tracking, email alerts for 1 region, and 5 years of historical data. No credit card required. You can use it forever.</p>
      </details>
      <details class="faq-item">
        <summary>Can I cancel my Pro subscription anytime?</summary>
        <p>Absolutely. Cancel anytime from your account dashboard. You'll keep Pro access until the end of your billing period. We also offer a 14-day money-back guarantee.</p>
      </details>
      <details class="faq-item">
        <summary>What's the difference between email and SMS alerts?</summary>
        <p>Email alerts are free and arrive within minutes of a NOAA update. SMS alerts (Pro feature) are sent instantly via text message, which is critical during fast-moving storms when you may not check email.</p>
      </details>
      <details class="faq-item">
        <summary>Do you support regions outside the Atlantic?</summary>
        <p>Yes! We track all global tropical cyclone basins: Atlantic, Eastern Pacific, Western Pacific (typhoons), Indian Ocean, and Australian region. Pro users can select up to 5 regions for custom alerts.</p>
      </details>
      <details class="faq-item">
        <summary>Can I use the API for my own app?</summary>
        <p>Enterprise subscribers get API access with 1,000 calls per day. The API returns JSON data for active storms, historical data, and forecasts. Contact us for higher volume needs.</p>
      </details>
      <details class="faq-item">
        <summary>Is this an official NOAA product?</summary>
        <p>No. We use publicly available NOAA/NHC data but are not affiliated with NOAA. For official warnings, always refer to <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">nhc.noaa.gov</a> and your local emergency management office.</p>
      </details>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="cta-card">
      <h2>Ready to Get Started?</h2>
      <p>Join 12,000+ people who trust Tropical Storm Tracker for their storm alerts.</p>
      <div class="cta-buttons">
        <a href="/alerts" class="btn btn-outline btn-light">Start Free Alerts</a>
        <a href="/signup?plan=pro" class="btn btn-primary">Try Pro Free for 14 Days</a>
      </div>
    </div>
  </section>

  <style>
    .pricing-hero {
      text-align: center;
      padding: 3rem 1.5rem 2rem;
    }
    .pricing-hero h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem; }
    .pricing-hero p { font-size: 1.15rem; color: var(--color-text-secondary); }

    .pricing-section { max-width: 1100px; margin: 0 auto 2rem; }
    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }
    .pricing-card {
      background: var(--color-surface);
      border-radius: var(--radius);
      padding: 2rem;
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .pricing-card-popular {
      border: 3px solid var(--color-primary);
      box-shadow: 0 10px 30px rgba(14, 165, 233, 0.15);
      transform: scale(1.03);
    }
    .popular-badge {
      position: absolute;
      top: -14px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--color-primary);
      color: white;
      padding: 0.3rem 1rem;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .plan-header h2 { font-size: 1.5rem; margin-bottom: 0.25rem; }
    .plan-tagline { font-size: 0.85rem; color: var(--color-text-secondary); margin-bottom: 1.5rem; }
    .plan-price { margin-bottom: 1.5rem; }
    .price-amount { font-size: 2.5rem; font-weight: 800; color: var(--color-text); }
    .price-period { font-size: 1rem; color: var(--color-text-secondary); }
    .btn-block { width: 100%; text-align: center; margin-bottom: 1.5rem; }
    .plan-features { list-style: none; display: flex; flex-direction: column; gap: 0.6rem; flex: 1; }
    .plan-features li { font-size: 0.9rem; display: flex; gap: 0.5rem; align-items: flex-start; }
    .plan-features li.disabled { color: var(--color-text-secondary); opacity: 0.6; }
    .pricing-guarantee { text-align: center; font-size: 0.9rem; color: var(--color-text-secondary); }

    .comparison-table-wrap { overflow-x: auto; }
    .comparison-table {
      width: 100%;
      border-collapse: collapse;
      background: var(--color-surface);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
    }
    .comparison-table th,
    .comparison-table td {
      padding: 0.85rem 1rem;
      text-align: center;
      border-bottom: 1px solid var(--color-border);
    }
    .comparison-table th { background: var(--color-bg); font-weight: 700; font-size: 0.9rem; }
    .comparison-table td:first-child { text-align: left; font-weight: 500; }
    .comparison-table .pro-col { background: #f0f9ff; }
    .comparison-table tbody tr:hover { background: #f8fafc; }

    .faq-list { display: flex; flex-direction: column; gap: 0.75rem; max-width: 760px; margin: 0 auto; }
    .faq-item {
      background: var(--color-surface);
      border-radius: 8px;
      padding: 1rem 1.5rem;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
    }
    .faq-item summary { font-weight: 600; font-size: 1rem; }
    .faq-item p { margin-top: 0.75rem; color: var(--color-text-secondary); line-height: 1.6; }
    .faq-item a { color: var(--color-primary); }

    .cta-card {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #0ea5e9 100%);
      border-radius: var(--radius);
      padding: 3rem;
      text-align: center;
      color: white;
    }
    .cta-card h2 { font-size: 2rem; margin-bottom: 0.75rem; }
    .cta-card p { opacity: 0.9; margin-bottom: 1.5rem; }
    .cta-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-light { background: rgba(255,255,255,0.15); color: white; border: 2px solid rgba(255,255,255,0.3); }
    .btn-light:hover { background: rgba(255,255,255,0.25); }

    @media (max-width: 768px) {
      .pricing-grid { grid-template-columns: 1fr; }
      .pricing-card-popular { transform: none; }
      .pricing-hero h1 { font-size: 1.75rem; }
    }
  </style>
</BaseLayout>
