---
import BaseLayout from '../layouts/BaseLayout.astro';
import activeData from '../data/active.json';

const lang = 'en';
const { _fallback, fetchedAt, source } = activeData;
const buildTime = new Date(fetchedAt).toLocaleString('en-US', {
  month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short',
});
---

<BaseLayout
  title="Live Storm Map"
  description="Real-time interactive map of active tropical storms and hurricanes. Data streamed live from NOAA National Hurricane Center."
  lang={lang}
>
  {(_fallback) && (
    <div class="warning-banner">
      <span aria-hidden="true">⚠️</span> Live data temporarily unavailable — showing cached data from {buildTime}. Updates will resume shortly.
    </div>
  )}

  <div class="page-header">
    <div>
      <h1><span aria-hidden="true">🗺️</span> Live Storm Map</h1>
      <p>Real-time tracking of active tropical storms. Data from <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA National Hurricane Center</a>.</p>
    </div>
    <div class="map-status" id="map-status">
      <span class="status-indicator loading">Connecting to NOAA NHC...</span>
    </div>
  </div>

  <div class="map-legend">
    <div class="legend-title"><span aria-hidden="true">🌪️</span> Legend</div>
    <div class="legend-items">
      <span class="legend-item"><span class="legend-dot" style="background:#4dabf7;"></span> Tropical Depression</span>
      <span class="legend-item"><span class="legend-dot" style="background:#ffd43b;"></span> Tropical Storm</span>
      <span class="legend-item"><span class="legend-dot" style="background:#ff8787;"></span> Cat-1</span>
      <span class="legend-item"><span class="legend-dot" style="background:#fa5252;"></span> Cat-2</span>
      <span class="legend-item"><span class="legend-dot" style="background:#e64980;"></span> Cat-3</span>
      <span class="legend-item"><span class="legend-dot" style="background:#cc5de8;"></span> Cat-4</span>
      <span class="legend-item"><span class="legend-dot" style="background:#845ef7;"></span> Cat-5</span>
    </div>
  </div>

  <div id="storm-map" class="storm-map"></div>

  <div class="map-footer">
    <p>
      <span aria-hidden="true">🟢</span> <strong id="fetch-status">Live</strong> · Updated: <span id="last-updated">{buildTime}</span>
      · Source: <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA NHC</a>
      · Auto-refresh every 5 minutes
    </p>
  </div>

  <script is:inline define:vars={{ fallback: _fallback, buildTime }}>
    // 从构建时数据中获取初始标记
    // 地图数据由客户端 JS 从 /api/storms 实时获取
    document.getElementById('fetch-status').textContent = fallback ? '<span aria-hidden="true">⚠️</span> Cached' : '🟢 Live';
  </script>

  <script is:inline>
    var map;
    var markersLayer;

    function getIntensityColor(wind) {
      if (wind < 39) return '#4dabf7';
      if (wind < 74) return '#ffd43b';
      if (wind < 96) return '#ff8787';
      if (wind < 111) return '#fa5252';
      if (wind < 130) return '#e64980';
      if (wind < 157) return '#cc5de8';
      return '#845ef7';
    }

    function initMap() {
      map = L.map('storm-map', {
        center: [25, -55],
        zoom: 4,
        scrollWheelZoom: true,
        zoomControl: true,
      });

      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 18,
      }).addTo(map);

      markersLayer = L.layerGroup().addTo(map);
      fetchAndDisplayStorms();
    }

    async function fetchAndDisplayStorms() {
      var statusEl = document.getElementById('map-status');
      var statusTextEl = statusEl ? statusEl.querySelector('.status-indicator') : null;
      var fetchStatusEl = document.getElementById('fetch-status');
      var lastUpdatedEl = document.getElementById('last-updated');

      function setStatus(type, text) {
        if (statusTextEl) {
          statusTextEl.className = 'status-indicator ' + type;
          statusTextEl.textContent = text;
        }
        if (fetchStatusEl) {
          fetchStatusEl.textContent = type === 'error' ? '<span aria-hidden="true">⚠️</span> Unavailable' : type === 'loading' ? 'Loading...' : '🟢 Live';
        }
      }

      setStatus('loading', 'Fetching from NOAA NHC...');

      try {
        var resp = await fetch('/api/storms');
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        var data = await resp.json();

        markersLayer.clearLayers();

        if (data.storms && data.storms.length > 0) {
          setStatus('live', data.storms.length + ' Active Storm' + (data.storms.length > 1 ? 's' : ''));
          data.storms.forEach(function(storm) {
            var color = getIntensityColor(storm.wind);
            var marker = L.circleMarker([storm.lat, storm.lon], {
              radius: 12,
              fillColor: color,
              color: '#ffffff',
              weight: 2.5,
              fillOpacity: 0.85,
            });

            var popupContent = '<div style="min-width:200px;">' +
              '<h3 style="margin:0 0 6px;font-size:1.1em;">' + storm.name + '</h3>' +
              '<p style="margin:0 0 4px;font-size:0.85em;color:#64748b;">' + (storm.type || 'Tropical Cyclone') + '</p>' +
              '<table style="width:100%;font-size:0.85em;border-collapse:collapse;">' +
              '<tr><td style="padding:2px 4px;font-weight:600;">Wind</td><td style="padding:2px 4px;">' + storm.wind + ' mph</td></tr>' +
              '<tr><td style="padding:2px 4px;font-weight:600;">Pressure</td><td style="padding:2px 4px;">' + (storm.pressure > 0 ? storm.pressure + ' mb' : '—') + '</td></tr>' +
              '<tr><td style="padding:2px 4px;font-weight:600;">Movement</td><td style="padding:2px 4px;">' + storm.movement + '</td></tr>' +
              '<tr><td style="padding:2px 4px;font-weight:600;">Location</td><td style="padding:2px 4px;">' + storm.lat.toFixed(1) + '°N, ' + Math.abs(storm.lon).toFixed(1) + '°W</td></tr>' +
              '</table>';

            if (storm.headline) {
              popupContent += '<p style="margin:8px 0 0;font-size:0.8em;color:#475569;line-height:1.4;">' + storm.headline + '</p>';
            }
            popupContent += '</div>';

            marker.bindPopup(popupContent);
            markersLayer.addLayer(marker);
          });
          map.fitBounds(markersLayer.getBounds(), { padding: [50, 50] });
        } else {
          setStatus('no-active', '<span aria-hidden="true">☀️</span> No active storms');
        }

        if (data.fetchedAt && lastUpdatedEl) {
          var d = new Date(data.fetchedAt);
          lastUpdatedEl.textContent = d.toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });
        }
      } catch (err) {
        setStatus('error', '⚠️ Unable to reach NOAA');
        console.error('Failed to fetch storms:', err);
      }
    }

    // 地图懒加载：只在用户滚动到视口时初始化
    var mapObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          initMap();
          mapObserver.disconnect();
        }
      });
    }, { rootMargin: '200px' });

    var mapEl = document.getElementById('storm-map');
    if (mapEl) mapObserver.observe(mapEl);

    // 每 5 分钟自动刷新
    setInterval(fetchAndDisplayStorms, 5 * 60 * 1000);
  </script>

  <style>
    .warning-banner {
      background: #fef9c3;
      border: 1px solid #fcd34d;
      color: #92400e;
      padding: 0.75rem 1.5rem;
      border-radius: var(--radius);
      font-size: 0.9rem;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
    .page-header h1 { font-size: 2rem; margin: 0 0 0.5rem; }
    .page-header p { color: var(--color-text-secondary); margin: 0; }
    .page-header a { color: var(--color-primary); }
    .map-status { text-align: right; }
    .status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .status-indicator.loading { background: #dbeafe; color: #1e40af; }
    .status-indicator.live { background: #d1fae5; color: #065f46; }
    .status-indicator.no-active { background: #f0fdf4; color: #166534; }
    .status-indicator.error { background: #fef3c7; color: #92400e; }
    .map-legend {
      background: var(--color-surface);
      border-radius: 8px;
      padding: 0.75rem 1.25rem;
      margin-bottom: 1rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .legend-title { font-weight: 700; font-size: 0.85rem; }
    .legend-items { display: flex; gap: 1rem; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--color-text-secondary); }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .storm-map { width: 100%; height: 550px; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); background: #e8eef4; }
    .map-footer { margin-top: 0.75rem; font-size: 0.8rem; color: var(--color-text-secondary); }
    .map-footer a { color: var(--color-primary); }
    @media (max-width: 768px) {
      .storm-map { height: 400px; }
      .map-legend { flex-direction: column; align-items: flex-start; }
    }
  </style>
</BaseLayout>
