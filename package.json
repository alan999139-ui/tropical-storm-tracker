{
  "name": "tropical-storm-tracker",
  "version": "1.0.0",
  "description": "Tropical Storm real-time tracker and information hub",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/fetchGlobal.mjs",
    "build": "astro build && node scripts/generateSitemap.mjs",
    "fetch": "node scripts/fetchGlobal.mjs",
    "postbuild": "node scripts/generateSitemap.mjs",
    "preview": "astro preview",
    "deploy": "astro build && npx wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^4.12.0",
    "leaflet": "^1.9.4",
    "playwright-core": "^1.61.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "wrangler": "^3.60.0"
  }
}
