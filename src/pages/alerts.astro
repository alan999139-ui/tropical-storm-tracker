---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n/dict';
import { BASIN_LIST } from '../data/basins.mjs';

const lang = 'en';
// 全球 8 个流域 + 官方机构，作为地区选择器数据源
const regions = BASIN_LIST.map(b => ({
  value: b.id,
  name: b.names[lang] || b.names.en,
  agency: b.agency,
  flag: b.flag,
}));
---

<BaseLayout
  title="Alerts"
  description="Get free email alerts when tropical storms and hurricanes develop near your region. Powered by NOAA NHC & JTWC data worldwide."
  lang={lang}
>
  <section class="alerts-hero">
    <div class="alerts-hero-content">
      <h1><span aria-hidden="true">🔔</span> Storm Alerts</h1>
      <p class="hero-subtitle">
        Get notified the moment a tropical storm forms, intensifies, or approaches your area.
        Free email alerts — no spam, unsubscribe anytime.
      </p>
      <div class="trust-badges">
        <span class="trust-badge"><span aria-hidden="true">✅</span> Free for all regions</span>
        <span class="trust-badge"><span aria-hidden="true">🚫</span> No spam</span>
        <span class="trust-badge"><span aria-hidden="true">🆓</span> Free forever</span>
      </div>
    </div>
  </section>

  <!-- Alert Subscription Form -->
  <section class="section">
    <div class="subscribe-card">
      <h2>Set Up Your Free Alerts</h2>
      <p class="form-intro">Choose the regions you care about. We'll email you when storms threaten those areas.</p>

      <form id="alert-form" class="alert-form">
        <div class="form-group">
          <label for="email">Email Address <span class="required">*</span></label>
          <input type="email" id="email" name="email" placeholder="your@email.com" required />
        </div>

        <div class="form-group">
          <label for="name">Your Name <span class="optional">(optional)</span></label>
          <input type="text" id="name" name="name" placeholder="John Doe" />
        </div>

        <div class="form-group">
          <label>Alert Regions <span class="required">*</span></label>
          <p class="form-hint">Select all regions you want alerts for.</p>
          <div class="region-grid">
            {regions.map((r) => (
              <label class="region-option">
                <input type="checkbox" name="regions" value={r.value} />
                <span class="region-card">
                  <span class="region-icon" aria-hidden="true">{r.flag}</span>
                  <span class="region-name">{r.name}</span>
                  <span class="region-desc">{r.agency}</span>
                </span>
              </label>
            ))}
            <label class="region-option">
              <input type="checkbox" name="regions" value="global" />
              <span class="region-card">
                <span class="region-icon" aria-hidden="true">🌐</span>
                <span class="region-name">Global (All Basins)</span>
                <span class="region-desc">Every tropical cyclone worldwide</span>
              </span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label>Alert Types</label>
          <div class="alert-types">
            <label class="checkbox-row">
              <input type="checkbox" name="alertTypes" value="formation" checked />
              <span>New storm formation</span>
            </label>
            <label class="checkbox-row">
              <input type="checkbox" name="alertTypes" value="intensification" checked />
              <span>Storm intensification (category change)</span>
            </label>
            <label class="checkbox-row">
              <input type="checkbox" name="alertTypes" value="landfall" checked />
              <span>Approaching landfall</span>
            </label>
            <label class="checkbox-row">
              <input type="checkbox" name="alertTypes" value="seasonal" />
              <span>Weekly seasonal outlook (Pro)</span>
            </label>
          </div>
        </div>

        <div class="form-group">
          <label for="frequency">Alert Frequency</label>
          <select id="frequency" name="frequency">
            <option value="realtime">Real-time (as events happen)</option>
            <option value="daily">Daily digest</option>
            <option value="major">Major events only (Cat 3+)</option>
          </select>
        </div>

        <div class="form-group form-consent">
          <label class="checkbox-row">
            <input type="checkbox" name="terms" required />
            <span>I agree to receive email alerts and accept the <a href="/privacy">Privacy Policy</a>.</span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-large">
          <span aria-hidden="true">🔔</span> Activate Free Alerts
        </button>

        <p class="form-footer">
          Already have an account? <a href="/signin">Sign in</a> to manage your alerts.
        </p>
      </form>

      <div id="success-msg" class="success-msg hidden">
        <span class="success-icon" aria-hidden="true">✅</span>
        <h3>You're subscribed!</h3>
        <p>We've sent a confirmation email to <strong id="confirmed-email"></strong>. Click the link to activate your alerts.</p>
      </div>
    </div>
  </section>

  <!-- Why Subscribe -->
  <section class="section">
    <h2 class="section-title"><span aria-hidden="true">💡</span> Why Subscribe?</h2>
    <div class="benefits-grid">
      <div class="card benefit-card">
        <span class="benefit-icon" aria-hidden="true">⚡</span>
        <h3>Be First to Know</h3>
        <p>Get alerted the moment NOAA announces a new storm. Don't wait for the news — know immediately.</p>
      </div>
      <div class="card benefit-card">
        <span class="benefit-icon" aria-hidden="true">🎯</span>
        <h3>Relevant to You</h3>
        <p>Choose your regions. We only send alerts for storms that matter to your location.</p>
      </div>
      <div class="card benefit-card">
        <span class="benefit-icon" aria-hidden="true">📊</span>
        <h3>Actionable Info</h3>
        <p>Each alert includes storm position, wind speed, projected path, and recommended actions.</p>
      </div>
      <div class="card benefit-card">
        <span class="benefit-icon" aria-hidden="true">🆓</span>
        <h3>Always Free</h3>
        <p>Email alerts are free forever. Upgrade to Pro for SMS, push notifications, and more regions.</p>
      </div>
    </div>
  </section>

  <!-- Upgrade CTA -->
  <section class="section">
    <div class="upgrade-banner">
      <div class="upgrade-content">
        <h3><span aria-hidden="true">⬆️</span> Want SMS & Push Alerts?</h3>
        <p>Upgrade to <strong>Storm Tracker Pro</strong> for real-time SMS notifications, custom region alerts, 7-day forecast tracks, and ad-free experience.</p>
        <a href="/pricing" class="btn btn-primary">View Pro Features →</a>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('alert-form');
    const successMsg = document.getElementById('success-msg');
    const confirmedEmail = document.getElementById('confirmed-email');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const email = formData.get('email');

      // Store subscription locally (client-side only for now)
      const subscription = {
        email: email,
        name: formData.get('name') || '',
        regions: formData.getAll('regions'),
        alertTypes: formData.getAll('alertTypes'),
        frequency: formData.get('frequency'),
        createdAt: new Date().toISOString(),
      };

      try {
        // Try to submit to Cloudflare Function
        const resp = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(subscription),
        });

        if (resp.ok) {
          // Saved server-side
        }
      } catch (err) {
        // Fall back to localStorage
      }

      // Always save locally
      const subs = JSON.parse(localStorage.getItem('storm_alerts_subs') || '[]');
      subs.push(subscription);
      localStorage.setItem('storm_alerts_subs', JSON.stringify(subs));
      localStorage.setItem('storm_user_email', email);

      // Show success
      form.classList.add('hidden');
      successMsg.classList.remove('hidden');
      confirmedEmail.textContent = email;
    });
  </script>

  <style>
    .alerts-hero {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #0ea5e9 100%);
      border-radius: var(--radius);
      padding: 3rem 2.5rem;
      margin-bottom: 2.5rem;
      color: white;
      text-align: center;
    }
    .alerts-hero-content { max-width: 720px; margin: 0 auto; }
    .alerts-hero h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; }
    .hero-subtitle { font-size: 1.15rem; opacity: 0.9; line-height: 1.7; margin-bottom: 1.5rem; }
    .trust-badges { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; }
    .trust-badge { font-size: 0.9rem; opacity: 0.85; display: flex; align-items: center; gap: 0.4rem; }

    .subscribe-card {
      background: var(--color-surface);
      border-radius: var(--radius);
      padding: 2.5rem;
      box-shadow: var(--shadow-md);
      max-width: 800px;
      margin: 0 auto;
    }
    .subscribe-card h2 { font-size: 1.75rem; margin-bottom: 0.5rem; text-align: center; }
    .form-intro { text-align: center; color: var(--color-text-secondary); margin-bottom: 2rem; }

    .alert-form { display: flex; flex-direction: column; gap: 1.5rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .form-group label { font-weight: 600; font-size: 0.95rem; }
    .required { color: var(--color-danger); }
    .optional { color: var(--color-text-secondary); font-weight: 400; font-size: 0.85rem; }
    .form-hint { font-size: 0.85rem; color: var(--color-text-secondary); }

    .form-group input[type="email"],
    .form-group input[type="text"],
    .form-group select {
      padding: 0.75rem 1rem;
      border: 2px solid var(--color-border);
      border-radius: 8px;
      font-size: 1rem;
      font-family: inherit;
      transition: border 0.2s;
    }
    .form-group input:focus,
    .form-group select:focus {
      outline: none;
      border-color: var(--color-primary);
    }

    .region-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
      margin-top: 0.5rem;
    }
    .region-option { cursor: pointer; }
    .region-option input { position: absolute; opacity: 0; }
    .region-card {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      padding: 1rem;
      border: 2px solid var(--color-border);
      border-radius: 10px;
      transition: all 0.2s;
    }
    .region-option:hover .region-card { border-color: var(--color-primary); background: #f0f9ff; }
    .region-option input:checked + .region-card {
      border-color: var(--color-primary);
      background: #e0f2fe;
    }
    .region-icon { font-size: 1.5rem; }
    .region-name { font-weight: 700; font-size: 0.95rem; }
    .region-desc { font-size: 0.8rem; color: var(--color-text-secondary); }

    .alert-types { display: flex; flex-direction: column; gap: 0.5rem; }
    .checkbox-row { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.95rem; }
    .checkbox-row input { width: 18px; height: 18px; accent-color: var(--color-primary); }

    .form-consent { margin-top: 0.5rem; }
    .form-consent a { color: var(--color-primary); }

    .btn-large { padding: 1rem 2rem; font-size: 1.1rem; align-self: center; margin-top: 0.5rem; }
    .form-footer { text-align: center; font-size: 0.9rem; color: var(--color-text-secondary); margin-top: 0.5rem; }
    .form-footer a { color: var(--color-primary); font-weight: 600; }

    .hidden { display: none; }
    .success-msg {
      text-align: center;
      padding: 2rem;
    }
    .success-icon { font-size: 3rem; display: block; margin-bottom: 1rem; }

    .benefits-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
    .benefit-card { text-align: center; padding: 1.5rem; }
    .benefit-icon { font-size: 2.5rem; display: block; margin-bottom: 0.75rem; }
    .benefit-card h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
    .benefit-card p { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.5; }

    .upgrade-banner {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      border-radius: var(--radius);
      padding: 2.5rem;
      color: white;
      text-align: center;
    }
    .upgrade-content { max-width: 560px; margin: 0 auto; }
    .upgrade-content h3 { font-size: 1.5rem; margin-bottom: 0.75rem; }
    .upgrade-content p { opacity: 0.9; margin-bottom: 1.5rem; line-height: 1.6; }
    .upgrade-content .btn { background: white; color: #d97706; }

    @media (max-width: 768px) {
      .region-grid { grid-template-columns: 1fr; }
      .benefits-grid { grid-template-columns: repeat(2, 1fr); }
      .alerts-hero { padding: 2rem 1.5rem; }
      .alerts-hero h1 { font-size: 1.75rem; }
    }
  </style>
</BaseLayout>
