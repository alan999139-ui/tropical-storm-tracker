---
import { languages, t, localizedPath } from '../i18n/dict';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  lang?: string;
}

const {
  title,
  description = "Real-time tropical storm tracking, alerts, and historical data. Stay informed about tropical storms, hurricanes, and cyclones worldwide.",
  canonical,
  lang = 'en',
} = Astro.props;

const siteName = t('brand.name', lang);
const fullTitle = title === "Home" ? `${siteName} — ${t('brand.tagline', lang)}` : `${title} | ${siteName}`;
const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();
const currentPath = Astro.url.pathname;
const basePath = currentPath.replace(/^\/(zh|fr|ja)(?=\/|$)/, '') || '/';
const htmlLang = (languages as Record<string, any>)[lang]?.htmlLang || 'en';

// 语言切换链接
const langSwitchLinks = Object.values(languages).map(l => ({
  code: l.code,
  name: l.name,
  flag: l.flag,
  url: localizedPath(basePath, l.code),
  active: l.code === lang,
}));
---

<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <!-- SEO Meta -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow" />

  <!-- hreflang for SEO -->
  {langSwitchLinks.map(l => (
    <link rel="alternate" hreflang={l.code} href={new URL(l.url, Astro.site).toString()} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(basePath, Astro.site).toString()} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:image" content="/og-image.png" />
  <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : lang === 'fr' ? 'fr_FR' : lang === 'ja' ? 'ja_JP' : 'en_US'} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="/og-image.png" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Analytics 4 -->
  <!-- TODO: Replace GA_MEASUREMENT_ID with your actual GA4 Measurement ID (G-XXXXXXXX) -->
  <script is:inline>
    // GA4 Measurement ID - replace 'GA_MEASUREMENT_ID' with your actual ID from Google Analytics
    const GA4_ID = 'GA_MEASUREMENT_ID';
    
    if (GA4_ID !== 'GA_MEASUREMENT_ID') {
      // Only load GA4 if configured
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
      var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';
      j.async=true;j.src='https://www.googletagmanager.com/gtag/js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',GA4_ID);
      
      window.gtag = window.gtag || function(){dataLayer.push(arguments);};
      gtag('js', new Date());
      gtag('config', GA4_ID, {
        'page_language': htmlLang,
        'page_title': fullTitle,
        'send_page_view': true
      });
    }
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Leaflet CSS (地图) -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <!-- 结构化数据 -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": siteName,
    "url": Astro.site?.toString() || "https://tropicalstormtracker.quest",
    "description": description,
    "inLanguage": htmlLang,
  })} />

  <!-- GA4 Event Tracking Helper -->
  <script is:inline>
    // Helper function for GA4 events (used across all pages)
    window.trackEvent = function(eventName, eventParams = {}) {
      if (typeof gtag !== 'undefined') {
        gtag('event', eventName, eventParams);
        console.log('GA4 Event:', eventName, eventParams);
      }
    };
    
    // Track language switches
    document.addEventListener('click', function(e) {
      const langLink = e.target.closest('.lang-link');
      if (langLink) {
        const targetLang = langLink.getAttribute('href').match(/\/(zh|fr|ja)(\/|$)/)?.[1] || 'en';
        trackEvent('language_switch', {
          from_language: document.documentElement.lang,
          to_language: targetLang,
          page_path: window.location.pathname
        });
      }
    });
  </script>
</head>
<body>
  <header class="site-header">
    <nav class="nav">
      <a href={localizedPath('/', lang)} class="nav-logo">
        <span class="logo-icon">🌪️</span>
        <span class="logo-text">{siteName}</span>
      </a>
      <ul class="nav-links">
        <li><a href={localizedPath('/', lang)}>{t('nav.home', lang)}</a></li>
        <li><a href={localizedPath('/storms', lang)}>{t('nav.storms', lang)}</a></li>
        <li><a href={localizedPath('/map', lang)}>{t('nav.map', lang)}</a></li>
        <li><a href={localizedPath('/alerts', lang)}>{t('nav.alerts', lang)}</a></li>
        <li><a href={localizedPath('/preparedness', lang)}>{t('nav.preparedness', lang)}</a></li>
        <li><a href={localizedPath('/about', lang)}>{t('nav.about', lang)}</a></li>
      </ul>
      <!-- Auth + Language -->
      <div class="nav-actions">
        <div class="lang-switcher">
          {langSwitchLinks.map((l, i) => (
            <>
              {i > 0 && <span class="lang-sep">|</span>}
              <a href={l.url} class:list={["lang-link", { active: l.active }]} title={l.name}>
                <span class="lang-flag">{l.flag}</span>
                <span class="lang-code">{l.code.toUpperCase()}</span>
              </a>
            </>
          ))}
        </div>
        <div class="auth-buttons" id="nav-auth">
          <a href="/signin" class="nav-signin">{t('nav.signIn', lang)}</a>
          <a href="/signup" class="btn btn-nav-cta">{t('nav.signUp', lang)}</a>
        </div>
        <div class="auth-buttons hidden" id="nav-user">
          <a href="/dashboard" class="nav-dashboard">📊</a>
          <button class="btn btn-nav-cta" id="nav-signout">{t('dashboard.signOut', lang)}</button>
        </div>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="footer-content">
      <div class="footer-section">
        <h3>{siteName}</h3>
        <p>{t('footer.desc', lang)}</p>
      </div>
      <div class="footer-section">
        <h4>{t('footer.resources', lang)}</h4>
        <ul>
          <li><a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NHC Official</a></li>
          <li><a href="https://www.noaa.gov" target="_blank" rel="noopener">NOAA</a></li>
          <li><a href={localizedPath('/preparedness', lang)}>{t('nav.preparedness', lang)}</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>{t('footer.quickLinks', lang)}</h4>
        <ul>
          <li><a href={localizedPath('/map', lang)}>{t('nav.map', lang)}</a></li>
          <li><a href={localizedPath('/storms', lang)}>{t('nav.storms', lang)}</a></li>
          <li><a href={localizedPath('/alerts', lang)}>{t('nav.alerts', lang)}</a></li>
          <li><a href="/pricing">{t('footer.pricing', lang)}</a></li>
          <li><a href="/feed.xml">{t('footer.rss', lang)}</a></li>
        </ul>
      </div>
      <div class="footer-section">
        <h4>{t('footer.account', lang)}</h4>
        <ul>
          <li><a href="/signin">{t('nav.signIn', lang)}</a></li>
          <li><a href="/signup">{t('nav.signUp', lang)}</a></li>
          <li><a href="/dashboard">{t('dashboard.title', lang)}</a></li>
          <li><a href="/alerts">{t('nav.alerts', lang)}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} {t('footer.copyright', lang)}</p>
    </div>
  </footer>

  <!-- Leaflet JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>

  <!-- Auth state check -->
  <script is:inline>
    (function() {
      const loggedIn = localStorage.getItem('storm_user_logged_in');
      if (loggedIn === 'true') {
        document.getElementById('nav-auth')?.classList.add('hidden');
        document.getElementById('nav-user')?.classList.remove('hidden');
      }
      document.getElementById('nav-signout')?.addEventListener('click', () => {
        localStorage.removeItem('storm_user_logged_in');
        window.location.reload();
      });
    })();
  </script>

  <style is:global>
    :root {
      --color-primary: #0ea5e9;
      --color-primary-dark: #0284c7;
      --color-accent: #f59e0b;
      --color-danger: #ef4444;
      --color-bg: #f8fafc;
      --color-surface: #ffffff;
      --color-text: #0f172a;
      --color-text-secondary: #64748b;
      --color-border: #e2e8f0;
      --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 6px rgba(0,0,0,0.07), 0 2px 4px rgba(0,0,0,0.06);
      --shadow-lg: 0 10px 15px rgba(0,0,0,0.1), 0 4px 6px rgba(0,0,0,0.05);
      --radius: 12px;
      --max-width: 1200px;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--color-bg);
      color: var(--color-text);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    main {
      flex: 1;
      max-width: var(--max-width);
      width: 100%;
      margin: 0 auto;
      padding: 2rem 1.5rem;
    }

    /* Header */
    .site-header {
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: var(--shadow-sm);
    }

    .nav {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 0 1.5rem;
      height: 64px;
      display: flex;
      align-items: center;
      gap: 1rem;
      overflow: hidden;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
      color: var(--color-text);
      font-weight: 700;
      font-size: 1.25rem;
    }

    .logo-icon { font-size: 1.5rem; }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 1.75rem;
      flex-shrink: 0;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--color-text-secondary);
      font-weight: 500;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--color-primary); }

    /* Nav Actions */
    .nav-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-left: auto;
    }

    /* Auth Buttons */
    .auth-buttons {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .nav-signin {
      text-decoration: none;
      color: var(--color-text-secondary);
      font-weight: 600;
      font-size: 0.9rem;
      transition: color 0.2s;
    }
    .nav-signin:hover { color: var(--color-primary); }
    .btn-nav-cta {
      background: var(--color-primary);
      color: white !important;
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.85rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-nav-cta:hover { background: var(--color-primary-dark); }
    .nav-dashboard {
      font-size: 1.3rem;
      text-decoration: none;
      display: flex;
      align-items: center;
    }

    /* Language Switcher */
    .lang-switcher {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.85rem;
    }
    .lang-sep { color: var(--color-border); }
    .lang-link {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      text-decoration: none;
      color: var(--color-text-secondary);
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
      transition: all 0.15s;
    }
    .lang-link:hover { background: var(--color-bg); color: var(--color-text); }
    .lang-link.active { background: var(--color-primary); color: white; }
    .lang-flag { font-size: 1rem; }

    /* Footer */
    .site-footer {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border);
      margin-top: auto;
    }

    .footer-content {
      max-width: var(--max-width);
      margin: 0 auto;
      padding: 3rem 1.5rem 2rem;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 2rem;
    }

    .footer-section h3 { font-size: 1.1rem; margin-bottom: 0.5rem; }
    .footer-section h4 { font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); margin-bottom: 0.75rem; }
    .footer-section ul { list-style: none; }
    .footer-section li { margin-bottom: 0.4rem; }
    .footer-section a { color: var(--color-text-secondary); text-decoration: none; transition: color 0.2s; }
    .footer-section a:hover { color: var(--color-primary); }

    .footer-bottom {
      border-top: 1px solid var(--color-border);
      padding: 1rem 1.5rem;
      text-align: center;
      color: var(--color-text-secondary);
      font-size: 0.85rem;
    }

    /* 响应式 */
    @media (max-width: 768px) {
      .nav-links { gap: 0.75rem; font-size: 0.85rem; }
      .nav-logo .logo-text { display: none; }
      .lang-link .lang-code { display: none; }
      .nav-signin { display: none; }
      .nav-actions { gap: 0.5rem; }
      .footer-content { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    }
    @media (max-width: 480px) {
      .nav-links { gap: 0.5rem; }
      .nav-links a { font-size: 0.8rem; }
    }

    .hidden { display: none !important; }

    /* 卡片 */
    .card {
      background: var(--color-surface);
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
      padding: 1.5rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .card:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }

    /* 按钮 */
    .btn {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
    }
    .btn-primary { background: var(--color-primary); color: white; }
    .btn-primary:hover { background: var(--color-primary-dark); }
    .btn-outline { background: transparent; color: var(--color-primary); border: 2px solid var(--color-primary); }
    .btn-outline:hover { background: var(--color-primary); color: white; }

    /* 标签 */
    .badge {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .badge-active { background: #fef3c7; color: #92400e; }
    .badge-danger { background: #fee2e2; color: #991b1b; }
    .badge-safe { background: #d1fae5; color: #065f46; }

    .section-title { font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; }

    .grid { display: grid; gap: 1.5rem; }
    .grid-2 { grid-template-columns: repeat(2, 1fr); }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    @media (max-width: 768px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }
  </style>
</body>
</html>
