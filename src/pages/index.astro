---
import BaseLayout from '../layouts/BaseLayout.astro';

// 当前活跃风暴数据（示例 — 实际从 NOAA API 获取）
const activeStorms = [
  {
    name: 'Bertha',
    type: 'Tropical Storm',
    windSpeed: 52,
    pressure: 1003,
    movement: 'NW at 15 mph',
    location: 'Gulf of Mexico',
    lastUpdate: '2025-07-23 18:00 UTC',
    alert: 'Tropical Storm Warning issued for Gulf Coast',
  },
];

const recentStorms = [
  { name: 'Arthur', year: 2024, category: 'TS', maxWind: 52, formed: '2024-06-01', dissipated: '2024-06-03' },
  { name: 'Bertha', year: 2024, category: 'TS', maxWind: 52, formed: '2024-06-28', dissipated: '2024-06-30' },
  { name: 'Cristobal', year: 2024, category: 'TS', maxWind: 50, formed: '2024-07-24', dissipated: '2024-07-26' },
  { name: 'Dolly', year: 2024, category: 'TS', maxWind: 45, formed: '2024-08-15', dissipated: '2024-08-17' },
  { name: 'Edouard', year: 2024, category: 'TS', maxWind: 47, formed: '2024-09-03', dissipated: '2024-09-05' },
];

const preparednessTips = [
  { icon: '🎒', title: 'Emergency Kit', desc: '3-day supply of water, non-perishable food, flashlight, batteries, first aid kit.' },
  { icon: '🏠', title: 'Secure Your Home', desc: 'Reinforce windows, clear yard debris, check roof for loose shingles.' },
  { icon: '📱', title: 'Stay Connected', desc: 'Sign up for local alerts, keep phone charged, have battery radio backup.' },
  { icon: '🚗', title: 'Evacuation Plan', desc: 'Know your route, keep gas tank full, identify shelters ahead of time.' },
];

const categoryColors: Record<string, string> = {
  TD: '#4dabf7',
  TS: '#ffd43b',
  'Cat-1': '#ff8787',
  'Cat-2': '#fa5252',
  'Cat-3': '#e64980',
  'Cat-4': '#cc5de8',
  'Cat-5': '#845ef7',
};
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <span class="badge badge-active">🔥 {activeStorms.length} Active Storm{activeStorms.length > 1 ? 's' : ''}</span>
      <h1>Track Tropical Storms in Real-Time</h1>
      <p>Live tracking, alerts, and historical data for tropical storms, hurricanes, and cyclones worldwide. Powered by NOAA & NHC data.</p>
      <div class="hero-actions">
        <a href="/map" class="btn btn-primary">🗺️ View Live Map</a>
        <a href="/storms" class="btn btn-outline">Storm Database</a>
      </div>
    </div>
  </section>

  <!-- Active Storms -->
  <section class="section">
    <h2 class="section-title">⚡ Active Storms</h2>
    {activeStorms.length === 0 ? (
      <div class="card empty-state">
        <span class="empty-icon">☀️</span>
        <p>No active tropical storms at this time.</p>
        <a href="/storms" class="btn btn-outline">Browse Historical Data</a>
      </div>
    ) : (
      <div class="grid grid-2">
        {activeStorms.map((storm) => (
          <div class="card storm-card">
            <div class="storm-header">
              <div>
                <h3>{storm.name}</h3>
                <span class="storm-type">{storm.type}</span>
              </div>
              <span class="badge badge-danger">Active</span>
            </div>
            <div class="storm-stats">
              <div class="stat">
                <span class="stat-label">Wind Speed</span>
                <span class="stat-value">{storm.windSpeed} mph</span>
              </div>
              <div class="stat">
                <span class="stat-label">Pressure</span>
                <span class="stat-value">{storm.pressure} mb</span>
              </div>
              <div class="stat">
                <span class="stat-label">Movement</span>
                <span class="stat-value">{storm.movement}</span>
              </div>
              <div class="stat">
                <span class="stat-label">Location</span>
                <span class="stat-value">{storm.location}</span>
              </div>
            </div>
            <div class="storm-alert">
              ⚠️ {storm.alert}
            </div>
            <div class="storm-footer">
              <span class="update-time">Last updated: {storm.lastUpdate}</span>
              <a href={`/storms/${storm.name.toLowerCase()}`} class="btn btn-outline btn-sm">View Details →</a>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- Recent Storms -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">📊 Recent Storms</h2>
      <a href="/storms" class="see-all">View All →</a>
    </div>
    <div class="grid grid-3">
      {recentStorms.map((storm) => (
        <a href={`/storms/${storm.name.toLowerCase()}`} class="card storm-list-card">
          <div class="storm-list-header">
            <h3>{storm.name}</h3>
            <span class="badge" style={`background: ${categoryColors[storm.category] || '#e2e8f0'}33; color: ${categoryColors[storm.category] || '#64748b'};`}>{storm.category}</span>
          </div>
          <div class="storm-list-stats">
            <span>📅 {storm.year}</span>
            <span>💨 {storm.maxWind} mph</span>
            <span>⏱️ {storm.formed} → {storm.dissipated}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Preparedness -->
  <section class="section">
    <div class="section-header">
      <h2 class="section-title">🛡️ Storm Preparedness</h2>
      <a href="/preparedness" class="see-all">Full Guide →</a>
    </div>
    <div class="grid grid-4">
      {preparednessTips.map((tip) => (
        <div class="card prep-card">
          <span class="prep-icon">{tip.icon}</span>
          <h4>{tip.title}</h4>
          <p>{tip.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="cta-banner">
      <div class="cta-content">
        <h2>Never Miss a Storm Warning</h2>
        <p>Subscribe to get real-time alerts when a tropical storm is heading your way. Free, no spam.</p>
        <form class="subscribe-form">
          <input type="email" placeholder="your@email.com" required />
          <button type="submit" class="btn btn-primary">Subscribe</button>
        </form>
      </div>
    </div>
  </section>

  <style>
    .hero {
      background: linear-gradient(135deg, #0c4a6e 0%, #075985 50%, #0369a1 100%);
      border-radius: var(--radius);
      padding: 3rem 2rem;
      margin-bottom: 2.5rem;
      color: white;
      position: relative;
      overflow: hidden;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
      border-radius: 50%;
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 600px;
    }

    .hero h1 {
      font-size: 2.5rem;
      font-weight: 800;
      margin: 1rem 0;
      line-height: 1.2;
    }

    .hero p {
      font-size: 1.1rem;
      opacity: 0.9;
      margin-bottom: 1.5rem;
    }

    .hero-actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .hero-actions .btn-primary {
      background: var(--color-accent);
    }

    .hero-actions .btn-primary:hover {
      background: #d97706;
    }

    .hero-actions .btn-outline {
      color: white;
      border-color: rgba(255,255,255,0.4);
    }

    .hero-actions .btn-outline:hover {
      background: rgba(255,255,255,0.1);
      border-color: white;
    }

    .section {
      margin-bottom: 2.5rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
    }

    .section-title {
      margin-bottom: 0;
    }

    .see-all {
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 500;
    }

    /* Storm Card */
    .storm-card {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .storm-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
    }

    .storm-header h3 {
      font-size: 1.5rem;
      margin: 0;
    }

    .storm-type {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
    }

    .storm-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .stat {
      display: flex;
      flex-direction: column;
    }

    .stat-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
    }

    .stat-value {
      font-size: 1.1rem;
      font-weight: 600;
    }

    .storm-alert {
      background: #fef3c7;
      border: 1px solid #fcd34d;
      border-radius: 8px;
      padding: 0.75rem 1rem;
      font-size: 0.9rem;
      color: #92400e;
    }

    .storm-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.5rem;
      border-top: 1px solid var(--color-border);
    }

    .update-time {
      font-size: 0.8rem;
      color: var(--color-text-secondary);
    }

    .btn-sm {
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }

    /* Storm List Card */
    .storm-list-card {
      text-decoration: none;
      color: inherit;
    }

    .storm-list-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
    }

    .storm-list-header h3 {
      font-size: 1.2rem;
      margin: 0;
    }

    .storm-list-stats {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      font-size: 0.85rem;
      color: var(--color-text-secondary);
    }

    /* Empty State */
    .empty-state {
      text-align: center;
      padding: 3rem 2rem;
    }

    .empty-icon {
      font-size: 3rem;
      display: block;
      margin-bottom: 1rem;
    }

    /* Preparedness */
    .grid-4 {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }

    @media (max-width: 1024px) {
      .grid-4 {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 640px) {
      .grid-4 {
        grid-template-columns: 1fr;
      }
    }

    .prep-card {
      text-align: center;
    }

    .prep-icon {
      font-size: 2.5rem;
      display: block;
      margin-bottom: 0.75rem;
    }

    .prep-card h4 {
      margin-bottom: 0.5rem;
    }

    .prep-card p {
      font-size: 0.85rem;
      color: var(--color-text-secondary);
      line-height: 1.5;
    }

    /* CTA */
    .cta-banner {
      background: linear-gradient(135deg, #1e3a5f 0%, #0c4a6e 100%);
      border-radius: var(--radius);
      padding: 2.5rem 2rem;
      text-align: center;
      color: white;
    }

    .cta-content {
      max-width: 500px;
      margin: 0 auto;
    }

    .cta-content h2 {
      font-size: 1.75rem;
      margin-bottom: 0.5rem;
    }

    .cta-content p {
      opacity: 0.9;
      margin-bottom: 1.5rem;
    }

    .subscribe-form {
      display: flex;
      gap: 0.5rem;
    }

    .subscribe-form input {
      flex: 1;
      padding: 0.75rem 1rem;
      border: none;
      border-radius: 8px;
      font-size: 0.95rem;
    }

    .subscribe-form .btn-primary {
      background: var(--color-accent);
    }

    .subscribe-form .btn-primary:hover {
      background: #d97706;
    }

    @media (max-width: 640px) {
      .subscribe-form {
        flex-direction: column;
      }
    }
  </style>
</BaseLayout>
