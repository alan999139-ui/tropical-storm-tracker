---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dict';

// 防灾指南页面 — 高质量原创内容，SEO 权重页（中文版）
---

<BaseLayout
  title={t('prepPage.title', 'zh')}
  description={t('prepPage.desc', 'zh')}
  lang="zh"
>
  <div class="page-header">
    <h1>{t('prepPage.title', 'zh')}</h1>
    <p>{t('prepPage.desc', 'zh')}</p>
  </div>

  <!-- 快速导航 -->
  <nav class="toc">
    <h3>{t('prepPage.quickNav', 'zh')}</h3>
    <ul>
      <li><a href="#before">风暴来临前</a></li>
      <li><a href="#during">风暴期间</a></li>
      <li><a href="#after">风暴过后</a></li>
      <li><a href="#kit">应急包清单</a></li>
      <li><a href="#evacuation">撤离指南</a></li>
      <li><a href="#categories">风暴等级说明</a></li>
    </ul>
  </nav>

  <!-- 风暴等级 -->
  <section id="categories" class="content-section">
    <h2>{t('prepPage.categories', 'zh')}</h2>
    <div class="category-table">
      <div class="category-row">
        <span class="cat-badge" style="background: #4dabf733; color: #1971c2;">TD</span>
        <div class="cat-info">
          <strong>热带低压</strong>
          <p>风速：38 mph 以下。可能带来暴雨和洪水，但风害较小。</p>
        </div>
      </div>
      <div class="category-row">
        <span class="cat-badge" style="background: #ffd43b33; color: #f08c00;">TS</span>
        <div class="cat-info">
          <strong>热带风暴</strong>
          <p>风速：39-73 mph。可能造成严重洪水、停电和轻微结构损坏。</p>
        </div>
      </div>
      <div class="category-row">
        <span class="cat-badge" style="background: #ff878733; color: #c92a2a;">1级</span>
        <div class="cat-info">
          <strong>1级飓风</strong>
          <p>风速：74-95 mph。屋顶、树木和电线受损。沿海地区可能洪水泛滥。</p>
        </div>
      </div>
      <div class="category-row">
        <span class="cat-badge" style="background: #fa525233; color: #c92a2a;">2级</span>
        <div class="cat-info">
          <strong>2级飓风</strong>
          <p>风速：96-110 mph。屋顶和外墙严重受损。预计几乎全面停电。</p>
        </div>
      </div>
      <div class="category-row">
        <span class="cat-badge" style="background: #e6498033; color: #a61e4d;">3级</span>
        <div class="cat-info">
          <strong>3级飓风（强飓风）</strong>
          <p>风速：111-129 mph。破坏性极强。停水停电可能持续数天至数周。</p>
        </div>
      </div>
      <div class="category-row">
        <span class="cat-badge" style="background: #cc5de833; color: #862e9c;">4级</span>
        <div class="cat-info">
          <strong>4级飓风（强飓风）</strong>
          <p>风速：130-156 mph。灾难性破坏。大部分地区数周或数月内无法居住。</p>
        </div>
      </div>
      <div class="category-row">
        <span class="cat-badge" style="background: #845ef733; color: #5f3dc4;">5级</span>
        <div class="cat-info">
          <strong>5级飓风（强飓风）</strong>
          <p>风速：157 mph 以上。屋顶完全塌陷、墙壁倒塌。该地区数月内无法居住。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 风暴来临前 -->
  <section id="before" class="content-section">
    <h2>风暴来临前</h2>
    <div class="checklist">
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>准备应急包</strong>
          <p>准备3天的必需品：饮用水（每人每天1加仑）、不易腐食品、手电筒、电池、急救包、药物，以及防水容器中的重要文件。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>制定家庭计划</strong>
          <p>与家人讨论去哪里、如何联络、走散后怎么办。指定一个外州的联系人。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>加固房屋</strong>
          <p>安装防风百叶窗或用木板封住窗户。清理院中松散物品。加固车库门。检查屋顶瓦片是否松动。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>检查保险覆盖范围</strong>
          <p>标准房屋保险不覆盖洪水损失。考虑通过国家洪水保险计划（NFIP）购买洪水保险。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>了解你的撤离区域</strong>
          <p>查询当地撤离区域和路线。规划好住宿地点。风暴季期间保持油箱满油。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 风暴期间 -->
  <section id="during" class="content-section">
    <h2>风暴期间</h2>
    <div class="checklist">
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>留在室内</strong>
          <p>在官方宣布安全之前不要外出。风暴眼会带来短暂的平静——切勿出门。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>持续关注最新消息</strong>
          <p>使用电池供电或手摇式收音机收听 NOAA 气象广播或当地新闻。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>远离窗户</strong>
          <p>待在不易洪水泛滥的最低层内部房间。关闭所有内门。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>必要时关闭公用设施</strong>
          <p>如当局指示或怀疑有损坏，关闭燃气、电力和水源。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>切勿在室内使用发电机</strong>
          <p>发电机产生的一氧化碳可致命。将发电机放在室外，距离窗户至少20英尺。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 风暴过后 -->
  <section id="after" class="content-section">
    <h2>风暴过后</h2>
    <div class="checklist">
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>等待官方解除警报</strong>
          <p>在当局宣布安全之前不要返回家中。注意倒伏的电线和积水道路。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>记录损失</strong>
          <p>在清理之前拍摄所有损坏的照片和视频。立即联系保险公司。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>远离洪水</strong>
          <p>积水可能受到污染、带电或藏有危险碎片。切勿步行或驾车穿越。</p>
        </div>
      </div>
      <div class="checklist-item">
        <span class="check">✓</span>
        <div>
          <strong>关心邻居</strong>
          <p>特别是可能需要帮助的老人或残障人士。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 应急包清单 -->
  <section id="kit" class="content-section">
    <h2>应急包清单</h2>
    <div class="kit-grid">
      <div class="kit-card">
        <h4>💧 水和食物</h4>
        <ul>
          <li>每人每天1加仑水（至少3天用量）</li>
          <li>不易腐食品（罐头、能量棒）</li>
          <li>手动开罐器</li>
          <li>宠物食品（如有宠物）</li>
        </ul>
      </div>
      <div class="kit-card">
        <h4>🔦 照明和电源</h4>
        <ul>
          <li>手电筒（避免使用蜡烛）</li>
          <li>备用电池（AA、AAA、C、D）</li>
          <li>电池供电或手摇式收音机</li>
          <li>手机充电宝</li>
        </ul>
      </div>
      <div class="kit-card">
        <h4>🏥 健康和急救</h4>
        <ul>
          <li>急救包</li>
          <li>处方药（7天用量）</li>
          <li>非处方药</li>
          <li>眼镜或隐形眼镜</li>
        </ul>
      </div>
      <div class="kit-card">
        <h4>📋 文件</h4>
        <ul>
          <li>身份证和保险卡</li>
          <li>银行账号信息</li>
          <li>紧急联系人列表</li>
          <li>防水袋中的复印件</li>
        </ul>
      </div>
      <div class="kit-card">
        <h4>🧰 工具</h4>
        <ul>
          <li>多功能刀或瑞士军刀</li>
          <li>防水胶带</li>
          <li>塑料布</li>
          <li>求救哨子</li>
        </ul>
      </div>
      <div class="kit-card">
        <h4>🧹 卫生用品</h4>
        <ul>
          <li>洗手液</li>
          <li>湿巾</li>
          <li>垃圾袋</li>
          <li>卫生纸</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 撤离指南 -->
  <section id="evacuation" class="content-section">
    <h2>撤离指南</h2>
    <div class="evac-steps">
      <div class="evac-step">
        <span class="step-number">1</span>
        <div>
          <strong>了解你的撤离区域</strong>
          <p>在 ready.gov 或当地应急管理网站查询你的撤离区域。A区通常最先撤离。</p>
        </div>
      </div>
      <div class="evac-step">
        <span class="step-number">2</span>
        <div>
          <strong>规划路线</strong>
          <p>提前确认多条路线以防道路封闭。当地当局会指定撤离路线——请遵循指引。</p>
        </div>
      </div>
      <div class="evac-step">
        <span class="step-number">3</span>
        <div>
          <strong>准备车辆</strong>
          <p>风暴季期间保持油箱至少半满。检查轮胎、机油和电池。准备车载应急包。</p>
        </div>
      </div>
      <div class="evac-step">
        <span class="step-number">4</span>
        <div>
          <strong>携带物品</strong>
          <p>应急包、重要文件、药物、3天衣物、现金、手机充电器和贵重物品。</p>
        </div>
      </div>
      <div class="evac-step">
        <span class="step-number">5</span>
        <div>
          <strong>去哪里</strong>
          <p>首选投亲靠友。公共避难所可用但应作为最后选择。撤离区域外的酒店也是一个选项。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 常见问题 -->
  <section class="content-section">
    <h2>常见问题</h2>
    <div class="faq-list">
      <details class="faq-item">
        <summary>什么是热带风暴？</summary>
        <p>热带风暴是持续风速在39-73 mph（63-118 km/h）之间的热带气旋。它比热带低压强，但比飓风弱。</p>
      </details>
      <details class="faq-item">
        <summary>热带风暴和飓风有什么区别？</summary>
        <p>主要区别在于风速。热带风暴风速为39-73 mph，而飓风风速为74 mph 以上。两者都可能通过洪水和风造成严重破坏。</p>
      </details>
      <details class="faq-item">
        <summary>热带风暴通常持续多久？</summary>
        <p>热带风暴通常持续2-7天，但有些可以持续数周。其持续时间取决于海面温度、风切变和其他大气条件。</p>
      </details>
      <details class="faq-item">
        <summary>热带风暴季是什么时候？</summary>
        <p>大西洋热带风暴季为6月1日至11月30日，9月为高峰期。太平洋风暴季为5月15日至11月30日。</p>
      </details>
      <details class="faq-item">
        <summary>热带风暴来临时我应该怎么做？</summary>
        <p>关注当地天气更新，加固房屋，查看撤离计划，准备应急包。遵循当地当局的所有指示。</p>
      </details>
    </div>

    <!-- FAQ Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "什么是热带风暴？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "热带风暴是持续风速在39-73 mph（63-118 km/h）之间的热带气旋。它比热带低压强，但比飓风弱。"
          }
        },
        {
          "@type": "Question",
          "name": "热带风暴和飓风有什么区别？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "主要区别在于风速。热带风暴风速为39-73 mph，而飓风风速为74 mph 以上。"
          }
        },
        {
          "@type": "Question",
          "name": "热带风暴季是什么时候？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "大西洋热带风暴季为6月1日至11月30日，9月为高峰期。太平洋风暴季为5月15日至11月30日。"
          }
        }
      ]
    })} />
  </section>

  <style>
    .page-header {
      margin-bottom: 2rem;
    }

    .toc {
      background: var(--color-surface);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
      margin-bottom: 2rem;
    }

    .toc h3 {
      margin-bottom: 0.75rem;
    }

    .toc ul {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .toc li {
      display: inline-flex;
    }

    .toc a {
      color: var(--color-primary);
      text-decoration: none;
      font-weight: 500;
      padding: 0.4rem 0.9rem;
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 20px;
      font-size: 0.88rem;
      transition: all 0.15s ease;
    }

    .toc a:hover {
      text-decoration: none;
      background: var(--color-primary);
      color: white;
      border-color: var(--color-primary);
    }

    .content-section {
      margin-bottom: 3rem;
    }

    .content-section h2 {
      font-size: 1.75rem;
      margin-bottom: 1.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--color-border);
    }

    /* Category Table */
    .category-table {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .category-row {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      background: var(--color-surface);
      padding: 1rem 1.5rem;
      border-radius: 8px;
      box-shadow: var(--shadow-sm);
    }

    .cat-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 60px;
      height: 32px;
      border-radius: 6px;
      font-weight: 700;
      font-size: 0.85rem;
      flex-shrink: 0;
    }

    .cat-info strong {
      display: block;
      margin-bottom: 0.25rem;
    }

    .cat-info p {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
    }

    /* Checklist */
    .checklist {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .checklist-item {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      background: var(--color-surface);
      padding: 1rem 1.5rem;
      border-radius: 8px;
      box-shadow: var(--shadow-sm);
    }

    .check {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      background: #d1fae5;
      color: #065f46;
      border-radius: 50%;
      font-weight: 700;
      flex-shrink: 0;
    }

    .checklist-item strong {
      display: block;
      margin-bottom: 0.25rem;
    }

    .checklist-item p {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
    }

    /* Kit Grid */
    .kit-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    @media (max-width: 768px) {
      .kit-grid {
        grid-template-columns: 1fr;
      }
    }

    .kit-card {
      background: var(--color-surface);
      border-radius: 8px;
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
    }

    .kit-card h4 {
      margin-bottom: 0.75rem;
    }

    .kit-card ul {
      list-style: none;
      padding: 0;
    }

    .kit-card li {
      padding: 0.4rem 0;
      font-size: 0.9rem;
      border-bottom: 1px solid var(--color-border);
    }

    .kit-card li:last-child {
      border-bottom: none;
    }

    .kit-card li::before {
      content: '•';
      color: var(--color-primary);
      font-weight: bold;
      margin-right: 0.5rem;
    }

    /* Evacuation Steps */
    .evac-steps {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .evac-step {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      background: var(--color-surface);
      padding: 1rem 1.5rem;
      border-radius: 8px;
      box-shadow: var(--shadow-sm);
    }

    .step-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      background: var(--color-primary);
      color: white;
      border-radius: 50%;
      font-weight: 700;
      flex-shrink: 0;
    }

    .evac-step strong {
      display: block;
      margin-bottom: 0.25rem;
    }

    .evac-step p {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
    }

    /* FAQ */
    .faq-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .faq-item {
      background: var(--color-surface);
      border-radius: 8px;
      padding: 1rem 1.5rem;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
    }

    .faq-item summary {
      font-weight: 600;
      font-size: 1rem;
    }

    .faq-item p {
      margin-top: 0.75rem;
      color: var(--color-text-secondary);
      font-size: 0.9rem;
    }
  </style>
</BaseLayout>
