---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { historicalStorms } from '../../data/historical';
import ShareButtons from '../../components/ShareButtons.astro';

export function getStaticPaths() {
  return historicalStorms.map(storm => ({
    params: { name: storm.name.toLowerCase() },
    props: { storm },
  }));
}

const { storm } = Astro.props;

const categoryColors: Record<string, string> = {
  TD: '#4dabf7', TS: '#ffd43b', 'Cat-1': '#ff8787', 'Cat-2': '#fa5252',
  'Cat-3': '#e64980', 'Cat-4': '#cc5de8', 'Cat-5': '#845ef7',
};

const catColor = categoryColors[storm.category] || '#64748b';
const catName = storm.category === 'TD' ? 'Tropical Depression'
  : storm.category === 'TS' ? 'Tropical Storm'
  : storm.category.replace('Cat-', 'Category ');

const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": `Tropical Storm ${storm.name} ${storm.year}`,
  "startDate": storm.formed,
  "endDate": storm.dissipated,
  "description": storm.description,
  "eventStatus": "https://schema.org/EventCompleted",
  "location": { "@type": "Place", "name": storm.region },
};
---

<BaseLayout
  title={`Tropical Storm ${storm.name} (${storm.year})`}
  description={`${storm.name} was a ${catName} in ${storm.year}. Max winds: ${storm.maxWind} mph. Track, stats, and impact information.`}
  canonical={`/storms/${storm.name.toLowerCase()}/`}
  lang="en"
>
  <nav class="breadcrumb">
    <a href="/">Home</a> <span>/</span>
    <a href="/storms">Storms</a> <span>/</span>
    <span>{storm.name} {storm.year}</span>
  </nav>

  <div class="storm-detail-header">
    <div>
      <h1>{storm.name}</h1>
      <span class="storm-year">{storm.year} Atlantic Hurricane Season</span>
    </div>
    <span class="badge" style={`background: ${catColor}33; color: ${catColor};`}>{storm.category}</span>
  </div>

  <!-- Share Buttons -->
  <div data-lang="en" class="share-container">
    <ShareButtons url={new URL(`/storms/${storm.name.toLowerCase()}/`, Astro.site).toString()} title={`${storm.name} ${storm.year}`} lang="en" />
  </div>

  <div class="stats-grid">
    <div class="stat-card"><span class="stat-label">Max Wind Speed</span><span class="stat-value">{storm.maxWind} <span class="unit">mph</span></span></div>
    <div class="stat-card"><span class="stat-label">Min Pressure</span><span class="stat-value">{storm.minPressure} <span class="unit">mb</span></span></div>
    <div class="stat-card"><span class="stat-label">Duration</span><span class="stat-value">{storm.duration}</span></div>
    <div class="stat-card"><span class="stat-label">Region</span><span class="stat-value">{storm.region}</span></div>
    <div class="stat-card"><span class="stat-label">Landfall</span><span class="stat-value">{storm.landfall}</span></div>
    <div class="stat-card"><span class="stat-label">Damage</span><span class="stat-value">{storm.damage}</span></div>
    <div class="stat-card"><span class="stat-label">Fatalities</span><span class="stat-value">{storm.fatalities}</span></div>
    <div class="stat-card"><span class="stat-label">Formed</span><span class="stat-value">{storm.formed}</span></div>
  </div>

  <section class="section">
    <h2>Overview</h2>
    <p>{storm.description}</p>
  </section>

  <section class="section">
    <h2>Storm Path</h2>
    <div id="storm-track-map" class="track-map"></div>
  </section>

  <section class="section">
    <h2>Storm Track Data</h2>
    <div class="table-container">
      <table class="track-table">
        <thead>
          <tr>
            <th>Time (UTC)</th>
            <th>Latitude</th>
            <th>Longitude</th>
            <th>Wind (mph)</th>
            <th>Pressure (mb)</th>
          </tr>
        </thead>
        <tbody>
          {storm.track.map((point) => (
            <tr>
              <td>{point.time}</td>
              <td>{point.lat}°N</td>
              <td>{Math.abs(point.lon)}°W</td>
              <td>{point.wind}</td>
              <td>{point.pressure}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <h2>Data Source</h2>
    <p>Track data from <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA National Hurricane Center</a>. Last updated: {storm.dissipated}.</p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(eventData)} />

  <style>
    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; margin-bottom: 1.5rem; color: var(--color-text-secondary); }
    .breadcrumb a { color: var(--color-primary); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .storm-detail-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
    .storm-detail-header h1 { font-size: 2rem; margin: 0; }
    .storm-year { color: var(--color-text-secondary); font-size: 0.95rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
    @media (max-width: 768px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    .stat-card { background: var(--color-surface); border-radius: 8px; padding: 1rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 0.25rem; }
    .stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); }
    .stat-value { font-size: 1.25rem; font-weight: 700; }
    .unit { font-size: 0.85rem; font-weight: 400; color: var(--color-text-secondary); }
    .section { margin-bottom: 2rem; }
    .section h2 { font-size: 1.5rem; margin-bottom: 1rem; }
    .section p { color: var(--color-text-secondary); line-height: 1.7; }
    .section a { color: var(--color-primary); }
    .table-container { overflow-x: auto; background: var(--color-surface); border-radius: 8px; box-shadow: var(--shadow-sm); }
    .track-table { width: 100%; border-collapse: collapse; }
    .track-table th { background: #f1f5f9; padding: 0.6rem 1rem; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); }
    .track-table td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; }
    .track-table tbody tr:hover { background: #f8fafc; }
    .track-map { width: 100%; height: 400px; border-radius: 8px; overflow: hidden; box-shadow: var(--shadow-sm); background: #e8eef4; }
  </style>

  <script is:inline define:vars={{ trackPoints: storm.track }}>
    function initTrackMap() {
      if (typeof L === 'undefined') { setTimeout(initTrackMap, 100); return; }
      var map = L.map('storm-track-map', { center: [trackPoints[0].lat, trackPoints[0].lon], zoom: 5, scrollWheelZoom: false });
      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', subdomains: 'abcd' }).addTo(map);
      var latlngs = trackPoints.map(function(p) { return [p.lat, p.lon]; });
      L.polyline(latlngs, { color: '#f59e0b', weight: 3, opacity: 0.8 }).addTo(map);
      trackPoints.forEach(function(p, i) {
        var isFirst = i === 0; var isLast = i === trackPoints.length - 1;
        L.circleMarker([p.lat, p.lon], { radius: isFirst || isLast ? 8 : 5, fillColor: isFirst ? '#4dabf7' : isLast ? '#ef4444' : '#ffd43b', color: '#fff', weight: 2, fillOpacity: 0.8 }).addTo(map).bindPopup('<strong>' + p.time + '</strong><br>Wind: ' + p.wind + ' mph<br>Pressure: ' + p.pressure + ' mb<br>Location: ' + p.lat + '°N, ' + Math.abs(p.lon) + '°W');
      });
      map.fitBounds(latlngs, { padding: [40, 40] });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initTrackMap); } else { initTrackMap(); }
  </script>
</BaseLayout>
