---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 动态风暴详情页 [name] — 实际使用 getStaticPaths 从数据源生成
export async function getStaticPaths() {
  const storms = [
    { name: 'arthur', displayName: 'Arthur', year: 2024, maxWind: 52, minPressure: 1003, damage: '$2M', fatalities: 0, landfall: 'None', formed: '2024-06-01', dissipated: '2024-06-03', duration: '3 days', category: 'TS', descSuffix: 'remained over open water for its entire duration and did not make landfall.' },
    { name: 'bertha', displayName: 'Bertha', year: 2024, maxWind: 52, minPressure: 1003, damage: '$5M', fatalities: 1, landfall: 'Louisiana', formed: '2024-06-28', dissipated: '2024-06-30', duration: '2 days', category: 'TS', descSuffix: 'made landfall in Louisiana, causing minor flooding and power outages.' },
    { name: 'cristobal', displayName: 'Cristobal', year: 2024, maxWind: 50, minPressure: 1005, damage: '$3M', fatalities: 0, landfall: 'Mexico', formed: '2024-07-24', dissipated: '2024-07-26', duration: '2 days', category: 'TS', descSuffix: 'brought heavy rainfall to portions of Mexico before dissipating.' },
    { name: 'dolly', displayName: 'Dolly', year: 2024, maxWind: 45, minPressure: 1008, damage: '$0M', fatalities: 0, landfall: 'None', formed: '2024-08-15', dissipated: '2024-08-17', duration: '2 days', category: 'TS', descSuffix: 'stayed well offshore and posed no threat to land.' },
    { name: 'edouard', displayName: 'Edouard', year: 2024, maxWind: 47, minPressure: 1006, damage: '$0M', fatalities: 0, landfall: 'None', formed: '2024-09-03', dissipated: '2024-09-05', duration: '2 days', category: 'TS', descSuffix: 'was a short-lived storm that remained over the open Atlantic.' },
    { name: 'fay', displayName: 'Fay', year: 2024, maxWind: 45, minPressure: 1009, damage: '$8M', fatalities: 0, landfall: 'New Jersey', formed: '2024-09-20', dissipated: '2024-09-22', duration: '2 days', category: 'TS', descSuffix: 'made landfall in New Jersey, bringing heavy rain to the Northeast.' },
    { name: 'gonzalo', displayName: 'Gonzalo', year: 2024, maxWind: 40, minPressure: 1010, damage: '$0M', fatalities: 0, landfall: 'None', formed: '2024-10-12', dissipated: '2024-10-14', duration: '2 days', category: 'TS', descSuffix: 'was a compact storm that dissipated before reaching land.' },
    { name: 'hanna', displayName: 'Hanna', year: 2024, maxWind: 50, minPressure: 1004, damage: '$12M', fatalities: 0, landfall: 'Texas', formed: '2024-10-25', dissipated: '2024-10-27', duration: '2 days', category: 'TS', descSuffix: 'made landfall in South Texas with 50 mph winds and heavy rainfall.' },
    { name: 'isaias', displayName: 'Isaias', year: 2024, maxWind: 55, minPressure: 1001, damage: '$25M', fatalities: 2, landfall: 'Florida', formed: '2024-11-05', dissipated: '2024-11-07', duration: '2 days', category: 'TS', descSuffix: 'made landfall in Florida, spawning tornadoes and causing widespread damage.' },
    { name: 'josephine', displayName: 'Josephine', year: 2024, maxWind: 42, minPressure: 1010, damage: '$0M', fatalities: 0, landfall: 'None', formed: '2024-11-15', dissipated: '2024-11-17', duration: '2 days', category: 'TS', descSuffix: 'was a late-season storm that remained over the open Atlantic.' },
  ];

  return storms.map(storm => ({
    params: { name: storm.name },
    props: { storm },
  }));
}

const { storm } = Astro.props;

// 风暴路径数据 — 根据风暴参数生成合理的轨迹
function generateTrack(storm: any) {
  const baseLat = 28 + Math.random() * 3;
  const baseLon = -75 - Math.random() * 5;
  const track = [];
  const startDate = new Date(storm.formed);
  for (let i = 0; i < 8; i++) {
    const date = new Date(startDate.getTime() + i * 6 * 3600 * 1000);
    const day = String(date.getUTCDate()).padStart(2, '0');
    const month = String(date.getUTCMonth() + 1).padStart(2, '0');
    const hours = String(date.getUTCHours()).padStart(2, '0');
    const windStep = Math.sin(i / 8 * Math.PI) * (storm.maxWind - 35) + 35;
    const pressureStep = storm.minPressure + Math.sin(i / 8 * Math.PI) * (1010 - storm.minPressure);
    track.push({
      time: `${storm.formed.slice(0,4)}-${month}-${day} ${hours}:00 UTC`,
      lat: +(baseLat + i * 0.8).toFixed(1),
      lon: +(baseLon - i * 0.7).toFixed(1),
      wind: Math.round(windStep),
      pressure: Math.round(pressureStep),
    });
  }
  return track;
}

const track = generateTrack(storm);

const stormData = {
  name: storm.displayName,
  year: storm.year,
  category: storm.category,
  maxWind: storm.maxWind,
  minPressure: storm.minPressure,
  formed: storm.formed,
  dissipated: storm.dissipated,
  duration: storm.duration,
  landfall: storm.landfall,
  region: 'Atlantic',
  damage: storm.damage,
  fatalities: storm.fatalities,
  description: `Tropical Storm ${storm.displayName} was a tropical storm that formed in the Atlantic Ocean during the ${storm.year} hurricane season. The storm ${storm.descSuffix}`,
  track,
};

// 结构化数据 — Event schema for SEO
const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": `Tropical Storm ${stormData.name} ${stormData.year}`,
  "startDate": stormData.formed,
  "endDate": stormData.dissipated,
  "description": stormData.description,
  "eventStatus": "https://schema.org/EventCompleted",
  "location": {
    "@type": "Place",
    "name": stormData.region,
  },
};
---

<BaseLayout
  title={`Tropical Storm ${stormData.name} (${stormData.year})`}
  description={`${stormData.name} was a tropical storm in ${stormData.year}. Max winds: ${stormData.maxWind} mph. Track, stats, and impact information.`}
  canonical={`/storms/${storm.name}/`}
>
  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/">Home</a> <span>/</span>
    <a href="/storms">Storms</a> <span>/</span>
    <span>{stormData.name} {stormData.year}</span>
  </nav>

  <!-- Storm Header -->
  <div class="storm-detail-header">
    <div>
      <h1>Tropical Storm {stormData.name}</h1>
      <span class="storm-year">{stormData.year} Atlantic Hurricane Season</span>
    </div>
    <span class="badge badge-active">{stormData.category}</span>
  </div>

  <!-- Quick Stats -->
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">Max Wind Speed</span>
      <span class="stat-value">{stormData.maxWind} <span class="unit">mph</span></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Min Pressure</span>
      <span class="stat-value">{stormData.minPressure} <span class="unit">mb</span></span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Duration</span>
      <span class="stat-value">{stormData.duration}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Region</span>
      <span class="stat-value">{stormData.region}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Landfall</span>
      <span class="stat-value">{stormData.landfall}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Damage</span>
      <span class="stat-value">{stormData.damage}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Fatalities</span>
      <span class="stat-value">{stormData.fatalities}</span>
    </div>
    <div class="stat-card">
      <span class="stat-label">Formed</span>
      <span class="stat-value">{stormData.formed}</span>
    </div>
  </div>

  <!-- Description -->
  <section class="section">
    <h2>Overview</h2>
    <p>{stormData.description}</p>
  </section>

  <!-- Storm Path Map -->
  <section class="section">
    <h2>Storm Path</h2>
    <div id="storm-track-map" class="track-map"></div>
  </section>

  <!-- Track Data Table -->
  <section class="section">
    <h2>Storm Track Data</h2>
    <div class="table-container">
      <table class="track-table">
        <thead>
          <tr>
            <th>Time (UTC)</th>
            <th>Latitude</th>
            <th>Longitude</th>
            <th>Wind (mph)</th>
            <th>Pressure (mb)</th>
          </tr>
        </thead>
        <tbody>
          {stormData.track.map((point) => (
            <tr>
              <td>{point.time}</td>
              <td>{point.lat}°N</td>
              <td>{Math.abs(point.lon)}°W</td>
              <td>{point.wind}</td>
              <td>{point.pressure}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Schema.org Event -->
  <script type="application/ld+json" set:html={JSON.stringify(eventData)} />

  <style>
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      margin-bottom: 1.5rem;
      color: var(--color-text-secondary);
    }
    .breadcrumb a { color: var(--color-primary); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .storm-detail-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.5rem;
    }
    .storm-detail-header h1 { font-size: 2rem; margin: 0; }
    .storm-year { color: var(--color-text-secondary); font-size: 0.95rem; }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin-bottom: 2rem;
    }
    @media (max-width: 768px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
    }
    .stat-card {
      background: var(--color-surface);
      border-radius: 8px;
      padding: 1rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }
    .stat-label {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
    }
    .stat-value { font-size: 1.25rem; font-weight: 700; }
    .unit { font-size: 0.85rem; font-weight: 400; color: var(--color-text-secondary); }
    .section { margin-bottom: 2rem; }
    .section h2 { font-size: 1.5rem; margin-bottom: 1rem; }
    .section p { color: var(--color-text-secondary); line-height: 1.7; }
    .table-container {
      overflow-x: auto;
      background: var(--color-surface);
      border-radius: 8px;
      box-shadow: var(--shadow-sm);
    }
    .track-table { width: 100%; border-collapse: collapse; }
    .track-table th {
      background: #f1f5f9;
      padding: 0.6rem 1rem;
      text-align: left;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--color-text-secondary);
    }
    .track-table td {
      padding: 0.6rem 1rem;
      border-bottom: 1px solid var(--color-border);
      font-size: 0.9rem;
    }
    .track-table tbody tr:hover { background: #f8fafc; }
    .track-map {
      width: 100%;
      height: 400px;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      background: #1a1a2e;
    }
  </style>

  <script is:inline define:vars={{ trackPoints: track }}>
    function initTrackMap() {
      if (typeof L === 'undefined') {
        setTimeout(initTrackMap, 100);
        return;
      }
      var map = L.map('storm-track-map', {
        center: [trackPoints[0].lat, trackPoints[0].lon],
        zoom: 5,
        scrollWheelZoom: false,
      });

      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO',
        subdomains: 'abcd',
      }).addTo(map);

      var latlngs = trackPoints.map(function(p) { return [p.lat, p.lon]; });
      L.polyline(latlngs, { color: '#ffd43b', weight: 3, opacity: 0.8 }).addTo(map);

      trackPoints.forEach(function(p, i) {
        var isFirst = i === 0;
        var isLast = i === trackPoints.length - 1;
        L.circleMarker([p.lat, p.lon], {
          radius: isFirst || isLast ? 8 : 5,
          fillColor: isFirst ? '#4dabf7' : isLast ? '#ef4444' : '#ffd43b',
          color: '#000',
          weight: 2,
          fillOpacity: 0.8,
        }).addTo(map).bindPopup(
          '<strong>' + p.time + '</strong><br>Wind: ' + p.wind + ' mph<br>Pressure: ' + p.pressure + ' mb<br>Position: ' + p.lat + '°N, ' + Math.abs(p.lon) + '°W'
        );
      });

      map.fitBounds(latlngs, { padding: [40, 40] });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTrackMap);
    } else {
      initTrackMap();
    }
  </script>
</BaseLayout>
