---
// Social Share Buttons Component
// Usage: <ShareButtons url={url} title={title} lang={lang} />

interface Props {
  url: string;
  title: string;
  lang?: string;
}

const { url, title, lang = 'en' } = Astro.props;

const shareText = {
  en: `Track ${title} - live updates, path forecast, and impact analysis`,
  zh: `追踪 ${title} - 实时更新、路径预测和影响分析`,
  fr: `Suivez ${title} - mises à jour en direct, prévisions de trajectoire et analyse d'impact`,
  ja: `${title}を追跡 - リアルタイム更新、進路予測、影響分析`,
};

const text = shareText[lang] || shareText.en;
const encodedUrl = encodeURIComponent(url);
const encodedText = encodeURIComponent(text);
---

<div class="share-buttons">
  <span class="share-label">{lang === 'zh' ? '分享：' : lang === 'fr' ? 'Partager :' : lang === 'ja' ? 'シェア：' : 'Share:'}</span>
  
  <a 
    href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedText}`}
    target="_blank"
    rel="noopener"
    class="share-btn twitter"
    title="Share on Twitter"
    onclick="trackEvent('social_share', {platform: 'twitter', page_type: 'storm_detail', language: this.closest('[data-lang]')?.dataset.lang || 'en'})"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
    </svg>
    <span>Twitter</span>
  </a>
  
  <a 
    href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`}
    target="_blank"
    rel="noopener"
    class="share-btn facebook"
    title="Share on Facebook"
    onclick="trackEvent('social_share', {platform: 'facebook', page_type: 'storm_detail', language: this.closest('[data-lang]')?.dataset.lang || 'en'})"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
    </svg>
    <span>Facebook</span>
  </a>
  
  <a 
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`}
    target="_blank"
    rel="noopener"
    class="share-btn linkedin"
    title="Share on LinkedIn"
    onclick="trackEvent('social_share', {platform: 'linkedin', page_type: 'storm_detail', language: this.closest('[data-lang]')?.dataset.lang || 'en'})"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
    </svg>
    <span>LinkedIn</span>
  </a>
  
  <button 
    class="share-btn copy"
    title="Copy link"
    onclick="navigator.clipboard.writeText(this.closest('.share-buttons').dataset.url); trackEvent('social_share', {platform: 'copy_link', page_type: 'storm_detail'}); this.querySelector('span').textContent = this.closest('[data-lang]')?.dataset.lang === 'zh' ? '已复制！' : 'Copied!'"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <span>{lang === 'zh' ? '复制链接' : lang === 'fr' ? 'Copier' : lang === 'ja' ? 'コピー' : 'Copy'}</span>
  </button>
</div>

<style>
  .share-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 1.5rem 0;
    padding: 1rem;
    background: var(--color-bg-elevated, #f8fafc);
    border-radius: var(--radius, 8px);
    flex-wrap: wrap;
  }
  
  .share-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-secondary, #64748b);
  }
  
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius, 6px);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    border: 1px solid var(--color-border, #e2e8f0);
    background: white;
    color: var(--color-text, #1e293b);
    cursor: pointer;
  }
  
  .share-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  
  .share-btn.twitter:hover {
    background: #000;
    color: white;
    border-color: #000;
  }
  
  .share-btn.facebook:hover {
    background: #1877f2;
    color: white;
    border-color: #1877f2;
  }
  
  .share-btn.linkedin:hover {
    background: #0a66c2;
    color: white;
    border-color: #0a66c2;
  }
  
  .share-btn.copy:hover {
    background: var(--color-primary, #0ea5e9);
    color: white;
    border-color: var(--color-primary, #0ea5e9);
  }
</style>
