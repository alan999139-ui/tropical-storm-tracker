---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/dict';
import { historicalStorms } from '../../../data/historical';
import ShareButtons from '../../../components/ShareButtons.astro';

const lang = 'fr';

export function getStaticPaths() {
  return historicalStorms.map(storm => ({
    params: { name: storm.name.toLowerCase() },
    props: { storm },
  }));
}

const { storm } = Astro.props;

const categoryColors: Record<string, string> = {
  TD: '#4dabf7', TS: '#ffd43b', 'Cat-1': '#ff8787', 'Cat-2': '#fa5252',
  'Cat-3': '#e64980', 'Cat-4': '#cc5de8', 'Cat-5': '#845ef7',
};

const catColor = categoryColors[storm.category] || '#64748b';
const catName = storm.category === 'TD' ? 'Dépression Tropicale'
  : storm.category === 'TS' ? 'Tempête Tropicale'
  : storm.category.replace('Cat-', 'Ouragan Catégorie ');

// Ce que cela signifie pour vous — impact du vent en langage humain
const windMeaning: Record<string, string> = {
  'TD': 'Vents sous 39 mph (63 km/h). Pluies fortes et inondations localisées possibles — mais les dégâts de vent sont peu probables.',
  'TS': 'Vents de 39 à 73 mph (63–118 km/h). Branches cassées, coupures de courant ponctuelles et fortes pluies pouvant provoquer des crues soudaines.',
  'Cat-1': 'Vents de 74 à 95 mph (119–153 km/h). Vents très dangereux : toitures endommagées, branches cassées, coupures de courant de plusieurs jours.',
  'Cat-2': 'Vents de 96 à 110 mph (154–177 km/h). Vents extrêmement dangereux : dégâts majeurs aux toitures, arbres déracinés, coupures de courant quasi totales.',
  'Cat-3': 'Vents de 111 à 129 mph (178–208 km/h). Dégâts dévastateurs. Les maisons solides peuvent perdre leur toit ; électricité et eau indisponibles pendant des semaines.',
  'Cat-4': 'Vents de 130 à 156 mph (209–251 km/h). Dégâts catastrophiques. La plupart des toits détruits, arbres déracinés, zones inhabitables pendant des semaines.',
  'Cat-5': 'Vents de 157+ mph (252+ km/h). Dégâts catastrophiques. Une grande partie des maisons à ossature bois seront détruites.',
};

const damageContext = storm.damage === 'TBD' ? `Les chiffres officiels des dégâts de ${storm.name} sont encore en cours d'évaluation.`
  : `Pour mettre en perspective : ${storm.damage} de dégâts pourrait financer des milliers de projets de reconstruction, ou des années de primes d'assurance inondation pour tout un comté côtier.`;

const fatalityContext = storm.fatalities === 0 ? `${storm.name} n'a causé aucun décès signalé.`
  : `${storm.fatalities} personnes ont perdu la vie — derrière chaque chiffre, il y a une famille, un foyer et une communauté à reconstruire.`;

const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": `Tempête Tropicale ${storm.name} (${storm.year})`,
  "startDate": storm.formed,
  "endDate": storm.dissipated,
  "description": storm.description,
  "eventStatus": "https://schema.org/EventCompleted",
  "location": { "@type": "Place", "name": storm.region },
};
---

<BaseLayout
  title={`Tempête Tropicale ${storm.name} (${storm.year})`}
  description={`${storm.name} était une ${catName} en ${storm.year}. Vents max : ${storm.maxWind} mph. Trajectoire, statistiques et informations sur l'impact.`}
  canonical={`/fr/storms/${storm.name.toLowerCase()}/`}
  lang={lang}
>
  <nav class="breadcrumb">
    <a href="/fr/">{t('nav.home', lang)}</a> <span>/</span>
    <a href="/fr/storms">{t('nav.storms', lang)}</a> <span>/</span>
    <span>{storm.name} {storm.year}</span>
  </nav>

  <div class="storm-detail-header">
    <div>
      <h1>{storm.name}</h1>
      <span class="storm-year">{t('detail.season', lang)} {storm.year}</span>
    </div>
    <span class="badge" style={`background: ${catColor}33; color: ${catColor};`}>{storm.category}</span>
  </div>

  <!-- Share Buttons -->
  <div data-lang="fr" class="share-container">
    <ShareButtons url={new URL(`/fr/storms/${storm.name.toLowerCase()}/`, Astro.site).toString()} title={`${storm.name} ${storm.year}`} lang="fr" />
  </div>

  <div class="stats-grid">
    <div class="stat-card"><span class="stat-label">{t('detail.maxWind', lang)}</span><span class="stat-value">{storm.maxWind} <span class="unit">mph</span></span></div>
    <div class="stat-card"><span class="stat-label">{t('detail.minPressure', lang)}</span><span class="stat-value">{storm.minPressure} <span class="unit">mb</span></span></div>
    <div class="stat-card"><span class="stat-label">{t('detail.duration', lang)}</span><span class="stat-value">{storm.duration}</span></div>
    <div class="stat-card"><span class="stat-label">{t('detail.region', lang)}</span><span class="stat-value">{storm.region}</span></div>
    <div class="stat-card"><span class="stat-label">{t('detail.landfall', lang)}</span><span class="stat-value">{storm.landfall}</span></div>
    <div class="stat-card"><span class="stat-label">{t('detail.damage', lang)}</span><span class="stat-value">{storm.damage}</span></div>
    <div class="stat-card"><span class="stat-label">{t('detail.fatalities', lang)}</span><span class="stat-value">{storm.fatalities}</span></div>
    <div class="stat-card"><span class="stat-label">{t('detail.formed', lang)}</span><span class="stat-value">{storm.formed}</span></div>
  </div>

  <section class="section">
    <h2>{t('detail.overview', lang)}</h2>
    <p>{storm.description}</p>
  </section>

  <!-- Ce que cela signifie pour vous -->
  <section class="section">
    <h2>🧭 Ce que cela signifie pour vous</h2>
    <div class="impact-grid">
      <div class="impact-box">
        <h3>💨 À quel point ce vent est-il dangereux ?</h3>
        <p>{windMeaning[storm.category]}</p>
        <p class="impact-note">Pour comparer : une collision à 70 mph est déjà violente — imaginez des vents soutenus de {storm.maxWind} mph.</p>
      </div>
      <div class="impact-box">
        <h3>💰 Quel a été le coût humain ?</h3>
        <p>{damageContext}</p>
        <p>{fatalityContext}</p>
      </div>
      <div class="impact-box impact-action">
        <h3>✅ Ce que vous pouvez faire aujourd'hui</h3>
        <ul>
          <li>Vérifiez votre kit d'urgence — eau, nourriture, médicaments, piles</li>
          <li>Connaissez votre itinéraire d'évacuation et les abris</li>
          <li>Abonnez-vous aux alertes gratuites pour ne jamais être pris au dépourvu</li>
        </ul>
        <div class="impact-cta">
          <a href="/fr/alerts" class="btn btn-primary">Configurer des alertes gratuites</a>
          <a href="/fr/preparedness" class="btn btn-outline">Guide de préparation</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>{t('detail.stormPath', lang)}</h2>
    <div id="storm-track-map" class="track-map"></div>
  </section>

  <section class="section">
    <h2>{t('detail.trackData', lang)}</h2>
    <div class="table-container">
      <table class="track-table">
        <thead>
          <tr>
            <th>{t('detail.time', lang)}</th>
            <th>{t('detail.latitude', lang)}</th>
            <th>{t('detail.longitude', lang)}</th>
            <th>{t('detail.wind', lang)}</th>
            <th>{t('detail.pressure', lang)}</th>
          </tr>
        </thead>
        <tbody>
          {storm.track.map((point) => (
            <tr>
              <td>{point.time}</td>
              <td>{point.lat}°N</td>
              <td>{Math.abs(point.lon)}°W</td>
              <td>{point.wind}</td>
              <td>{point.pressure}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <h2>{t('prepPage.dataSource', lang)}</h2>
    <p>Données de trajectoire fournies par le <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">Centre National des Ouragans de la NOAA</a>. Dernière mise à jour : {storm.dissipated}.</p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(eventData)} />

  <style>
    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; margin-bottom: 1.5rem; color: var(--color-text-secondary); }
    .breadcrumb a { color: var(--color-primary); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .storm-detail-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
    .storm-detail-header h1 { font-size: 2rem; margin: 0; }
    .storm-year { color: var(--color-text-secondary); font-size: 0.95rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
    @media (max-width: 768px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    .stat-card { background: var(--color-surface); border-radius: 8px; padding: 1rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 0.25rem; }
    .stat-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); }
    .stat-value { font-size: 1.25rem; font-weight: 700; }
    .unit { font-size: 0.85rem; font-weight: 400; color: var(--color-text-secondary); }
    .section { margin-bottom: 2rem; }
    .section h2 { font-size: 1.5rem; margin-bottom: 1rem; }
    .section p { color: var(--color-text-secondary); line-height: 1.7; }
    .section a { color: var(--color-primary); }
    .table-container { overflow-x: auto; background: var(--color-surface); border-radius: 8px; box-shadow: var(--shadow-sm); }
    .track-table { width: 100%; border-collapse: collapse; }
    .track-table th { background: #f1f5f9; padding: 0.6rem 1rem; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-secondary); }
    .track-table td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; }
    .track-table tbody tr:hover { background: #f8fafc; }
    .track-map { width: 100%; height: 400px; border-radius: 8px; overflow: hidden; box-shadow: var(--shadow-sm); background: #e8eef4; }
    .impact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 900px) { .impact-grid { grid-template-columns: 1fr; } }
    .impact-box { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 1.25rem; }
    .impact-box h3 { font-size: 1rem; margin: 0 0 0.75rem; }
    .impact-box p, .impact-box li { font-size: 0.9rem; line-height: 1.6; color: var(--color-text-secondary); }
    .impact-box ul { padding-left: 1.25rem; margin: 0 0 1rem; }
    .impact-note { font-size: 0.8rem !important; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed var(--color-border); }
    .impact-action { background: linear-gradient(135deg, var(--color-surface), color-mix(in srgb, var(--color-primary) 6%, white)); }
    .impact-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  </style>

  <script is:inline define:vars={{ trackPoints: storm.track }}>
    function initTrackMap() {
      if (typeof L === 'undefined') { setTimeout(initTrackMap, 100); return; }
      var map = L.map('storm-track-map', { center: [trackPoints[0].lat, trackPoints[0].lon], zoom: 5, scrollWheelZoom: false });
      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', subdomains: 'abcd' }).addTo(map);
      var latlngs = trackPoints.map(function(p) { return [p.lat, p.lon]; });
      L.polyline(latlngs, { color: '#f59e0b', weight: 3, opacity: 0.8 }).addTo(map);
      trackPoints.forEach(function(p, i) {
        var isFirst = i === 0; var isLast = i === trackPoints.length - 1;
        L.circleMarker([p.lat, p.lon], { radius: isFirst || isLast ? 8 : 5, fillColor: isFirst ? '#4dabf7' : isLast ? '#ef4444' : '#ffd43b', color: '#fff', weight: 2, fillOpacity: 0.8 }).addTo(map).bindPopup('<strong>' + p.time + '</strong><br>Vent : ' + p.wind + ' mph<br>Pression : ' + p.pressure + ' mb<br>Position : ' + p.lat + '°N, ' + Math.abs(p.lon) + '°W');
      });
      map.fitBounds(latlngs, { padding: [40, 40] });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initTrackMap); } else { initTrackMap(); }
  </script>
</BaseLayout>
