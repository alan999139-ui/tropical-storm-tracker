---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/dict';
import { historicalStorms } from '../../../data/historical';

const lang = 'zh';

export function getStaticPaths() {
  return historicalStorms.map(storm => ({
    params: { name: storm.name.toLowerCase() },
    props: { storm },
  }));
}

const { storm } = Astro.props;

const categoryColors: Record<string, string> = {
  TD: '#4dabf7', TS: '#ffd43b', 'Cat-1': '#ff8787', 'Cat-2': '#fa5252',
  'Cat-3': '#e64980', 'Cat-4': '#cc5de8', 'Cat-5': '#845ef7',
};

const catColor = categoryColors[storm.category] || '#64748b';

// 这对你意味着什么 — 风速的人类可读解读
const windMeaning: Record<string, string> = {
  'TD': '风速低于 39 mph（63 km/h）。预计有强降雨和局部洪水——但风灾风险不大。低洼地区仍需警惕水位上涨。',
  'TS': '风速 39–73 mph（63–118 km/h）。预计有断枝、零星停电和可能引发山洪的强降雨。',
  'Cat-1': '风速 74–95 mph（119–153 km/h）。非常危险的风会损坏屋顶、折断树枝，并造成持续数天的停电。',
  'Cat-2': '风速 96–110 mph（154–177 km/h）。极端危险的风。预计屋顶严重损坏、树木连根拔起，停电数天至数周。',
  'Cat-3': '风速 111–129 mph（178–208 km/h）。毁灭性破坏。坚固的房屋也可能失去屋顶，水电可能中断数周。',
  'Cat-4': '风速 130–156 mph（209–251 km/h）。灾难性破坏。大部分屋顶被毁、树木被连根拔起，受灾地区可能数周至数月无法居住。',
  'Cat-5': '风速 157+ mph（252+ km/h）。灾难性破坏。大部分木结构房屋将被摧毁，屋顶完全坍塌、墙体倒塌。',
};

const damageContext = storm.damage === 'TBD' ? `关于 ${storm.name} 的官方损失统计仍在评估中。`
  : `换个角度理解：${storm.damage} 的损失足以支撑数千个重建项目，或为一个沿海县支付多年的洪水保险。`;

const fatalityContext = storm.fatalities === 0 ? `${storm.name} 未造成人员伤亡。`
  : `${storm.fatalities} 人因此丧生——每一个数字背后都是一个家庭、一所房子，和一个需要重建的社区。`;

const eventData = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": `热带风暴 ${storm.name} (${storm.year})`,
  "startDate": storm.formed,
  "endDate": storm.dissipated,
  "description": storm.description,
  "eventStatus": "https://schema.org/EventCompleted",
  "location": { "@type": "Place", "name": storm.region },
};
---

<BaseLayout
  title={`热带风暴 ${storm.name} (${storm.year})`}
  description={`${storm.name} 是 ${storm.year} 年的一个热带风暴。最大风速: ${storm.maxWind} mph。`}
  canonical={`/zh/storms/${storm.name.toLowerCase()}/`}
  lang={lang}
>
  <nav class="breadcrumb">
    <a href="/zh/">首页</a> <span>/</span>
    <a href="/zh/storms">风暴</a> <span>/</span>
    <span>{storm.name} {storm.year}</span>
  </nav>

  <div class="storm-detail-header">
    <div>
      <h1>{storm.name}</h1>
      <span class="storm-year">{storm.year} 年大西洋飓风季</span>
    </div>
    <span class="badge" style={`background: ${catColor}33; color: ${catColor};`}>{storm.category}</span>
  </div>

  <div class="stats-grid">
    <div class="stat-card"><span class="stat-label">最大风速</span><span class="stat-value">{storm.maxWind} <span class="unit">mph</span></span></div>
    <div class="stat-card"><span class="stat-label">最低气压</span><span class="stat-value">{storm.minPressure} <span class="unit">mb</span></span></div>
    <div class="stat-card"><span class="stat-label">持续时间</span><span class="stat-value">{storm.duration}</span></div>
    <div class="stat-card"><span class="stat-label">地区</span><span class="stat-value">{storm.region}</span></div>
    <div class="stat-card"><span class="stat-label">登陆地点</span><span class="stat-value">{storm.landfall}</span></div>
    <div class="stat-card"><span class="stat-label">损失</span><span class="stat-value">{storm.damage}</span></div>
    <div class="stat-card"><span class="stat-label">死亡人数</span><span class="stat-value">{storm.fatalities}</span></div>
    <div class="stat-card"><span class="stat-label">形成日期</span><span class="stat-value">{storm.formed}</span></div>
  </div>

  <section class="section">
    <h2>概述</h2>
    <p>{storm.description}</p>
  </section>

  <!-- 这对你意味着什么 -->
  <section class="section">
    <h2>🧭 这对你意味着什么</h2>
    <div class="impact-grid">
      <div class="impact-box">
        <h3>💨 这样的风有多危险？</h3>
        <p>{windMeaning[storm.category]}</p>
        <p class="impact-note">对比一下：汽车在 70 mph（约 113 km/h）下碰撞已经非常猛烈——想象一下持续 {storm.maxWind} mph 的风力。</p>
      </div>
      <div class="impact-box">
        <h3>💰 代价有多大？</h3>
        <p>{damageContext}</p>
        <p>{fatalityContext}</p>
      </div>
      <div class="impact-box impact-action">
        <h3>✅ 你现在可以做什么</h3>
        <ul>
          <li>检查应急物资——水、食物、药品、电池</li>
          <li>了解撤离路线和避难所位置</li>
          <li>订阅免费预警，绝不打无准备之仗</li>
        </ul>
        <div class="impact-cta">
          <a href="/zh/alerts" class="btn btn-primary">设置免费预警</a>
          <a href="/zh/preparedness" class="btn btn-outline">阅读防灾指南</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>风暴路径</h2>
    <div id="storm-track-map" class="track-map"></div>
  </section>

  <section class="section">
    <h2>路径数据</h2>
    <div class="table-container">
      <table class="track-table">
        <thead>
          <tr>
            <th>时间 (UTC)</th>
            <th>纬度</th>
            <th>经度</th>
            <th>风速 (mph)</th>
            <th>气压 (mb)</th>
          </tr>
        </thead>
        <tbody>
          {storm.track.map((point) => (
            <tr>
              <td>{point.time}</td>
              <td>{point.lat}°N</td>
              <td>{Math.abs(point.lon)}°W</td>
              <td>{point.wind}</td>
              <td>{point.pressure}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <h2>数据来源</h2>
    <p>路径数据来自 <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA 国家飓风中心</a>。最后更新: {storm.dissipated}。</p>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(eventData)} />

  <style>
    .breadcrumb { display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; margin-bottom: 1.5rem; color: var(--color-text-secondary); }
    .breadcrumb a { color: var(--color-primary); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .storm-detail-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; }
    .storm-detail-header h1 { font-size: 2rem; margin: 0; }
    .storm-year { color: var(--color-text-secondary); font-size: 0.95rem; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
    @media (max-width: 768px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    .stat-card { background: var(--color-surface); border-radius: 8px; padding: 1rem; box-shadow: var(--shadow-sm); display: flex; flex-direction: column; gap: 0.25rem; }
    .stat-label { font-size: 0.75rem; color: var(--color-text-secondary); }
    .stat-value { font-size: 1.25rem; font-weight: 700; }
    .unit { font-size: 0.85rem; font-weight: 400; color: var(--color-text-secondary); }
    .section { margin-bottom: 2rem; }
    .section h2 { font-size: 1.5rem; margin-bottom: 1rem; }
    .section p { color: var(--color-text-secondary); line-height: 1.7; }
    .section a { color: var(--color-primary); }
    .table-container { overflow-x: auto; background: var(--color-surface); border-radius: 8px; box-shadow: var(--shadow-sm); }
    .track-table { width: 100%; border-collapse: collapse; }
    .track-table th { background: #f1f5f9; padding: 0.6rem 1rem; text-align: left; font-size: 0.8rem; color: var(--color-text-secondary); }
    .track-table td { padding: 0.6rem 1rem; border-bottom: 1px solid var(--color-border); font-size: 0.9rem; }
    .track-table tbody tr:hover { background: #f8fafc; }
    .track-map { width: 100%; height: 400px; border-radius: 8px; overflow: hidden; box-shadow: var(--shadow-sm); background: #e8eef4; }
    .impact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 900px) { .impact-grid { grid-template-columns: 1fr; } }
    .impact-box { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 12px; padding: 1.25rem; }
    .impact-box h3 { font-size: 1rem; margin: 0 0 0.75rem; }
    .impact-box p, .impact-box li { font-size: 0.9rem; line-height: 1.6; color: var(--color-text-secondary); }
    .impact-box ul { padding-left: 1.25rem; margin: 0 0 1rem; }
    .impact-note { font-size: 0.8rem !important; margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px dashed var(--color-border); }
    .impact-action { background: linear-gradient(135deg, var(--color-surface), color-mix(in srgb, var(--color-primary) 6%, white)); }
    .impact-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  </style>

  <script is:inline define:vars={{ trackPoints: storm.track }}>
    function initTrackMap() {
      if (typeof L === 'undefined') { setTimeout(initTrackMap, 100); return; }
      var map = L.map('storm-track-map', { center: [trackPoints[0].lat, trackPoints[0].lon], zoom: 5, scrollWheelZoom: false });
      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', subdomains: 'abcd' }).addTo(map);
      var latlngs = trackPoints.map(function(p) { return [p.lat, p.lon]; });
      L.polyline(latlngs, { color: '#f59e0b', weight: 3, opacity: 0.8 }).addTo(map);
      trackPoints.forEach(function(p, i) {
        var isFirst = i === 0; var isLast = i === trackPoints.length - 1;
        L.circleMarker([p.lat, p.lon], { radius: isFirst || isLast ? 8 : 5, fillColor: isFirst ? '#4dabf7' : isLast ? '#ef4444' : '#ffd43b', color: '#fff', weight: 2, fillOpacity: 0.8 }).addTo(map).bindPopup('<strong>' + p.time + '</strong><br>风速: ' + p.wind + ' mph<br>气压: ' + p.pressure + ' mb<br>位置: ' + p.lat + '°N, ' + Math.abs(p.lon) + '°W');
      });
      map.fitBounds(latlngs, { padding: [40, 40] });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', initTrackMap); } else { initTrackMap(); }
  </script>
</BaseLayout>
