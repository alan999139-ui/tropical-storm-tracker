---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dict';
import { BASIN_LIST } from '../../data/basins.mjs';

const lang = 'zh';
// 流域筛选数据传给客户端
const basinsJson = JSON.stringify(BASIN_LIST.map(b => ({
  id: b.id, name: b.names.zh, agency: b.agencyShort, flag: b.flag, center: b.center,
})));
---

<BaseLayout
  title={t('map.title', lang)}
  description="实时交互式全球热带气旋地图。数据来自 NOAA NHC 与 JTWC，归属于各区域官方机构。"
  lang={lang}
>
  <div class="page-header">
    <div>
      <h1><span aria-hidden="true">🌍</span> 全球实时风暴地图</h1>
      <p>实时追踪全球各大洋盆地的活跃热带气旋。数据来自 <a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA NHC</a> 与 <a href="https://www.metoc.navy.mil/jtwc/jtwc.html" target="_blank" rel="noopener">JTWC</a>，并归属于各区域的官方机构。</p>
    </div>
    <div class="map-status" id="map-status">
      <span class="status-indicator loading">正在连接实时数据源...</span>
    </div>
  </div>

  <!-- 流域筛选 -->
  <div class="basin-filter" id="basin-filter" role="group" aria-label="按洋盆地筛选">
    <button class="basin-btn active" data-basin="all">🌍 全部流域</button>
  </div>

  <div class="map-legend">
    <div class="legend-title"><span aria-hidden="true">🌀</span> 图例</div>
    <div class="legend-items">
      <span class="legend-item"><span class="legend-dot" style="background:#4dabf7;"></span> 热带低压</span>
      <span class="legend-item"><span class="legend-dot" style="background:#ffd43b;"></span> 热带风暴</span>
      <span class="legend-item"><span class="legend-dot" style="background:#ff8787;"></span> 1级</span>
      <span class="legend-item"><span class="legend-dot" style="background:#fa5252;"></span> 2级</span>
      <span class="legend-item"><span class="legend-dot" style="background:#e64980;"></span> 3级</span>
      <span class="legend-item"><span class="legend-dot" style="background:#cc5de8;"></span> 4级</span>
      <span class="legend-item"><span class="legend-dot" style="background:#845ef7;"></span> 5级</span>
    </div>
  </div>

  <div id="storm-map" class="storm-map"></div>

  <div class="map-footer">
    <p>
      <span aria-hidden="true">🟢</span> <strong id="fetch-status">实时</strong> · 更新于：<span id="last-updated">—</span>
      · 数据源：<a href="https://www.nhc.noaa.gov" target="_blank" rel="noopener">NOAA NHC</a>（大西洋/东太/中太）、
      <a href="https://www.jma.go.jp/bosai/map.html#contents=typhoon" target="_blank" rel="noopener">JMA</a>、
      <a href="https://mausam.imd.gov.in/" target="_blank" rel="noopener">IMD</a>、
      <a href="https://meteofrance.com/" target="_blank" rel="noopener">Météo-France</a>、
      <a href="http://www.bom.gov.au/" target="_blank" rel="noopener">BOM</a>、
      <a href="https://www.metoc.navy.mil/jtwc/jtwc.html" target="_blank" rel="noopener">FMS</a>（经 JTWC）
    </p>
  </div>

  <script is:inline define:vars={{ basinsJson }}>
    // 注入流域筛选按钮
    var BASINS = JSON.parse(basinsJson);
    (function() {
      var filter = document.getElementById('basin-filter');
      if (filter && BASINS) {
        BASINS.forEach(function(b) {
          var btn = document.createElement('button');
          btn.className = 'basin-btn';
          btn.setAttribute('data-basin', b.id);
          btn.innerHTML = b.flag + ' ' + b.name;
          filter.appendChild(btn);
        });
      }
    })();
  </script>

  <script is:inline>
    var map;
    var markersLayer;
    var allStorms = [];
    var currentBasin = 'all';

    // 风暴名称中文化
    var stormNameMap = { 'Arthur':'阿瑟','Bertha':'伯莎','Cristobal':'克里斯托瓦尔','Dolly':'多莉','Edouard':'爱德华','Fay':'费伊','Gonzalo':'贡萨洛','Hanna':'汉娜','Isaias':'伊萨亚斯','Laura':'劳拉','Marco':'马可','Nana':'娜娜','Omar':'奥马尔','Paulette':'波莱特','Rene':'雷内','Sally':'萨莉','Teddy':'泰迪','Vicky':'维基','Wilfred':'威尔弗雷德','Dorian':'多里安','Michael':'迈克尔','Florence':'弗洛伦斯','Maria':'玛丽亚','Irma':'艾尔玛','Harvey':'哈维','Ian':'伊恩','Idalia':'伊达利亚','Hilary':'希拉里','Lee':'李','Franklin':'富兰克林','Nigel':'奈杰尔','Tammy':'塔米','Fiona':'菲奥娜','Ida':'艾达','Elsa':'埃尔莎','Eta':'伊塔','Iota':'约塔','Dolphin':'海豚','Fausto':'福斯托','Genevieve':'吉纳维芙','Noul':'诺尔' };
    function ln(n) { return stormNameMap[n] || n; }

    // 流域中文化
    var basinNameMap = { 'North Atlantic':'北大西洋','Eastern Pacific':'东太平洋','Central Pacific':'中太平洋','Northwest Pacific':'西北太平洋','North Indian':'北印度洋','South Indian':'南印度洋','South Pacific':'南太平洋','Australia':'澳大利亚海域' };

    function getIntensityColor(wind) {
      if (wind < 39) return '#4dabf7';
      if (wind < 74) return '#ffd43b';
      if (wind < 96) return '#ff8787';
      if (wind < 111) return '#fa5252';
      if (wind < 130) return '#e64980';
      if (wind < 157) return '#cc5de8';
      return '#845ef7';
    }

    function getBasinCenter(basinId) {
      var b = BASINS.find(function(x){ return x.id === basinId; });
      return b ? b.center : [15, 140];
    }

    function initMap() {
      if (typeof L === 'undefined') { setTimeout(initMap, 100); return; }

      map = L.map('storm-map', {
        center: [15, 140],
        zoom: 3,
        scrollWheelZoom: true,
        zoomControl: true,
      });

      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
        subdomains: 'abcd',
        maxZoom: 18,
      }).addTo(map);

      markersLayer = L.layerGroup().addTo(map);
      fetchAndDisplayStorms();

      // 流域筛选事件
      document.getElementById('basin-filter').addEventListener('click', function(e) {
        var btn = e.target.closest('.basin-btn');
        if (!btn) return;
        document.querySelectorAll('.basin-btn').forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');
        currentBasin = btn.getAttribute('data-basin');

        // GA4 事件：流域筛选
        if (typeof trackEvent !== 'undefined') {
          var fb = BASINS.find(function(b){ return b.id === currentBasin; });
          trackEvent('map_filter_basin', {
            basin_id: currentBasin,
            basin_name: fb ? fb.name : '全部流域',
            page_language: 'zh'
          });
        }

        renderMarkers();
      });

      // GA4 事件：地图缩放
      map.on('zoomend', function() {
        if (typeof trackEvent !== 'undefined') {
          trackEvent('map_zoom', {
            zoom_level: map.getZoom(),
            view_type: currentBasin === 'all' ? 'global' : 'basin',
            page_language: 'zh'
          });
        }
      });

      // GA4 事件：地图平移（防抖）
      var panTimeout;
      map.on('moveend', function() {
        clearTimeout(panTimeout);
        panTimeout = setTimeout(function() {
          if (typeof trackEvent !== 'undefined') {
            var center = map.getCenter();
            trackEvent('map_pan', {
              center_lat: center.lat.toFixed(2),
              center_lon: center.lng.toFixed(2),
              zoom_level: map.getZoom(),
              page_language: 'zh'
            });
          }
        }, 2000);  // 2秒防抖
      });

      // GA4 事件：地图加载完成
      if (typeof trackEvent !== 'undefined') {
        trackEvent('map_loaded', {
          initial_zoom: 3,
          initial_center: '15N,140E',
          page_language: 'zh'
        });
      }
    }

    function renderMarkers() {
      markersLayer.clearLayers();
      var shown = allStorms.filter(function(s){ return currentBasin === 'all' || s.basin === currentBasin; });
      if (shown.length === 0) {
        var statusEl = document.querySelector('#map-status .status-indicator');
        if (statusEl) {
          statusEl.className = 'status-indicator no-active';
          statusEl.innerHTML = currentBasin === 'all' ? '<span aria-hidden="true">☀️</span> 暂无活跃风暴' : '该流域暂无活跃风暴';
        }
        return;
      }
      var bounds = [];
      shown.forEach(function(storm) {
        var color = getIntensityColor(storm.windMph);
        var marker = L.circleMarker([storm.lat, storm.lon], {
          radius: 12,
          fillColor: color,
          color: '#ffffff',
          weight: 2.5,
          fillOpacity: 0.85,
        });
        bounds.push([storm.lat, storm.lon]);

        var popup = '<div style="min-width:220px;">' +
          '<h3 style="margin:0 0 4px;font-size:1.1em;">' + ln(storm.name) + (storm.designation ? ' (' + storm.designation + ')' : '') + '</h3>' +
          '<p style="margin:0 0 6px;font-size:0.82em;color:#64748b;">' + (storm.type || '热带气旋') + ' · ' + (basinNameMap[storm.basinName] || storm.basinName || '') + '</p>' +
          '<table style="width:100%;font-size:0.82em;border-collapse:collapse;">' +
          '<tr><td style="padding:2px 4px;font-weight:600;">风速</td><td style="padding:2px 4px;">' + storm.windMph + ' mph</td></tr>' +
          '<tr><td style="padding:2px 4px;font-weight:600;">气压</td><td style="padding:2px 4px;">' + (storm.pressureMb > 0 ? storm.pressureMb + ' mb' : '—') + '</td></tr>' +
          '<tr><td style="padding:2px 4px;font-weight:600;">移动</td><td style="padding:2px 4px;">' + storm.movement + '</td></tr>' +
          '<tr><td style="padding:2px 4px;font-weight:600;">位置</td><td style="padding:2px 4px;">' + Math.abs(storm.lat).toFixed(1) + '°' + (storm.lat>=0?'N':'S') + ', ' + Math.abs(storm.lon).toFixed(1) + '°' + (storm.lon>=0?'E':'W') + '</td></tr>' +
          '<tr><td style="padding:2px 4px;font-weight:600;">来源</td><td style="padding:2px 4px;">' + (storm.agency || storm.source) + '</td></tr>' +
          '</table>' +
          (storm.warningUrl ? '<p style="margin:8px 0 0;font-size:0.8em;"><a href="' + storm.warningUrl + '" target="_blank" rel="noopener">查看官方预警 →</a></p>' : '') +
          '</div>';
        marker.bindPopup(popup);
        markersLayer.addLayer(marker);

        // GA4 事件：标记点击
        marker.on('click', function() {
          if (typeof trackEvent !== 'undefined') {
            trackEvent('map_marker_click', {
              storm_name: storm.name,
              storm_designation: storm.designation || '',
              storm_category: getIntensityColor(storm.windMph),
              wind_mph: storm.windMph,
              basin_id: storm.basin,
              basin_name: storm.basinName,
              agency: storm.agency || storm.source,
              page_language: 'zh'
            });
          }
        });
      });
      if (currentBasin === 'all') {
        map.fitBounds(bounds, { padding: [50, 50], maxZoom: 5 });
      } else {
        var c = getBasinCenter(currentBasin);
        map.setView(c, 4);
      }
      renderSidebar(shown);
    }

    function renderSidebar(shown) {
      var listEl = document.getElementById('active-storms-list');
      if (!listEl) return;
      if (shown.length === 0) {
        listEl.innerHTML = '<p class="no-storms">☀️ 暂无活跃热带风暴</p>';
        return;
      }
      listEl.innerHTML = shown.map(function(s) {
        var color = getIntensityColor(s.windMph);
        return '<div class="active-storm-item">' +
          '<div class="storm-item-header">' +
            '<strong>' + ln(s.name) + (s.designation ? ' (' + s.designation + ')' : '') + '</strong>' +
            '<span class="storm-item-type" style="color: ' + color + ';">' + s.type + '</span>' +
          '</div>' +
          '<div class="storm-item-stats">' +
            '<span>💨 ' + s.windMph + ' mph</span>' +
            '<span>📊 ' + (s.pressureMb > 0 ? s.pressureMb + ' mb' : '—') + '</span>' +
            '<span>🌐 ' + (basinNameMap[s.basinName] || s.basinName || '') + '</span>' +
            '<span>🏛️ ' + (s.agency || s.source) + '</span>' +
          '</div>' +
        '</div>';
      }).join('');
    }

    async function fetchAndDisplayStorms() {
      var statusEl = document.getElementById('map-status');
      var statusTextEl = statusEl ? statusEl.querySelector('.status-indicator') : null;
      var fetchStatusEl = document.getElementById('fetch-status');
      var lastUpdatedEl = document.getElementById('last-updated');

      function setStatus(type, text) {
        if (statusTextEl) {
          statusTextEl.className = 'status-indicator ' + type;
          statusTextEl.innerHTML = text;
        }
        if (fetchStatusEl) {
          fetchStatusEl.innerHTML = type === 'error' ? '<span aria-hidden="true">⚠️</span> 不可用' : type === 'loading' ? '加载中...' : '🟢 实时';
        }
      }

      setStatus('loading', '正在获取实时数据...');

      try {
        var resp = await fetch('/api/global-storms');
        if (!resp.ok) throw new Error('HTTP ' + resp.status);
        var data = await resp.json();
        allStorms = data.storms || [];

        if (allStorms.length > 0) {
          setStatus('live', '🟢 实时 — ' + allStorms.length + ' 个活跃风暴');
        } else {
          setStatus('no-active', '<span aria-hidden="true">☀️</span> 暂无活跃风暴');
        }
        renderMarkers();

        if (data.fetchedAt && lastUpdatedEl) {
          var d = new Date(data.fetchedAt);
          lastUpdatedEl.textContent = d.toLocaleString('zh-CN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'UTC', timeZoneName: 'short' });
        }
      } catch (err) {
        setStatus('error', '⚠️ 无法连接实时数据源');
        console.error('获取风暴数据失败:', err);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMap);
    } else {
      initMap();
    }

    // 每 5 分钟自动刷新
    setInterval(fetchAndDisplayStorms, 5 * 60 * 1000);

    // 修复地图容器尺寸问题：窗口resize时刷新地图
    window.addEventListener('resize', function() {
      if (map) {
        setTimeout(function() { map.invalidateSize(); }, 100);
      }
    });
  </script>

  <style>
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
    .page-header h1 { font-size: 2rem; margin: 0 0 0.5rem; }
    .page-header p { color: var(--color-text-secondary); margin: 0; max-width: 640px; }
    .page-header a { color: var(--color-primary); }
    .map-status { text-align: right; }
    .status-indicator {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.4rem 0.75rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    .status-indicator.loading { background: #dbeafe; color: #1e40af; }
    .status-indicator.live { background: #d1fae5; color: #065f46; }
    .status-indicator.no-active { background: #f0fdf4; color: #166534; }
    .status-indicator.error { background: #fef3c7; color: #92400e; }
    .basin-filter {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .basin-btn {
      border: 2px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text);
      padding: 0.45rem 0.85rem;
      border-radius: 999px;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .basin-btn:hover { border-color: var(--color-primary); }
    .basin-btn.active { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
    .map-legend {
      background: var(--color-surface);
      border-radius: 8px;
      padding: 0.75rem 1.25rem;
      margin-bottom: 1rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .legend-title { font-weight: 700; font-size: 0.85rem; }
    .legend-items { display: flex; gap: 1rem; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; color: var(--color-text-secondary); }
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .storm-map { width: 100%; height: 550px; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); background: #e8eef4; }
    .map-footer { margin-top: 0.75rem; font-size: 0.8rem; color: var(--color-text-secondary); }
    .map-footer a { color: var(--color-primary); }
    .storm-sidebar {
      background: var(--color-surface);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
      margin-top: 1.5rem;
    }
    .storm-sidebar h3 { font-size: 1.1rem; margin-bottom: 1rem; }
    .active-storms { display: flex; flex-direction: column; gap: 0.75rem; }
    .active-storm-item {
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      padding: 0.75rem 1rem;
      background: var(--color-surface);
    }
    .storm-item-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
    .storm-item-header strong { font-size: 1rem; }
    .storm-item-type { font-size: 0.82rem; font-weight: 600; }
    .storm-item-stats { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; font-size: 0.82rem; color: var(--color-text-secondary); }
    .no-storms { color: var(--color-text-secondary); text-align: center; padding: 1rem; }
    @media (max-width: 768px) {
      .storm-map { height: 400px; }
      .map-legend { flex-direction: column; align-items: flex-start; }
      .basin-filter { gap: 0.4rem; }
      .basin-btn { font-size: 0.75rem; padding: 0.4rem 0.7rem; }
    }
  </style>
</BaseLayout>
